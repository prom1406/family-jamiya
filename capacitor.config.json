{
  "appId": "com.prom1406.sewaa",
  "appName": "سِواء",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#F5F7F5"
  },
  "plugins": {
    "FirebaseMessaging": {
      "presentationOptions": [
        "alert",
        "badge",
        "sound"
      ]
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    },
    "FirebaseAuthentication": {
      "providers": [
        "phone"
      ],
      "skipNativeAuth": true
    }
  }
}
