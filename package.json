    closeModal(); toast('تم حفظ بياناتك');
    const n = state._afterDetails; state._afterDetails = null; if (n) n(); else render();
  } catch (e) { toast(phoneSaveErr(e), 'error'); }
}
// تحذير خفيف لمن لا كلمة مرور له: يدخل برمز SMS في كل مرة حتى ينشئ كلمة مرور
