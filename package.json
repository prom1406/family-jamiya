function exportUsersCsv() {
  const rows = [['الاسم', 'البريد', 'الجوال', 'البنك', 'تاريخ التسجيل', 'عدد مرات الدخول', 'آخر دخول', 'أول دخول', 'عدد الجمعيات', 'الحالة', 'التصنيف', 'الملاحظات']];
