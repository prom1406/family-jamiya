const DEL_LOCK_MSG = 'لا يمكن حذف الجمعية بعد أول سداد مقبول حفاظاً على حقوق الأعضاء وسجلاتهم. إن لزم حذفها فتواصل مع إدارة التطبيق.';
async function openDeleteModal() {
  const c = ctx(); if (!c || !c.isCreator) return;
  let locked = !!c.j.hasConfirmed || (state.payments || []).some(p => p.status === 'confirmed');
  if (!locked) { try { locked = !(await db.collection('jamiyat').doc(c.j.id).collection('payments').where('status', '==', 'confirmed').limit(1).get()).empty; } catch (e) {} }
  if (locked) {
    if (!c.j.hasConfirmed) db.collection('jamiyat').doc(c.j.id).update({ hasConfirmed: true }).catch(() => {}); // تثبيت العلامة للجمعيات القديمة
    return showModal('الحذف غير متاح', `<div class="space-y-3"><div class="p-3 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-900 leading-relaxed"><i class="fa-solid fa-lock"></i> ${DEL_LOCK_MSG}</div><button class="btn b-sec w-full" data-act="close">حسناً</button></div>`);
  }
