function payStatus(c, uid) {
  if (uid === c.recUid && (sharesOf(c.turns, uid) === 1 || !c.acct[uid] || c.acct[uid].remaining <= 0.005)) return 'recipient';
  return c.acct[uid] ? c.acct[uid].status : 'unpaid';
}
const sharesOf = (turns, u) => Math.max(1, (turns || []).filter(x => x === u).length);
const filledOf = j => Math.max((j.turns || []).length, (j.memberUids || []).length); // الأسهم المشغولة
