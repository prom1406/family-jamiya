    return { j, family: true, idx: 0, cur: 0, finished: false, started: true, turns: tr, uniq: [...new Set(tr)], recUid: j.creatorUid, rec: state.members[j.creatorUid] || null,
      pays: state.payments, curPays: [], acct: {}, isCreator: mgr, isDeputy: false, canManage: mgr, isRec: mgr, me: null, f: freqOf(j) };
