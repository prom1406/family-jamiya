.ap-hero::before{content:"";position:absolute;width:240px;height:240px;border-radius:50%;background:rgba(255,255,255,.08);top:-120px;left:-90px;pointer-events:none}
.ap-hero::after{content:"";position:absolute;width:160px;height:160px;border-radius:50%;background:rgba(255,255,255,.05);bottom:-80px;right:-40px;pointer-events:none}
.ap-top,.ap-stats,.ap-prog{position:relative;z-index:1}
.ap-top{display:flex;align-items:center;gap:1rem;min-width:0}
.ap-avw{position:relative;width:72px;height:72px;flex:none}
.ap-ring{position:absolute;inset:0;width:100%;height:100%;transform:rotate(-90deg)}
.ap-ring .bg{fill:none;stroke:rgba(255,255,255,.2);stroke-width:4}
.ap-ring .fg{fill:none;stroke:#fff;stroke-width:4;stroke-linecap:round;transition:stroke-dashoffset .9s cubic-bezier(.2,.8,.2,1)}
.ap-av{position:absolute;inset:8px;border-radius:50%;background:rgba(255,255,255,.16);display:flex;align-items:center;justify-content:center;font-weight:900;font-size:1.2rem;overflow:hidden}
.ap-av img{width:100%;height:100%;object-fit:cover}
.ap-name{font-weight:900;font-size:1.12rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ap-sub{font-size:.75rem;opacity:.85;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}
.ap-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin-top:1.1rem}
.ap-stat{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.14);border-radius:16px;padding:.7rem .4rem;text-align:center}
