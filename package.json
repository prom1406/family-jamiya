}
async function confirmPayment(payId) {
  const pay = (state.payments || []).find(x => x.id === payId);
  try {
    const jr = db.collection('jamiyat').doc(state.j.id), b = db.batch();
    b.update(jr.collection('payments').doc(payId), { status: 'confirmed' });
    const jj = state.j, upd = {}; if (!jj.hasConfirmed) upd.hasConfirmed = true; // علامة دائمة: بعد أول سداد مقبول لا يحذف المشرف الجمعية
    const reached = !!pay && famAutoClose(jj, payId, pay.amount);
    if (reached) { upd.closed = true; upd.reached = true; }
    if (Object.keys(upd).length) b.update(jr, upd);
    await b.commit();
    if (reached) { sendNotifs(jj.memberUids, 'اكتمل الهدف 🎉', `بلغ تعاون «${jj.name}» مبلغه المستهدف، جزاكم الله خيراً`, jj.id, 'family'); jlog(jj.id, 'family', 'اكتمل المبلغ المستهدف وأُغلق التعاون تلقائياً'); }
    if (pay) jlog(state.j.id, 'confirm', `${dispName(state.profile)} أكّد استلام ${fmtNum(pay.amount)} ريال من ${pay.name || 'عضو'}`);
    if (pay) sendNotifs([pay.uid], 'تم تأكيد سدادك ✓', `${state.j.type === 'family' ? 'تعاون' : 'جمعية'} «${state.j.name}» — ${fmtNum(pay.amount)} ريال`, state.j.id, 'pay', 'pc_' + payId);
    closeModal(); toast('تم تأكيد الاستلام'); }
  catch (e) { toast(e.message, 'error'); }
}
async function remindUnpaid() {
  const c = ctx(); if (!c || !c.canManage) return; let n = 0; const late = [];
  c.uniq.forEach(uid => {
    const m = state.members[uid]; if (!m || !needsPay(c, uid)) return;
    n++; late.push(uid);
    sendMail(m.email, m.name, `تذكير بسداد قسط ${c.j.name}`, `السلام عليكم ${dispName(m)}،\nتذكير ودي بسداد قسط جمعية "${c.j.name}". المتبقي عليك ${fmtNum(c.acct[uid].remaining)} ريال، وآخر موعد للسداد ${fmtDate(dayIn(c.j, c.cur, c.j.lastDay))}.${mailLink()}`).catch(e => toast('فشل إرسال التذكير إلى ' + m.email + ': ' + (mailErrHint(e).hint || mailErrHint(e).raw), 'error'));
  });
