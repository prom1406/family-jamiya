/* ---- تفعيل البريد بدون تعطيل: تنبيه خفيف، ويُطلب عند الحاجة فقط ---- */
let verChecking = false;
async function softVerifyCheck(manual) {
  const u = auth.currentUser; if (!u || !realEmail(u) || verChecking) return;
  if (u.emailVerified) { if (manual) toast('بريدك مفعّل ✓'); return; }
  verChecking = true;
  try {
    await u.reload();
    if (u.emailVerified) { await u.getIdToken(true); state.user = auth.currentUser; if (state.profile) { cleanup(state.unsubs); startListeners(); } toast('تم تفعيل بريدك ✓'); closeModal(); render(); }
    else if (manual) toast('لم يُفعَّل بعد، افتح الرابط المرسل لبريدك ثم عد هنا', 'error');
  } catch (e) { if (manual) toast(authErr(e), 'error'); } finally { verChecking = false; }
}
document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') softVerifyCheck(false); });
function needVerified(next) {
