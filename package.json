}

/* ============ ترتيب الأدوار وتعديل الشروط ============ */
/* ===== تعديل ترتيب القبض (للمشرف) ===== */
function lockedCount(c) {
  if (c.finished) return c.turns.length;
  if (!c.started) return 0;
  return c.cur + (c.curPays.length > 0 ? 1 : 0); // الدورات الماضية، ودورة جارٍ فيها سداد، مقفلة
}
function openOrderModal() {
  const c = ctx(); if (!c || !c.isCreator) return;
  state.orderDraft = [...c.turns];
  showOrderModal();
}
function showOrderModal() {
  const c = ctx(), d = state.orderDraft, lock = lockedCount(c);
  const rows = d.map((u, i) => {
    const m = state.members[u] || { name: '...' }, locked = i < lock;
    return `<div class="flex items-center justify-between p-2.5 rounded-xl text-xs ${locked ? 'bg-slate-100 text-slate-400' : 'bg-slate-50 border border-slate-100'}">
      <div class="flex items-center gap-2"><span class="w-6 h-6 rounded-full ${locked ? 'bg-slate-200' : 'bg-emerald-100 text-emerald-800'} font-bold flex items-center justify-center">${i + 1}</span>
      <div><b>${esc(dispName(m))}</b><div class="text-[10px]">${periodLabel(c.j, i)}${locked ? ' • مقفل' : ''}</div></div></div>
      ${locked ? '<i class="fa-solid fa-lock"></i>' : `<div class="flex gap-1"><button class="btn b-sec" data-act="od-up" data-i="${i}" ${i <= lock ? 'disabled' : ''}>▲</button><button class="btn b-sec" data-act="od-down" data-i="${i}" ${i >= d.length - 1 ? 'disabled' : ''}>▼</button></div>`}</div>`;
  }).join('');
  showModal('تعديل ترتيب القبض', `<div class="space-y-3">
    <p class="text-[11px] text-slate-500">حرّك الأعضاء بالأسهم. الدورات المنتهية أو التي بدأ فيها السداد مقفلة لحماية سجل المدفوعات.</p>
    <div class="space-y-2">${rows}</div>
    <div class="flex gap-2"><button class="btn b-sec" data-act="od-shuffle"><i class="fa-solid fa-shuffle"></i> عشوائي للمتاح</button><button class="btn b-pri flex-1" data-act="od-save">حفظ الترتيب</button></div></div>`);
}
function orderMove(i, dlt) {
  const c = ctx(), d = state.orderDraft, k = i + dlt;
  if (i < lockedCount(c) || k < lockedCount(c) || k >= d.length) return;
  [d[i], d[k]] = [d[k], d[i]]; showOrderModal();
}
function orderShuffle() {
  const c = ctx(), d = state.orderDraft, lock = lockedCount(c);
  const free = d.slice(lock);
  for (let i = free.length - 1; i > 0; i--) { const k = Math.floor(Math.random() * (i + 1)); [free[i], free[k]] = [free[k], free[i]]; }
  state.orderDraft = d.slice(0, lock).concat(free); showOrderModal();
}
async function orderSave() {
  const c = ctx();
  if (state.orderDraft.slice(0, lockedCount(c)).join() !== c.turns.slice(0, lockedCount(c)).join()) return toast('لا يمكن تغيير الدورات المقفلة', 'error');
  try { await db.collection('jamiyat').doc(c.j.id).update({ turns: state.orderDraft }); closeModal(); toast('تم حفظ ترتيب القبض'); jlog(c.j.id, 'order', `${dispName(state.profile)} عدّل ترتيب القبض`); }
  catch (e) { toast(e.message, 'error'); }
}

async function submitMod(f) {
  const text = f.text.value.trim(); if (!text) return;
  try { await db.collection('jamiyat').doc(state.j.id).update({ modRequest: { text, byUid: state.user.uid, byName: dispName(state.profile), approvals: [state.user.uid], rejections: [], status: 'pending' } });
    sendNotifs(state.j.memberUids, 'طلب تعديل جديد يحتاج تصويتك', `${dispName(state.profile)} في جمعية «${state.j.name}»: ${text.slice(0, 120)}`, state.j.id, 'mod');
    closeModal(); toast('أُرسل الطلب للتصويت'); } catch (e) { toast(e.message, 'error'); }
}
async function voteMod(approve) {
  const uid = state.user.uid, r = { ...state.j.modRequest };
  r.approvals = (r.approvals || []).filter(x => x !== uid); r.rejections = (r.rejections || []).filter(x => x !== uid);
  (approve ? r.approvals : r.rejections).push(uid);
  const total = state.j.memberUids.length;
  if (r.approvals.length > total / 2) r.status = 'approved'; else if (r.rejections.length >= total / 2) r.status = 'rejected';
  try { await db.collection('jamiyat').doc(state.j.id).update({ modRequest: r });
    if (r.status === 'approved' || r.status === 'rejected') sendNotifs(state.j.memberUids, r.status === 'approved' ? 'اعتُمد طلب التعديل ✓' : 'رُفض طلب التعديل', `جمعية «${state.j.name}»: ${String(r.text || '').slice(0, 120)}`, state.j.id, 'mod');
  } catch (e) { toast(e.message, 'error'); }
}
async function closeMod() { try { await db.collection('jamiyat').doc(state.j.id).update({ modRequest: null }); } catch (e) { toast(e.message, 'error'); } }
const ymd = d => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
// عند تغيير المدة بعد البدء: تبدأ الدورة الحالية من اليوم بالمدة الجديدة، وتبقى أرقام الدورات والمدفوعات كما هي
function reanchorStart(freq, idx) {
  const f = FREQS[freq], n = new Date(), t = new Date(n.getFullYear(), n.getMonth(), n.getDate());
  return ymd(f.days ? new Date(t.getFullYear(), t.getMonth(), t.getDate() - idx * f.days) : new Date(t.getFullYear(), t.getMonth() - idx, 1));
}
async function submitEdit(f) {
  const c = ctx(), minCount = Math.max(2, filledOf(c.j), c.started ? c.cur + 1 : 2);
  const upd = { name: f.jname.value.trim(), icon: cleanIcon(f.icon.value), count: parseInt(f.count.value), amount: parseFloat(f.amount.value), lastDay: parseInt(f.lastDay.value), payDay: parseInt(f.payDay.value) };
  const newFreq = FREQS[f.frequency.value] ? f.frequency.value : (c.j.frequency || 'monthly');
  if (newFreq !== (c.j.frequency || 'monthly')) {
    upd.frequency = newFreq;
    if (c.started) {
      if (!confirm('تغيير مدة الدورة بعد بدء الجمعية: ستبدأ الدورة الحالية (رقم ' + (c.cur + 1) + ') من اليوم بالمدة الجديدة، ويبقى ترتيب القبض والمدفوعات كما هي. هل تريد المتابعة؟')) return;
      upd.startDate = reanchorStart(newFreq, c.idx);
    }
  }
  if (f.start && f.start.value && !c.started && state.payments.length === 0 && !upd.startDate) upd.startDate = f.start.value;
  const maxDay = maxDayOf({ frequency: upd.frequency || c.j.frequency });
  if (!(upd.count >= minCount && upd.count <= 30)) return toast(`عدد الأعضاء يجب أن يكون بين ${minCount} و30 (لا يقل عن الأعضاء الحاليين أو الدورات المنقضية)`, 'error');
  if (!upd.name || !(upd.amount > 0) || !(upd.lastDay >= 1 && upd.lastDay <= maxDay) || !(upd.payDay >= 1 && upd.payDay <= maxDay)) return toast(`قيم غير صحيحة (الأيام بين 1 و${maxDay})`, 'error');
  if (upd.amount !== c.j.amount && state.payments.length > 0) { state.pendingEdit = upd; return showRepriceModal(c, upd); }
  await saveEdit(upd);
}
async function saveEdit(upd) {
  const j = state.j, patch = { ...upd };
  if (upd.amount !== j.amount) patch.amountHistory = [...(j.amountHistory || []), { from: j.amount, to: upd.amount, at: Date.now(), by: dispName(state.profile) }];
  try { await db.collection('jamiyat').doc(j.id).update(patch); state.pendingEdit = null; closeModal(); toast('تم حفظ التعديلات'); jlog(j.id, 'edit', `${dispName(state.profile)} عدّل شروط الجمعية${upd.amount !== j.amount ? ` (القسط من ${fmtNum(j.amount)} إلى ${fmtNum(upd.amount)} ريال)` : ''}`); } catch (e) { toast(e.message, 'error'); }
}
// معاينة: كيف تُقسَّم مدفوعات كل عضو على القيمة الجديدة قبل الحفظ
function showRepriceModal(c, upd) {
  const j = c.j, newJ = { ...j, ...upd };
  const rows = c.uniq.map(u => {
    const m = state.members[u] || { name: '...' };
    const o = c.acct[u], nw = accountFor(newJ, c.turns, c.cur, c.started, state.payments, u, upd.amount);
    const res = nw.remaining > 0 ? `<span class="text-rose-600 font-bold">متبقي ${fmtNum(nw.remaining)} ريال</span>`
      : nw.credit > 0 ? `<span class="text-emerald-600 font-bold">رصيد مقدّم ${fmtNum(nw.credit)} ريال (يغطي ≈ ${fmtNum(nw.credit / upd.amount)} دفعة قادمة)</span>`
      : '<span class="text-emerald-600 font-bold">مسدّد بالكامل</span>';
    return `<div class="p-2.5 bg-slate-50 border border-slate-100 rounded-xl text-[11px] space-y-0.5"><b class="text-xs">${esc(dispName(m))}</b>
      <div class="text-slate-500">دفع ${fmtNum(o.paid)} ريال ← يعادل ${fmtNum(o.paid / upd.amount)} دفعة بالقيمة الجديدة (${fmtNum(upd.amount)})</div>
      <div>المستحق حتى الآن: ${fmtNum(nw.owed)} ريال • ${res}</div></div>`;
  }).join('');
  showModal('إعادة حساب المدفوعات بالقيمة الجديدة', `<div class="space-y-3 text-xs">
    <p class="text-slate-600">القيمة تتغير من <b>${fmtNum(j.amount)}</b> إلى <b>${fmtNum(upd.amount)}</b> ريال. يُحتسب كل ما دفعه كل عضو ويُقسَّم على القيمة الجديدة، ويبقى الفائض رصيداً يُخصم من الدفعات القادمة.</p>
