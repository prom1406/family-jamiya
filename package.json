      const id = pn.dataset.apPanel;
      pn.hidden = id === 'savebar' ? !AP_FORM_TABS.includes(t) : id !== t;
    });
    if (el.closest('.ap-hero')) root.querySelector('.ap-tabs').scrollIntoView({ behavior: 'smooth', block: 'start' });
  },
  'ap-go-email': () => { const el = document.querySelector('.ap-email'); if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' }); },
  // إجراء حساس: نقرتان متتاليتان خلال 4 ثوانٍ
  'ap-confirm': el => {
    if (el._apArmed) {
      clearTimeout(el._apT); el._apArmed = false;
      const fn = actions[el.dataset.target]; if (fn) fn(el);
      return;
    }
    el._apArmed = true; el._apHtml = el.innerHTML;
    el.classList.add('armed');
    el.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> اضغط مرة أخرى للتأكيد';
    el._apT = setTimeout(() => { el._apArmed = false; el.classList.remove('armed'); el.innerHTML = el._apHtml; }, 4000);
  }
};

// تنسيق الآيبان تلقائياً (SA00 0000 …) وإظهار علامة الصحة عند اكتمال الرقم
document.addEventListener('input', e => {
  const t = e.target;
  if (t.name === 'iban' && t.form && t.form.id === 'f-profile') {
    const f = fmtIban(t.value); if (f !== t.value) t.value = f;
    const box = t.closest('.ap-iban'); if (box) box.dataset.ok = ibanOk(f) ? '1' : '';
  }
});
// تفعيل زر الحذف بعد تأكيد الفهم
document.addEventListener('change', e => {
  const t = e.target;
  if (t.matches && t.matches('[data-del-ack]')) {
    const btn = t.closest('.ap-dz') && t.closest('.ap-dz').querySelector('.ap-btn-del');
    if (btn) btn.disabled = !t.checked;
  }
});

/* ============ النوافذ المنبثقة ============ */
function showModal(title, body) {
  stopChat();
  $('modal').innerHTML = `<div class="sheet-wrap fade" data-bg><div class="sheet space-y-4" role="dialog" aria-modal="true">
    <div class="flex justify-between items-center"><h3 class="font-black text-lg">${title}</h3><button data-act="close" class="w-9 h-9 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center" aria-label="إغلاق"><i class="fa-solid fa-xmark"></i></button></div>${body}</div></div>`;
}
function closeModal() { stopChat(); $('modal').innerHTML = ''; }

function bindRelLookup() {
  const f = $('f-invite'), box = $('rel-box'); if (!f || !box || !relOn()) return; let last = '';
  const paint = (t, cl) => { box.className = 'mt-2 p-2.5 rounded-xl text-[11px] leading-relaxed ' + cl; box.textContent = t; };
  const run = async () => {
    const ph = normPhone(f.phone.value); if (!validPhone(ph) || ph === last) return; last = ph;
    paint('جارٍ التحقق من سجل التزامه…', 'bg-slate-50 text-slate-500');
    try {
      const ps = await db.collection('phones').doc(ph).get();
      if (!ps.exists) return paint('غير مسجّل في التطبيق بعد، فلا يوجد سجل التزام له.', 'bg-slate-50 text-slate-500');
      const rs = await db.collection('reliability').doc(ps.data().uid).get();
      if (!rs.exists) return paint('مسجّل في التطبيق ولا يوجد له سجل التزام بعد.', 'bg-slate-50 text-slate-500');
      const r = rs.data();
      if (!r.show || r.pct == null) return paint('لم يُحدَّث سجل التزامه بعد، يظهر بعد أن يفتح التطبيق.', 'bg-slate-50 text-slate-500');
      if (r.pct < 0) return paint(`جديد: لم يحلّ عليه موعد سداد بعد (عضو في ${nf(r.mem)} جمعية، وأشرف على ${nf(r.sup)}).`, 'bg-sky-50 text-sky-800');
      paint(`التزامه ${r.pct}% — سدّد ${nf(r.on)} من ${nf(r.due)} دفعة في موعدها • عضو في ${nf(r.mem)} جمعية وأشرف على ${nf(r.sup)}.`, r.pct >= 90 ? 'bg-emerald-50 text-emerald-800' : r.pct >= 70 ? 'bg-amber-50 text-amber-800' : 'bg-rose-50 text-rose-800');
    } catch (e) { last = ''; paint('تعذر جلب سجل الالتزام.', 'bg-slate-50 text-slate-500'); }
  };
  f.phone.addEventListener('input', run); f.phone.addEventListener('blur', run);
}
function openModal(kind) {
  const c = ctx();
  if (kind === 'notif') { showModal('إشعار لأعضاء الجمعية', `<form id="f-notif" class="space-y-3"><input name="title" class="inp" maxlength="100" placeholder="عنوان الإشعار" required><textarea name="body" rows="4" class="inp" maxlength="500" placeholder="نص الإشعار…" required></textarea><p class="text-[11px] text-slate-500">يصل لكل أعضاء الجمعية على جوالهم.</p><button class="btn b-pri w-full py-3" type="submit"><i class="fa-solid fa-bullhorn"></i> إرسال</button></form>`); return; }
  if (kind === 'invite') showModal('دعوة عضو للجمعية', `<form id="f-invite" class="space-y-3"><div><label class="text-xs font-semibold block mb-1">اسم العضو</label><input name="name" class="inp" required></div>
    <div><label class="text-xs font-semibold block mb-1">رقم جواله (05xxxxxxxx)</label><input name="phone" type="tel" inputmode="tel" dir="ltr" class="inp" placeholder="05xxxxxxxx" required><div id="rel-box" class="hide mt-2"></div></div>
    <div><label class="text-xs font-semibold block mb-1">بريده الإلكتروني (اختياري)</label><input name="email" type="email" dir="ltr" class="inp"></div>
    <p class="text-[11px] text-slate-500 leading-relaxed">تظهر الدعوة للعضو تلقائياً عند تسجيله أو دخوله بنفس رقم الجوال. بعد الإنشاء ترسلها له عبر واتساب بضغطة واحدة.</p>
    <button class="btn b-pri w-full py-3" type="submit"><i class="fa-brands fa-whatsapp"></i> إنشاء الدعوة</button></form>`);
  if (kind === 'invite') bindRelLookup();
  if (kind === 'pay') showModal('إثبات سداد القسط', `<form id="f-pay" class="space-y-3"><p class="text-xs text-slate-500">حوّل إلى: <b>${esc(c.rec ? dispName(c.rec) : '')}</b> — ${esc(c.rec?.bank)} <span dir="ltr">${esc(c.rec?.iban || '')}</span></p>${c.rec?.iban ? `<button type="button" class="btn b-sec w-full" data-act="copy-iban" data-v="${esc(fixIban(c.rec.iban))}"><i class="fa-regular fa-copy"></i> نسخ الآيبان</button>` : ''}
    <div class="p-2.5 bg-slate-50 rounded-xl text-[11px] text-slate-600">القسط ${fmtNum(c.j.amount)} ريال ${c.f.every} • المستحق عليك حتى الآن ${fmtNum(c.me?.owed || 0)} • المتبقي <b>${fmtNum(c.me?.remaining || 0)}</b> ريال</div>
    <div><label class="text-xs font-semibold block mb-1">المبلغ المحوّل (ريال) — يمكنك دفع جزء أو أكثر من قسط</label><input name="amount" type="number" step="0.01" min="1" class="inp" value="${c.me && c.me.remaining > 0 ? c.me.remaining : c.j.amount}" required>
      <div class="flex gap-2 flex-wrap mt-2">${c.me && c.me.remaining > 0 ? `<button type="button" class="px-3 py-1.5 rounded-xl bg-emerald-50 text-emerald-700 text-xs font-bold" data-act="pay-fill" data-v="${c.me.remaining}">المتبقي كاملاً ${fmtNum(c.me.remaining)}</button>` : ''}${!(c.me && c.me.remaining === c.j.amount) ? `<button type="button" class="px-3 py-1.5 rounded-xl bg-slate-100 text-slate-700 text-xs font-bold" data-act="pay-fill" data-v="${c.j.amount}">قسط واحد ${fmtNum(c.j.amount)}</button>` : ''}</div></div>
    <div><label class="text-xs font-semibold block mb-1">صورة الإيصال (لقطة شاشة أو صورة)</label><input name="file" type="file" accept="image/*" class="inp" required><img id="pay-prev" class="hide mt-2 rounded-xl border max-h-44 mx-auto" alt="معاينة الإيصال"></div>
    <div><label class="text-xs font-semibold block mb-1">رقم مرجع الحوالة (اختياري)</label><input name="ref" class="inp" dir="ltr"></div>
    <button class="btn b-pri w-full py-3" type="submit">إرسال الإيصال</button></form>`);
  if (kind === 'mod') showModal('اقتراح تعديل على الشروط', `<form id="f-mod" class="space-y-3"><textarea name="text" rows="3" class="inp" required placeholder="اكتب التعديل المقترح بوضوح..."></textarea>
    <p class="text-[11px] text-slate-500">يُقبل الطلب عند موافقة أكثر من نصف الأعضاء، ثم يطبّقه المشرف.</p><button class="btn b-pri w-full py-3" type="submit">إرسال للتصويت</button></form>`);
  if (kind === 'edit') {
    const minCount = Math.max(2, filledOf(c.j), c.started ? c.cur + 1 : 2), dl = dayLabels(c.j.frequency);
    showModal('تعديل إعدادات الجمعية', `<form id="f-edit" class="space-y-3"><div><label class="text-xs font-semibold block mb-1">الاسم</label><input name="jname" class="inp" value="${esc(c.j.name)}" required></div>
    ${iconPicker(c.j.icon || '')}
    <div><label class="text-xs font-semibold block mb-1">نوع الجمعية (مدة الدورة)</label><select name="frequency" class="inp" data-freq>${freqOpts(c.j.frequency || 'monthly')}</select>
      ${c.started ? '<p class="text-[11px] text-amber-700 mt-1 leading-relaxed">تنبيه: عند تغيير المدة بعد البدء ستبدأ الدورة الحالية من اليوم بالمدة الجديدة، ويبقى ترتيب القبض والمدفوعات كما هي.</p>' : ''}</div>
    ${!c.started && !state.payments.length ? `<div><label class="text-xs font-semibold block mb-1">تاريخ البداية</label><input name="start" type="date" class="inp" value="${esc(c.j.startDate || '')}"></div>` : ''}
    <div class="grid grid-cols-2 gap-3"><div><label class="text-xs font-semibold block mb-1">عدد الأعضاء (الدورات)</label><input name="count" type="number" min="${minCount}" max="30" class="inp" value="${c.j.count}" required></div>
    <div><label class="text-xs font-semibold block mb-1">قيمة القسط (ريال)</label><input name="amount" type="number" step="0.01" class="inp" value="${c.j.amount}" required></div></div>
    <p class="text-[11px] text-slate-500">أقل عدد ممكن الآن: ${minCount}. عند تغيير قيمة القسط بعد وجود مدفوعات، يُعاد احتساب مدفوعات كل عضو وتقسيمها على القيمة الجديدة وتراها قبل الحفظ.</p>
    <div class="grid grid-cols-2 gap-3"><div><label class="text-xs font-semibold block mb-1" data-lbl-last>${dl.last}</label><input name="lastDay" type="number" min="1" max="${dl.max}" class="inp" value="${c.j.lastDay}" required></div>
    <div><label class="text-xs font-semibold block mb-1" data-lbl-pay>${dl.pay}</label><input name="payDay" type="number" min="1" max="${dl.max}" class="inp" value="${c.j.payDay}" required></div></div>
    <button class="btn b-pri w-full py-3" type="submit">حفظ</button></form>`);
  }
}

// قائمة مدفوعات عضو (للمراجعة والتأكيد)
function openMemberPays(uid) {
  const c = ctx(), m = state.members[uid] || { name: '...' }, ac = c.acct[uid]; if (!ac) return;
  const list = [...ac.mine].sort((a, b) => (a.month - b.month) || String(a.id).localeCompare(String(b.id)));
  const stB = { confirmed: ['مؤكدة', 'bg-emerald-100 text-emerald-700'], pending: ['بانتظار التأكيد', 'bg-sky-100 text-sky-700'] };
  const rows = list.map(p => {
    const b = stB[p.status] || stB.pending, canConfirm = p.status === 'pending' && (p.recipientUid === state.user.uid || c.isCreator);
    return `<div class="p-2.5 bg-slate-50 border border-slate-100 rounded-xl text-[11px] flex flex-wrap justify-between items-center gap-2">
      <div><b>${fmtNum(p.amount)} ريال</b> <span class="px-1.5 py-0.5 rounded ${b[1]} font-bold">${b[0]}</span>
      <div class="text-slate-500">دورة ${esc(periodLabel(c.j, p.month))}${p.ref ? ' • مرجع: ' + esc(p.ref) : ''}</div></div>
      <div class="flex gap-1.5">${p.hasProof ? `<button class="btn b-sec" data-act="view-proof" data-id="${esc(p.id)}">إيصال</button>` : ''}${canConfirm ? `<button class="btn bg-emerald-600 text-white" data-act="confirm-pay" data-id="${esc(p.id)}">تأكيد الاستلام</button>` : ''}</div></div>`;
  }).join('');
  showModal(`مدفوعات ${esc(dispName(m))}`, `<div class="space-y-2"><div class="text-[11px] text-slate-600">مدفوع ${fmtNum(ac.paid)} من المستحق ${fmtNum(ac.owed)} ريال${ac.credit > 0 ? ` • رصيد مقدّم ${fmtNum(ac.credit)}` : ac.remaining > 0 ? ` • متبقي ${fmtNum(ac.remaining)}` : ''}</div>${rows || '<p class="text-xs text-slate-400">لا توجد مدفوعات.</p>'}</div>`);
}

/* ============ رغبة الاستلام + دردشة الجمعية (يفتحها المشرف ويغلقها) ============ */
const isStaffJ = j => !!j && !!state.user && (j.creatorUid === state.user.uid || (!!j.deputyUid && j.deputyUid === state.user.uid));
const openPill = o => `<span class="px-2 py-0.5 rounded-lg text-[10px] font-bold ${o ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-500'}"><i class="fa-solid ${o ? 'fa-lock-open' : 'fa-lock'}"></i> ${o ? 'مفتوحة' : 'مغلقة'}</span>`;
const jref = () => db.collection('jamiyat').doc(state.j.id);

// المشرف ونائبه يريان كل الرغبات، والعضو يرى رغبته فقط
function syncWishes() {
  const j = state.j; if (!j || !state.user || j.type === 'family') return;
  const mode = isStaffJ(j) ? 'all' : 'mine';
  if (state.wishMode === mode) return;
  if (state.wishUnsub) { state.wishUnsub(); state.wishUnsub = null; }
  state.wishMode = mode; state.wishes = {};
  const col = jref().collection('wishes'), uid = state.user.uid, redraw = () => { if (state.view === 'jamiya') render(); };
  const onErr = e => { if (e.code !== 'permission-denied') toast('خطأ في تحميل الرغبات: ' + e.message, 'error'); };
  state.wishUnsub = mode === 'all'
    ? col.onSnapshot(s => { state.wishes = {}; s.docs.forEach(d => state.wishes[d.id] = d.data()); redraw(); }, onErr)
    : col.doc(uid).onSnapshot(s => { state.wishes = s.exists ? { [uid]: s.data() } : {}; redraw(); }, onErr);
}
const wishLine = (j, w) => `${w.pos ? 'الدور ' + w.pos + ' — ' + periodLabel(j, w.pos - 1) : 'بلا دور محدد'}${w.text ? ' • ' + esc(w.text) : ''}`;
function wishCard(c) {
  const j = c.j, open = !!j.wishOpen, uid = state.user.uid; if (!j.memberUids.includes(uid)) return '';
  const mine = state.wishes[uid];
  const myBox = mine ? `<div class="p-3 bg-emerald-50 border border-emerald-100 rounded-xl text-xs"><p class="text-[10px] text-emerald-700 font-bold mb-0.5">رغبتك</p>${wishLine(j, mine)}</div>`
    : `<p class="text-xs text-slate-400">${open ? 'لم تكتب رغبتك بعد.' : 'لم تكتب رغبة في هذه الجمعية.'}</p>`;
  let all = '';
  if (c.canManage) {
    const list = c.uniq.filter(u => state.wishes[u]), missing = c.uniq.filter(u => !state.wishes[u]);
    all = `<div class="pt-3 mt-3 border-t border-slate-100 space-y-1.5"><p class="text-[11px] font-bold text-slate-600">رغبات الأعضاء (${list.length}/${c.uniq.length})</p>
      ${list.map(u => `<div class="p-2 bg-slate-50 rounded-xl text-[11px]"><b>${esc(dispName(state.members[u]))}</b> <span class="text-slate-400">(ترتيبه الحالي ${c.turns.map((x, k) => x === u ? k + 1 : 0).filter(Boolean).join('، ')})</span><div class="text-slate-600">${wishLine(j, state.wishes[u])}</div></div>`).join('') || '<p class="text-[11px] text-slate-400">لا توجد رغبات بعد.</p>'}
      ${missing.length && list.length ? `<p class="text-[10px] text-slate-400">لم يكتب بعد: ${missing.map(u => esc(dispName(state.members[u]))).join('، ')}</p>` : ''}
      ${c.isCreator && c.turns.length > 1 ? '<button class="btn b-sec w-full" data-act="order-modal"><i class="fa-solid fa-arrow-down-1-9"></i> تعديل ترتيب القبض</button>' : ''}</div>`;
  }
  return `<div class="card p-5"><div class="flex justify-between items-center mb-3"><h4 class="font-bold text-sm"><i class="fa-solid fa-hand-holding-heart text-rose-500"></i> رغبة الاستلام</h4>${openPill(open)}</div>
    <div class="space-y-2.5">${myBox}${open ? `<button class="btn b-pri w-full" data-act="wish-modal"><i class="fa-solid fa-pen"></i> ${mine ? 'تعديل رغبتي' : 'اكتب رغبتي في الاستلام'}</button>` : '<p class="text-[11px] text-slate-500 leading-relaxed">يفتح المشرف الباب عندما يريد جمع رغبات الأعضاء في ترتيب الاستلام.</p>'}
    ${c.isCreator ? `<button class="btn ${open ? 'b-red' : 'b-sec'} w-full" data-act="wish-toggle"><i class="fa-solid ${open ? 'fa-lock' : 'fa-lock-open'}"></i> ${open ? 'إغلاق باب الرغبات' : 'فتح باب الرغبات للأعضاء'}</button>` : ''}</div>${all}</div>`;
}
function openWishModal() {
  const c = ctx(); if (!c) return;
  if (!c.j.wishOpen) return toast('باب الرغبات مغلق الآن', 'error');
  const w = state.wishes[state.user.uid] || {}, opts = ['<option value="0">لا أفضّل دوراً معيناً</option>'];
  for (let i = lockedCount(c); i < c.j.count; i++) opts.push(`<option value="${i + 1}" ${w.pos === i + 1 ? 'selected' : ''}>الدور ${i + 1} — ${periodLabel(c.j, i)}</option>`);
  showModal('رغبتي في الاستلام', `<form id="f-wish" class="space-y-3">
    <div><label class="text-xs font-semibold block mb-1">الدور الذي تفضّله</label><select name="pos" class="inp">${opts.join('')}</select></div>
    <div><label class="text-xs font-semibold block mb-1">ملاحظة للمشرف (اختياري)</label><textarea name="text" rows="3" maxlength="200" class="inp" placeholder="مثال: أحتاج المبلغ قبل بداية الدراسة">${esc(w.text || '')}</textarea></div>
    <p class="text-[11px] text-slate-500 leading-relaxed">رغبتك تظهر للمشرف ونائبه فقط، والقرار النهائي في ترتيب القبض للمشرف.</p>
    <button class="btn b-pri w-full py-3" type="submit">حفظ رغبتي</button>${w.uid ? '<button type="button" class="btn b-red w-full" data-act="wish-del">حذف رغبتي</button>' : ''}</form>`);
}
async function submitWish(f) {
  const j = state.j; if (!j) return;
  if (!j.wishOpen) return toast('باب الرغبات مغلق الآن', 'error');
  const text = f.text.value.trim().slice(0, 200), pos = parseInt(f.pos.value, 10) || 0, uid = state.user.uid;
  if (!text && !pos) return toast('اختر الدور الذي تفضّله أو اكتب ملاحظتك', 'error');
  const btn = f.querySelector('button[type=submit]'); btn.disabled = true;
  const first = !state.wishes[uid];
  try {
    await jref().collection('wishes').doc(uid).set({ uid, text, pos, updatedAt: FV.serverTimestamp() });
    closeModal(); toast('تم حفظ رغبتك');
    if (first) sendNotifs([j.creatorUid], 'رغبة استلام جديدة', `${dispName(state.profile)} كتب رغبته في جمعية «${j.name}»`, j.id, 'wish');
  } catch (e) { btn.disabled = false; toast(e.code === 'permission-denied' ? 'تعذر الحفظ: الباب أُغلق أو قواعد Firestore غير منشورة' : 'تعذر الحفظ: ' + e.message, 'error'); }
}
async function deleteWish() {
  if (!state.j) return;
  try { await jref().collection('wishes').doc(state.user.uid).delete(); closeModal(); toast('حُذفت رغبتك', 'info'); } catch (e) { toast('تعذر الحذف: ' + e.message, 'error'); }
}
async function toggleWishOpen() {
  const c = ctx(); if (!c || !c.isCreator) return;
  const open = !c.j.wishOpen;
  try {
    await jref().update({ wishOpen: open });
    toast(open ? 'فُتح باب الرغبات للأعضاء' : 'أُغلق باب الرغبات', open ? 'success' : 'info');
    if (open) sendNotifs(c.j.memberUids, 'باب رغبة الاستلام مفتوح', `اكتب الدور الذي تفضّله في جمعية «${c.j.name}»`, c.j.id, 'wish');
  } catch (e) { toast('تعذر التنفيذ: ' + e.message, 'error'); }
}

/* --- الدردشة --- */
function chatCard(c) {
  const j = c.j, open = !!j.chatOpen; if (!j.memberUids.includes(state.user.uid)) return '';
  return `<div class="card p-5"><div class="flex justify-between items-center mb-3"><h4 class="font-bold text-sm"><i class="fa-solid fa-comments text-teal-600"></i> دردشة الجمعية</h4>${openPill(open)}</div>
    <p class="text-[11px] text-slate-500 leading-relaxed mb-3">${open ? 'الدردشة مفتوحة لنقاش الأعضاء.' : 'الدردشة مغلقة حالياً، يفتحها المشرف عند الحاجة، ويمكنك قراءة الرسائل السابقة.'}</p>
    <div class="space-y-2"><button class="btn b-pri w-full" data-act="chat-open"><i class="fa-solid fa-comments"></i> ${open ? 'دخول الدردشة' : 'عرض الرسائل السابقة'}</button>
    ${c.isCreator ? `<button class="btn ${open ? 'b-red' : 'b-sec'} w-full" data-act="chat-toggle"><i class="fa-solid ${open ? 'fa-lock' : 'fa-lock-open'}"></i> ${open ? 'إغلاق الدردشة' : 'فتح الدردشة للأعضاء'}</button>` : ''}</div></div>`;
}
function stopChat() { if (state.chatUnsub) { state.chatUnsub(); state.chatUnsub = null; } state.chat = []; }
function openChat() {
  const j = state.j; if (!j || !j.memberUids.includes(state.user.uid)) return;
  showModal('<i class="fa-solid fa-comments text-teal-600"></i> دردشة ' + esc(j.name), `<div class="space-y-3"><div id="chat-status"></div>
    <div id="chat-list" class="h-72 overflow-y-auto space-y-2 p-2 bg-slate-50 rounded-2xl text-xs"></div>
    <form id="f-chat" class="flex gap-2 items-center"><input name="text" class="inp flex-1" maxlength="500" autocomplete="off" placeholder="اكتب رسالتك…" required><button class="btn b-pri" type="submit" aria-label="إرسال"><i class="fa-solid fa-paper-plane"></i></button></form></div>`);
  state.chat = [];
  state.chatUnsub = jref().collection('chat').orderBy('createdAt', 'desc').limit(100).onSnapshot(s => {
    state.chat = s.docs.map(d => ({ id: d.id, ...d.data() })).reverse(); paintChat(true);
  }, e => { const b = $('chat-list'); if (b) b.innerHTML = '<p class="text-center text-slate-400 py-6">تعذر تحميل الرسائل' + (e.code === 'permission-denied' ? ' (انشر قواعد Firestore المحدّثة)' : '') + '</p>'; });
  paintChat(true);
}
function paintChat(stick) {
  const box = $('chat-list'), j = state.j; if (!box || !j) return;
  const me = state.user.uid, isSup = j.creatorUid === me, open = !!j.chatOpen;
  const st = $('chat-status');
  if (st) st.innerHTML = `<div class="flex items-center justify-between gap-2 p-2.5 rounded-xl text-[11px] ${open ? 'bg-emerald-50 text-emerald-800' : 'bg-amber-50 text-amber-800'}"><span><i class="fa-solid ${open ? 'fa-lock-open' : 'fa-lock'}"></i> ${open ? 'الدردشة مفتوحة لأعضاء الجمعية' : 'الدردشة مغلقة — للقراءة فقط'}</span>${isSup ? `<button class="btn ${open ? 'b-red' : 'b-pri'} !min-h-[32px] !py-1" data-act="chat-toggle">${open ? 'إغلاق' : 'فتح'}</button>` : ''}</div>`;
  const fm = $('f-chat'); if (fm) fm.classList.toggle('hide', !open);
  const near = box.scrollHeight - box.scrollTop - box.clientHeight < 80;
  box.innerHTML = state.chat.length ? state.chat.map(m => {
    const mine = m.uid === me, mem = state.members[m.uid], t = tsd(m.createdAt);
    const tm = t ? t.toLocaleString(LOCD(), { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : 'الآن';
    const tag = m.uid === j.creatorUid ? ' <span class="opacity-70">(مشرف)</span>' : (j.deputyUid && m.uid === j.deputyUid) ? ' <span class="opacity-70">(نائب)</span>' : '';
    return `<div class="flex ${mine ? 'justify-start' : 'justify-end'}"><div class="max-w-[85%] px-3 py-2 rounded-2xl ${mine ? 'bg-emerald-600 text-white' : 'bg-white border border-slate-100'}">
      <p class="text-[10px] font-bold ${mine ? 'text-emerald-100' : 'text-teal-700'}">${mem ? esc(dispName(mem)) : 'عضو سابق'}${tag}</p>
      <p class="whitespace-pre-wrap break-words">${esc(m.text)}</p>
      <p class="text-[9px] opacity-60 mt-0.5 flex gap-2 items-center">${tm}${isSup ? `<button class="underline" data-act="chat-del" data-id="${esc(m.id)}">حذف</button>` : ''}</p></div></div>`;
  }).join('') : `<p class="text-center text-slate-400 py-10">${open ? 'ابدأ النقاش بأول رسالة 👋' : 'لا توجد رسائل.'}</p>`;
  if (stick || near) box.scrollTop = box.scrollHeight;
}
async function sendChat(f) {
  const j = state.j, text = f.text.value.trim(); if (!j || !text) return;
  if (!j.chatOpen) return toast('الدردشة مغلقة الآن', 'error');
  f.text.value = ''; f.text.focus();
  try { await jref().collection('chat').add({ uid: state.user.uid, text: text.slice(0, 500), createdAt: FV.serverTimestamp() }); }
  catch (e) { f.text.value = text; toast(e.code === 'permission-denied' ? 'تعذر الإرسال: الدردشة مغلقة أو قواعد Firestore غير منشورة' : 'تعذر الإرسال: ' + e.message, 'error'); }
}
async function toggleChatOpen() {
  const j = state.j; if (!j || j.creatorUid !== state.user.uid) return;
  const open = !j.chatOpen;
  try {
    await jref().update({ chatOpen: open });
    toast(open ? 'فُتحت الدردشة للأعضاء' : 'أُغلقت الدردشة', open ? 'success' : 'info');
    if (open) sendNotifs(j.memberUids, 'فُتحت دردشة الجمعية', `يمكنك المشاركة في نقاش جمعية «${j.name}» الآن`, j.id, 'chat');
  } catch (e) { toast('تعذر التنفيذ: ' + e.message, 'error'); }
}
function chatDelete(id) { if (state.j) jref().collection('chat').doc(id).delete().catch(e => toast('تعذر حذف الرسالة: ' + e.message, 'error')); }

/* ============ أكثر من سهم + تبديل الأدوار + نسخ الآيبان ============ */
async function copyText(txt, okMsg) {
  try { await navigator.clipboard.writeText(txt); return toast(okMsg || 'تم النسخ'); } catch (e) {}
  try {
    const ta = document.createElement('textarea'); ta.value = txt; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;top:0;opacity:0';
    document.body.appendChild(ta); ta.select(); ta.setSelectionRange(0, 999); const ok = document.execCommand('copy'); ta.remove();
    toast(ok ? (okMsg || 'تم النسخ') : 'تعذر النسخ', ok ? 'success' : 'error');
  } catch (e) { toast('تعذر النسخ', 'error'); }
}

/* --- طلبات الأسهم الإضافية: المشرف يرى الكل والعضو يرى طلبه --- */
function syncShareReqs() {
  const j = state.j; if (!j || !state.user || j.type === 'family') return;
  const mode = j.creatorUid === state.user.uid ? 'all' : 'mine';
  if (state.shareMode === mode) return;
  if (state.shareUnsub) { state.shareUnsub(); state.shareUnsub = null; }
  state.shareMode = mode; state.shareReqs = {};
  const col = jref().collection('shareReqs'), uid = state.user.uid, redraw = () => { if (state.view === 'jamiya') render(); };
  const onErr = e => { if (e.code !== 'permission-denied') toast('خطأ في طلبات الأسهم: ' + e.message, 'error'); };
  state.shareUnsub = mode === 'all'
    ? col.onSnapshot(s => { state.shareReqs = {}; s.docs.forEach(d => state.shareReqs[d.id] = d.data()); redraw(); }, onErr)
    : col.doc(uid).onSnapshot(s => { state.shareReqs = s.exists ? { [uid]: s.data() } : {}; redraw(); }, onErr);
}
function sharesCard(c) {
  const j = c.j, uid = state.user.uid; if (!j.memberUids.includes(uid)) return '';
  const my = sharesOf(c.turns, uid), open = Math.max(0, j.count - c.turns.length), req = state.shareReqs[uid];
  const nm = u => esc(dispName(state.members[u]));
  const reqs = c.isCreator ? Object.values(state.shareReqs).filter(r => j.memberUids.includes(r.uid)) : [];
  let mine = '';
  if (req && !c.isCreator) mine = `<div class="p-3 bg-amber-50 border border-amber-200 rounded-xl text-xs space-y-2"><p>طلبك لـ <b>${req.extra}</b> ${req.extra === 1 ? 'سهم إضافي' : 'أسهم إضافية'} بانتظار موافقة المشرف.</p><button class="btn b-red" data-act="share-cancel"><i class="fa-solid fa-xmark"></i> إلغاء الطلب</button></div>`;
  else if (!req && open > 0 && !c.finished) mine = `<button class="btn b-sec w-full" data-act="share-modal"><i class="fa-solid fa-layer-group"></i> طلب سهم إضافي</button>`;
  else if (!req) mine = '<p class="text-[11px] text-slate-400">لا توجد أسهم شاغرة لطلبها حالياً.</p>';
  const list = reqs.length ? `<div class="pt-3 mt-3 border-t border-slate-100 space-y-2"><p class="text-[11px] font-bold text-slate-600">طلبات الأسهم (${reqs.length})</p>${reqs.map(r => `<div class="p-2.5 bg-amber-50 border border-amber-200 rounded-xl text-xs space-y-2"><p><b>${nm(r.uid)}</b> يطلب ${r.extra} ${r.extra === 1 ? 'سهماً إضافياً' : 'أسهم إضافية'} <span class="text-slate-500">(لديه ${sharesOf(c.turns, r.uid)})</span></p>
      <div class="flex gap-2"><button class="btn b-pri flex-1" data-act="share-yes" data-uid="${esc(r.uid)}">موافقة</button><button class="btn b-red flex-1" data-act="share-no" data-uid="${esc(r.uid)}">رفض</button></div></div>`).join('')}</div>` : '';
  return `<div class="card p-5"><h4 class="font-bold text-sm mb-3"><i class="fa-solid fa-layer-group text-sky-600"></i> الأسهم</h4>
    <div class="text-xs space-y-1.5 mb-3"><div class="flex justify-between"><span>أسهمك</span><b>${my}</b></div><div class="flex justify-between"><span>الأسهم الشاغرة في الجمعية</span><b>${open}</b></div></div>${mine}${list}</div>`;
}
function openShareModal() {
  const c = ctx(); if (!c) return;
  const open = c.j.count - c.turns.length; if (open <= 0) return toast('لا توجد أسهم شاغرة', 'error');
  const opts = Array.from({ length: Math.min(open, 5) }, (_, i) => `<option value="${i + 1}">${i + 1}</option>`).join('');
  showModal('طلب أسهم إضافية', `<form id="f-share" class="space-y-3"><p class="text-xs text-slate-600 leading-relaxed">لديك الآن <b>${sharesOf(c.turns, state.user.uid)}</b> سهم، والمتاح في الجمعية <b>${open}</b>. كل سهم إضافي يمنحك دور استلام إضافياً ويلزمك بقسط إضافي، ويحتاج موافقة المشرف.</p>
    <div><label class="text-xs font-semibold block mb-1">عدد الأسهم الإضافية</label><select name="extra" class="inp">${opts}</select></div>
    <button class="btn b-pri w-full py-3" type="submit">إرسال الطلب للمشرف</button></form>`);
}
async function submitShare(f) {
  const c = ctx(); if (!c) return;
  const extra = parseInt(f.extra.value, 10) || 0, open = c.j.count - c.turns.length;
  if (extra < 1 || extra > open) return toast('العدد المطلوب أكبر من الأسهم الشاغرة', 'error');
  const btn = f.querySelector('button[type=submit]'); btn.disabled = true;
  try {
    await jref().collection('shareReqs').doc(state.user.uid).set({ uid: state.user.uid, extra, createdAt: FV.serverTimestamp() });
    closeModal(); toast('أُرسل طلبك للمشرف');
    sendNotifs([c.j.creatorUid], 'طلب سهم إضافي', `${dispName(state.profile)} يطلب ${extra} ${extra === 1 ? 'سهماً' : 'أسهماً'} إضافية في جمعية «${c.j.name}»`, c.j.id, 'share');
  } catch (e) { btn.disabled = false; toast(e.code === 'permission-denied' ? 'تعذر الإرسال: قواعد Firestore غير منشورة' : 'تعذر الإرسال: ' + e.message, 'error'); }
}
async function approveShare(uid) {
  const c = ctx(); if (!c || !c.isCreator) return;
  const r = state.shareReqs[uid]; if (!r) return;
  const ref = jref(), del = () => ref.collection('shareReqs').doc(uid).delete().catch(() => {});
  if (!c.j.memberUids.includes(uid)) { del(); return toast('لم يعد عضواً في الجمعية', 'error'); }
  if (r.extra > c.j.count - c.turns.length) return toast('الأسهم الشاغرة لا تكفي لهذا الطلب. ارفض الطلب أو ارفع عدد الأعضاء من «تعديل»', 'error');
  if (c.turns.length < lockedCount(c)) return toast('لا يمكن إضافة سهم الآن لأن دورات سابقة لم تُشغل. عدّل ترتيب القبض أولاً', 'error');
  const batch = db.batch();
  batch.update(ref, { turns: [...c.turns, ...Array(r.extra).fill(uid)] });
  batch.delete(ref.collection('shareReqs').doc(uid));
  try { await batch.commit(); toast('تمت الموافقة وأُضيفت الأسهم'); jlog(c.j.id, 'share', `${dispName(state.profile)} وافق على إضافة ${r.extra} ${r.extra === 1 ? 'سهم' : 'أسهم'} لـ ${dispName(state.members[uid])}`); sendNotifs([uid], 'تمت الموافقة على طلبك', `أُضيف ${r.extra} ${r.extra === 1 ? 'سهم' : 'أسهم'} لك في جمعية «${c.j.name}»`, c.j.id, 'share'); }
  catch (e) { toast('تعذر التنفيذ: ' + e.message, 'error'); }
}
async function rejectShare(uid) {
  const c = ctx(); if (!c || !c.isCreator) return;
  try { await jref().collection('shareReqs').doc(uid).delete(); toast('رُفض الطلب', 'info'); sendNotifs([uid], 'لم يُقبل طلب السهم', `اعتذر المشرف عن طلبك في جمعية «${c.j.name}»`, c.j.id, 'share'); }
  catch (e) { toast('تعذر التنفيذ: ' + e.message, 'error'); }
}
function cancelShare() { if (state.j) jref().collection('shareReqs').doc(state.user.uid).delete().then(() => toast('أُلغي الطلب', 'info')).catch(e => toast(e.message, 'error')); }

/* --- تبديل الأدوار بين عضوين: عند موافقة الطرف الآخر يتبدّل الترتيب تلقائياً --- */
function listenSwaps(id) {
  const me = state.user.uid, col = db.collection('jamiyat').doc(id).collection('swapReqs'); let A = [], B = [];
  const merge = () => { const m = new Map(); [...A, ...B].forEach(r => m.set(r.id, r)); state.swapReqs = [...m.values()]; if (state.view === 'jamiya') render(); };
  const err = () => {};
  state.jUnsubs.push(
    col.where('fromUid', '==', me).onSnapshot(s => { A = s.docs.map(d => ({ id: d.id, ...d.data() })); merge(); }, err),
    col.where('toUid', '==', me).onSnapshot(s => { B = s.docs.map(d => ({ id: d.id, ...d.data() })); merge(); }, err));
}
function swapBtn(c, i) {
  const me = state.user.uid, u = c.turns[i], lock = lockedCount(c);
  if (c.finished || u === me || i < lock || !c.j.memberUids.includes(me) || !c.turns.some((x, k) => x === me && k >= lock)) return '';
  if (state.swapReqs.some(r => r.fromUid === me && r.toIdx === i)) return '<span class="text-[10px] text-slate-400">طلب تبديل معلّق</span>';
  return `<button class="px-2 py-1 bg-sky-50 text-sky-700 rounded-lg" data-act="swap-modal" data-i="${i}"><i class="fa-solid fa-right-left"></i> طلب تبديل</button>`;
}
function swapCard(c) {
  const me = state.user.uid, reqs = state.swapReqs; if (!reqs.length || !c.j.memberUids.includes(me)) return '';
  const nm = u => esc(dispName(state.members[u])), lbl = k => `رقم ${k + 1} (${periodLabel(c.j, k)})`;
  const inc = reqs.filter(r => r.toUid === me).map(r => `<div class="p-2.5 bg-sky-50 border border-sky-200 rounded-xl text-xs space-y-2"><p><b>${nm(r.fromUid)}</b> يطلب أن تتبادلا الأدوار: دوره ${lbl(r.fromIdx)} مقابل دورك ${lbl(r.toIdx)}</p>
    <div class="flex gap-2"><button class="btn b-pri flex-1" data-act="swap-yes" data-id="${esc(r.id)}">موافقة</button><button class="btn b-red flex-1" data-act="swap-no" data-id="${esc(r.id)}">رفض</button></div></div>`).join('');
  const out = reqs.filter(r => r.fromUid === me).map(r => `<div class="p-2.5 bg-slate-50 border border-slate-100 rounded-xl text-xs space-y-2"><p>طلبت من <b>${nm(r.toUid)}</b> تبديل دورك ${lbl(r.fromIdx)} بدوره ${lbl(r.toIdx)} — بانتظار الرد</p>
    <button class="btn b-red" data-act="swap-cancel" data-id="${esc(r.id)}">إلغاء الطلب</button></div>`).join('');
  return `<div class="card p-5"><h4 class="font-bold text-sm mb-3"><i class="fa-solid fa-right-left text-sky-600"></i> تبديل الأدوار</h4><div class="space-y-2">${inc}${out}</div></div>`;
}
function openSwapModal(i) {
  const c = ctx(); if (!c) return; const me = state.user.uid, lock = lockedCount(c), target = c.turns[i];
  if (!target || target === me || i < lock) return toast('لا يمكن تبديل هذا الدور', 'error');
  const mine = c.turns.map((u, k) => u === me && k >= lock ? k : -1).filter(k => k >= 0);
  if (!mine.length) return toast('ليس لديك دور متاح للتبديل (الأدوار المنقضية أو الجارية مقفلة)', 'error');
  showModal('طلب تبديل دور', `<form id="f-swap" class="space-y-3"><input type="hidden" name="to" value="${i}">
    <div class="p-3 bg-slate-50 rounded-xl text-xs">تطلب من <b>${esc(dispName(state.members[target]))}</b> أن يتبادل معك دوره رقم <b>${i + 1}</b> (${periodLabel(c.j, i)}).</div>
    <div><label class="text-xs font-semibold block mb-1">دورك الذي تعطيه له</label><select name="mine" class="inp">${mine.map(k => `<option value="${k}">رقم ${k + 1} — ${periodLabel(c.j, k)}</option>`).join('')}</select></div>
    <p class="text-[11px] text-slate-500 leading-relaxed">عند موافقته يتبدّل الترتيب تلقائياً ويُبلَّغ المشرف.</p>
    <button class="btn b-pri w-full py-3" type="submit"><i class="fa-solid fa-right-left"></i> إرسال الطلب</button></form>`);
}
async function submitSwap(f) {
  const c = ctx(); if (!c) return; const me = state.user.uid, lock = lockedCount(c);
  const a = parseInt(f.mine.value, 10), b = parseInt(f.to.value, 10), to = c.turns[b];
  if (c.turns[a] !== me || !to || to === me || a < lock || b < lock) return toast('تغيّر الترتيب، أعد المحاولة', 'error');
  const btn = f.querySelector('button[type=submit]'); btn.disabled = true;
  try {
    await jref().collection('swapReqs').add({ fromUid: me, toUid: to, fromIdx: a, toIdx: b, lo: Math.min(a, b), hi: Math.max(a, b), status: 'pending', createdAt: FV.serverTimestamp() });
    closeModal(); toast('أُرسل طلب التبديل');
    sendNotifs([to], 'طلب تبديل دور', `${dispName(state.profile)} يطلب تبديل دوره بدورك في جمعية «${c.j.name}»`, c.j.id, 'swap');
  } catch (e) { btn.disabled = false; toast(e.code === 'permission-denied' ? 'تعذر الإرسال: قواعد Firestore غير منشورة' : 'تعذر الإرسال: ' + e.message, 'error'); }
}
async function approveSwap(id) {
  const c = ctx(), me = state.user.uid, r = state.swapReqs.find(x => x.id === id); if (!c || !r || r.toUid !== me) return;
  const ref = jref(), reqRef = ref.collection('swapReqs').doc(id), t = c.turns;
  if (t[r.fromIdx] !== r.fromUid || t[r.toIdx] !== me || r.lo < lockedCount(c)) {
    reqRef.delete().catch(() => {}); return toast('تغيّر الترتيب أو أُقفل أحد الدورين، أُلغي الطلب', 'error');
  }
  const n = [...t]; n[r.lo] = t[r.hi]; n[r.hi] = t[r.lo];
  const batch = db.batch(); batch.update(ref, { turns: n, lastSwap: id }); batch.delete(reqRef);
  try {
    await batch.commit(); toast('تم تبديل الدورين');
    jlog(c.j.id, 'swap', `تبادل ${dispName(state.members[r.fromUid])} و${dispName(state.members[me])} دوريهما (رقم ${r.fromIdx + 1} ورقم ${r.toIdx + 1})`);
    sendNotifs([r.fromUid, c.j.creatorUid], 'تم تبديل الأدوار', `تبادل ${dispName(state.members[r.fromUid])} و${dispName(state.members[me])} دوريهما في جمعية «${c.j.name}»`, c.j.id, 'swap');
  } catch (e) { toast(e.code === 'permission-denied' ? 'تعذر التبديل: لم تقبل قواعد Firestore العملية. انشر أحدث نسخة من firestore.rules ثم أعد المحاولة' : 'تعذر التبديل: ' + e.message, 'error'); }
}
async function rejectSwap(id, cancel) {
  const r = state.swapReqs.find(x => x.id === id); if (!r || !state.j) return;
  try {
    await jref().collection('swapReqs').doc(id).delete(); toast(cancel ? 'أُلغي الطلب' : 'رُفض الطلب', 'info');
    if (!cancel) sendNotifs([r.fromUid], 'لم يُقبل طلب التبديل', `اعتذر ${dispName(state.profile)} عن تبديل الدور في جمعية «${state.j.name}»`, state.j.id, 'swap');
  } catch (e) { toast('تعذر التنفيذ: ' + e.message, 'error'); }
}

/* ============ دعوة برابط واحد ============ */
const joinUrl = code => appUrl() + (appUrl().includes('?') ? '&' : '?') + 'join=' + code;
const joinText = j => j.type === 'family' ? `دعوة للمشاركة في تعاون عائلي «${j.name}» — الهدف: ${j.goal}. ${j.endDate ? 'ينتهي ' + j.endDate + '.' : 'مستمر شهرياً حتى بلوغ الهدف.'}\nشارك من الرابط:\n${joinUrl(j.joinCode)}` : `دعوة للانضمام إلى جمعية «${j.name}» — القسط ${fmtNum(j.amount)} ريال ${freqOf(j).every}، عدد الأعضاء ${j.count}.\nانضم من الرابط:\n${joinUrl(j.joinCode)}`;
const newJoinCode = () => { const a = new Uint8Array(10); crypto.getRandomValues(a); return Array.from(a, b => 'abcdefghjkmnpqrstuvwxyz23456789'[b % 31]).join(''); };
const linkDoc = (j, open) => ({ jid: j.id, creatorUid: j.creatorUid, creatorName: dispName(state.profile), name: j.name, amount: j.amount, count: j.count, frequency: j.frequency || 'monthly', type: j.type || 'jamiya', goal: j.goal || '', endDate: j.endDate || '', open, updatedAt: FV.serverTimestamp() });
function joinCard(c) {
  const j = c.j; if (!c.canManage) return '';
  if (!j.joinCode) return c.isCreator ? `<div class="card p-5"><h4 class="font-bold text-sm mb-2"><i class="fa-solid fa-link text-teal-600"></i> رابط الانضمام</h4>
    <p class="text-[11px] text-slate-500 leading-relaxed mb-3">أنشئ رابطاً واحداً وأرسله في قروب الجمعية، وكل عضو يضغطه وينضم مباشرة دون دعوة فردية.</p>
    <button class="btn b-pri w-full" data-act="join-create"><i class="fa-solid fa-link"></i> إنشاء رابط الانضمام</button></div>` : '';
  const open = !!j.joinOpen, free = Math.max(0, j.count - filledOf(j));
  return `<div class="card p-5"><div class="flex justify-between items-center mb-2"><h4 class="font-bold text-sm"><i class="fa-solid fa-link text-teal-600"></i> رابط الانضمام</h4>${openPill(open && free > 0)}</div>
    <p class="text-[11px] text-slate-500 leading-relaxed mb-2">${free ? `${j.type === 'family' ? 'المقاعد المتاحة' : 'الأسهم الشاغرة'}: <b>${free}</b>. ` : 'اكتمل العدد فلن يقبل الرابط أعضاء جدداً. '}كل من يفتح الرابط ويسجّل دخوله ينضم مباشرة.</p>
    <div class="p-2 bg-slate-50 rounded-xl text-[10px] text-slate-500 break-all" dir="ltr">${esc(joinUrl(j.joinCode))}</div>
    <div class="flex gap-2 mt-3"><button class="btn b-sec flex-1" data-act="join-copy"><i class="fa-regular fa-copy"></i> نسخ</button><a class="btn b-pri flex-1" target="_blank" rel="noopener" href="${waLink('', joinText(j))}"><i class="fa-brands fa-whatsapp"></i> واتساب</a></div>
    ${c.isCreator ? `<div class="flex gap-2 mt-2"><button class="btn ${open ? 'b-red' : 'b-sec'} flex-1" data-act="join-toggle">${open ? 'إيقاف الرابط' : 'تفعيل الرابط'}</button><button class="btn b-sec flex-1" data-act="join-regen">رابط جديد</button></div>` : ''}</div>`;
}
async function createJoinLink(regen) {
  const j = state.j; if (!j || j.creatorUid !== state.user.uid) return;
  if (regen && !confirm('سيتوقف الرابط القديم عن العمل ويُنشأ رابط جديد. متابعة؟')) return;
  const code = newJoinCode(), b = db.batch();
  b.update(jref(), { joinCode: code, joinOpen: true });
  b.set(db.collection('joinLinks').doc(code), linkDoc(j, true));
  if (j.joinCode) b.delete(db.collection('joinLinks').doc(j.joinCode));
  try { await b.commit(); toast(regen ? 'أُنشئ رابط جديد' : 'أُنشئ رابط الانضمام'); }
  catch (e) { toast(e.code === 'permission-denied' ? 'تعذر الإنشاء: انشر أحدث نسخة من قواعد Firestore' : 'تعذر الإنشاء: ' + e.message, 'error'); }
}
async function toggleJoin() {
  const j = state.j; if (!j || j.creatorUid !== state.user.uid || !j.joinCode) return;
  const open = !j.joinOpen, b = db.batch();
  b.update(jref(), { joinOpen: open });
  b.update(db.collection('joinLinks').doc(j.joinCode), { open, updatedAt: FV.serverTimestamp() });
  try { await b.commit(); toast(open ? 'فُعّل رابط الانضمام' : 'أُوقف رابط الانضمام', open ? 'success' : 'info'); } catch (e) { toast('تعذر التنفيذ: ' + e.message, 'error'); }
}
function copyJoinLink() {
  const j = state.j; if (!j || !j.joinCode) return;
  if (j.creatorUid === state.user.uid) db.collection('joinLinks').doc(j.joinCode).update(linkDoc(j, !!j.joinOpen)).catch(() => {}); // نحدّث بيانات المعاينة
  copyText(joinUrl(j.joinCode), 'تم نسخ رابط الانضمام');
}
async function checkPendingJoin() {
  const op = lsGet('jm_open'); if (op && state.user && state.profile && !state.isAdmin) { try { localStorage.removeItem('jm_open'); } catch (e) {} openJamLink(op); }
  const code = lsGet('jm_join'); if (!code || !state.user || !state.profile || state.isAdmin) return;
  try { localStorage.removeItem('jm_join'); } catch (e) {}
  try {
    const sn = await db.collection('joinLinks').doc(code).get();
    if (!sn.exists) return toast('رابط الانضمام غير صالح أو أُلغي', 'error');
    const l = sn.data();
    if (state.jamiyat.some(j => j.id === l.jid)) { toast('أنت عضو في هذه الجمعية بالفعل', 'info'); return openJamiya(l.jid); }
    state.joinLink = { code, ...l };
    showModal('دعوة للانضمام', `<div class="space-y-3"><div class="p-4 bg-teal-50 border border-teal-100 rounded-2xl text-center space-y-1"><p class="text-[11px] text-teal-700">دعاك ${esc(l.creatorName || 'المشرف')} للانضمام إلى</p><p class="text-lg font-black text-teal-900">${esc(l.name)}</p>
      ${l.type === 'family' ? `<p class="text-xs text-violet-700 font-bold">تعاون عائلي • ${esc(l.goal || '')}</p><p class="text-[11px] text-slate-500">${l.endDate ? 'ينتهي ' + esc(l.endDate) : 'مستمر شهرياً حتى بلوغ الهدف'}</p>` : `<p class="text-xs text-slate-600">القسط <b>${fmtNum(l.amount)}</b> ريال ${(FREQS[l.frequency] || FREQS.monthly).every} • ${l.count} أعضاء</p>`}</div>
      ${l.open ? '' : '<p class="p-3 bg-amber-50 rounded-xl text-xs text-amber-800">هذا الرابط متوقف حالياً، تواصل مع المشرف.</p>'}
      <div class="flex gap-2"><button class="btn b-sec flex-1" data-act="close">لاحقاً</button>${l.open ? '<button class="btn b-pri flex-1" data-act="join-do"><i class="fa-solid fa-user-plus"></i> انضم الآن</button>' : ''}</div></div>`);
  } catch (e) { toast('تعذر فتح رابط الانضمام: ' + e.message, 'error'); }
}
function joinFromLink() {
  const l = state.joinLink; if (!l) return;
  needVerified(() => l.type === 'family' ? joinFromLinkCore() : needDetails(() => joinFromLinkCore()));
}
async function joinFromLinkCore() {
  const l = state.joinLink; if (!l || !state.user) return;
  const uid = state.user.uid, ref = db.collection('jamiyat').doc(l.jid), b = db.batch();
  b.set(db.collection('joins').doc(`${l.jid}__${uid}__${l.code}`), { jid: l.jid, uid, code: l.code, createdAt: FV.serverTimestamp() });
  b.update(ref, { memberUids: FV.arrayUnion(uid), turns: FV.arrayUnion(uid) });
  b.set(ref.collection('members').doc(uid), memberDoc(uid, state.profile));
  try { await b.commit(); closeModal(); toast('تم الانضمام للجمعية 🎉'); notifyJoin({ jamiyaId: l.jid }); jlog(l.jid, 'join', `${dispName(state.profile)} انضم إلى الجمعية عبر الرابط`); state.joinLink = null; openJamiya(l.jid); }
  catch (e) { toast(e.code === 'permission-denied' ? 'تعذر الانضمام: اكتمل عدد الأعضاء أو أُوقف الرابط أو لم يُوثَّق بريدك بعد' : 'تعذر الانضمام: ' + e.message, 'error'); }
}

/* ============ الثقة: سجل النشاط + كشف العضو + نسبة الالتزام + قفل التطبيق ============ */
const LOG_ICO = { pledge: '📝', family: '🤝', pay: '💸', confirm: '✅', swap: '🔁', share: '🧩', join: '👋', edit: '✏️', order: '🔢', remove: '🚪' };
function jlog(jid, type, text) {
  if (!state.user || !jid) return;
  db.collection('jamiyat').doc(jid).collection('log').add({ uid: state.user.uid, type, text: String(text).slice(0, 200), createdAt: FV.serverTimestamp() }).catch(() => {});
}
function trustCard(c) {
  if (!c.j.memberUids.includes(state.user.uid)) return '';
  return `<div class="card p-5"><h4 class="font-bold text-sm mb-3"><i class="fa-solid fa-shield-halved text-teal-600"></i> الشفافية والكشوف</h4><div class="grid grid-cols-2 gap-2">
    <button class="btn b-sec" data-act="log-open"><i class="fa-solid fa-clock-rotate-left"></i> سجل النشاط</button><button class="btn b-sec" data-act="stmt-me"><i class="fa-solid fa-file-lines"></i> كشف حسابي</button></div></div>`;
}
async function openLog() {
  const j = state.j; if (!j) return;
  showModal('سجل النشاط', '<div id="log-box" class="space-y-2 max-h-[60vh] overflow-y-auto"><p class="text-center text-xs text-slate-400 py-6">جارٍ التحميل…</p></div><p class="text-[10px] text-slate-400 mt-3">سجل للقراءة فقط لا يمكن تعديله، ويظهر لجميع أعضاء الجمعية.</p>');
  try {
    const sn = await jref().collection('log').orderBy('createdAt', 'desc').limit(80).get(), box = $('log-box'); if (!box) return;
    box.innerHTML = sn.empty ? '<p class="text-center text-xs text-slate-400 py-6">لا توجد أحداث مسجّلة بعد.</p>' : sn.docs.map(d => { const e = d.data(), t = tsd(e.createdAt);
      return `<div class="flex gap-2 p-2.5 bg-slate-50 rounded-xl text-xs"><span class="text-base">${LOG_ICO[e.type] || '•'}</span><div class="min-w-0"><p class="leading-relaxed">${esc(e.text)}</p><p class="text-[10px] text-slate-400">${t ? fmtDT(t) : 'الآن'}</p></div></div>`; }).join('');
  } catch (e) { const box = $('log-box'); if (box) box.innerHTML = '<p class="text-center text-xs text-rose-500 py-6">تعذر تحميل السجل' + (e.code === 'permission-denied' ? ' (انشر أحدث قواعد Firestore)' : '') + '</p>'; }
}

// نسبة الالتزام: الدورات التي سدّد فيها العضو كامل المطلوب في موعدها ÷ الدورات التي حان موعدها
function rateOf(j, pays, u) { // نسبة الالتزام بالمواعيد داخل جمعية واحدة
  if (!j.startDate) return null; const idx = monthIdx(j); if (idx < 0) return null;
  const cur = Math.min(idx, j.count - 1), turns = j.turns || [], sh = sharesOf(turns, u), now = Date.now(); let on = 0, tot = 0;
  for (let k = 0; k <= cur && k < j.count; k++) {
    const req = r2(j.amount * (sh - (turns[k] === u ? 1 : 0))); if (req <= 0) continue;
    const dueEnd = dayIn(j, k, j.lastDay).getTime() + 864e5;
    const paid = r2(pays.filter(p => p.uid === u && p.month === k && tsd(p.createdAt) && tsd(p.createdAt).getTime() <= dueEnd).reduce((t, p) => t + (Number(p.amount) || 0), 0));
    const done = paid >= req - 0.005;
    if (!done && dueEnd > now) continue; // لم يحن موعدها بعد
    tot++; if (done) on++;
  }
  return tot ? { pct: Math.round(on / tot * 100), on, tot } : null;
}
function commitRate(c, u) {
  if (!c.started) return null;
  return rateOf(c.j, state.payments, u);
}

/* ===== إحصاءات العضو عبر كل جمعياته: العدد، الإشراف، العضوية، والالتزام العام ===== */
let statsTimer = null, statsBusy = null;
const jamKey = () => state.jamiyat.map(j => j.id).sort().join(',');
const statsFresh = () => !!state.stats && Date.now() - state.stats.at < 15 * 60000 && state.stats.key === jamKey();
function schedStats(force) { clearTimeout(statsTimer); statsTimer = setTimeout(() => loadMyStats(force), 1500); }
async function loadMyStats(force) {
  if (!state.user || !state.profile) return state.stats || null;
  if (statsBusy) return statsBusy;
  if (!force && statsFresh()) return state.stats;
  statsBusy = (async () => {
    try {
      const uid = state.user.uid, key = jamKey();
      const js = state.jamiyat.filter(j => j.type !== 'family' && (j.creatorUid === uid || (j.memberUids || []).includes(uid)));
      const memJ = js.filter(j => (j.memberUids || []).includes(uid));
      state.myPays = state.myPays || {};
      await Promise.all(memJ.filter(j => j.startDate && monthIdx(j) >= 0).map(async j => {
        try { const sn = await db.collection('jamiyat').doc(j.id).collection('payments').where('uid', '==', uid).get(); state.myPays[j.id] = sn.docs.map(d => ({ id: d.id, ...d.data() })); }
        catch (e) { delete state.myPays[j.id]; } // تعذّر التحميل: لا نحسبها حتى لا تنخفض النسبة خطأً
      }));
      let on = 0, due = 0;
      memJ.forEach(j => { if (!state.myPays[j.id]) return; const r = rateOf(j, state.myPays[j.id], uid); if (r) { on += r.on; due += r.tot; } });
      const st = { n: js.length, sup: js.filter(j => j.creatorUid === uid).length, mem: memJ.length, on, due, pct: due ? Math.round(on / due * 100) : null };
      state.stats = { ...st, at: Date.now(), key }; state.statsPub = st;
      { // سجل الالتزام العام: يقرؤه من يدعوك فقط عن طريق جوالك، ويمكنك إخفاؤه من حسابك
        const rk = 'jm_relpub_' + uid, rh = JSON.stringify([1, st.pct, st.on, st.due, st.n, st.sup, st.mem]);
        if (force || lsGet(rk) !== rh) db.collection('reliability').doc(uid).set({ pct: st.pct == null ? -1 : st.pct, on: st.on, due: st.due, n: st.n, sup: st.sup, mem: st.mem, show: true, at: FV.serverTimestamp() }).then(() => lsSet(rk, rh)).catch(() => {});
      }
      const hk = 'jm_stpub_' + uid, hash = JSON.stringify(st);
      if (force || lsGet(hk) !== hash) { // ننشرها في ملف العضوية بكل جمعياته ليراها مشرفوها
        await Promise.all(memJ.map(j => db.collection('jamiyat').doc(j.id).collection('members').doc(uid).update({ st }).catch(() => {})));
        lsSet(hk, hash);
      }
      if (state.view === 'profile') render();
      return state.stats;
    } catch (e) { return state.stats || null; }
    finally { statsBusy = null; }
  })();
  return statsBusy;
}
function statsTiles(st) {
  if (!st) return '<p class="text-[11px] text-slate-400">لم تُحدَّث إحصاءات هذا العضو بعد، وتظهر بعد أن يفتح التطبيق.</p>';
  const cl = st.pct == null ? 'text-slate-500' : st.pct >= 90 ? 'text-emerald-600' : st.pct >= 70 ? 'text-amber-600' : 'text-rose-600';
  const t = (l, v, c) => `<div class="p-2.5 bg-slate-50 rounded-xl text-center"><p class="text-[10px] text-slate-500">${l}</p><b class="text-base ${c || ''}">${v}</b></div>`;
  return `<div class="grid grid-cols-2 gap-2">${t('عدد الجمعيات المشترك فيها', nf(st.n))}${t('الالتزام العام', st.pct == null ? '—' : st.pct + '%', cl)}${t('أشرف على', nf(st.sup) + ' جمعية')}${t('شارك عضواً في', nf(st.mem) + ' جمعية')}</div>${st.due ? `<p class="text-[10px] text-slate-400 mt-1.5">${nf(st.on)} من ${nf(st.due)} دفعة سُدّدت في موعدها عبر كل جمعياته</p>` : ''}`;
}
const statLine = st => st ? `<p class="text-[10px] text-slate-500">في ${nf(st.n)} ${st.n === 1 ? 'جمعية' : 'جمعيات'} • أشرف على ${nf(st.sup)} • عضو في ${nf(st.mem)} • التزام عام ${st.pct == null ? '—' : st.pct + '%'}</p>` : '';

/* ===== المشرف: دخول جمعيته كعضو أو الخروج من العضوية مع بقائه مشرفاً ===== */
function creatorJoin() {
  const c = ctx(); if (!c || c.family || !c.isCreator) return; const uid = state.user.uid, j = c.j;
  if ((j.memberUids || []).includes(uid)) return;
  if (filledOf(j) >= j.count) return toast('اكتمل عدد الأعضاء، لا يوجد مكان شاغر', 'error');
  needDetails(async () => {
    if (!confirm(c.started ? 'ستنضم كعضو ويُحسب عليك دور استلام وأقساط الدورات السابقة أيضاً. متابعة؟' : 'ستنضم كعضو في جمعيتك ويُضاف لك دور استلام وقسط. متابعة؟')) return;
    const ref = db.collection('jamiyat').doc(j.id), batch = db.batch();
    batch.update(ref, { memberUids: FV.arrayUnion(uid), turns: FV.arrayUnion(uid) });
    batch.set(ref.collection('members').doc(uid), memberDoc(uid, state.profile));
    try { await batch.commit(); toast('انضممت إلى الجمعية كعضو'); jlog(j.id, 'join', `${dispName(state.profile)} (المشرف) انضم إلى الجمعية كعضو`); schedStats(true); }
    catch (e) { toast('تعذر الانضمام: ' + e.message, 'error'); }
  });
}
async function creatorLeave() {
  const c = ctx(); if (!c || c.family || !c.isCreator) return; const uid = state.user.uid, j = c.j;
  if (!(j.memberUids || []).includes(uid)) return;
  const ac = c.acct[uid], i = c.turns.indexOf(uid);
  if (ac && ac.mine.length) return toast('لا يمكنك الخروج من العضوية وقد سجّلت دفعات', 'error');
  if (c.started && i <= c.cur) return toast('لا يمكنك الخروج بعد أن حلّ دورك في القبض', 'error');
  if (!confirm('الخروج من العضوية؟ ستبقى مشرفاً على الجمعية دون دور استلام أو أقساط، ويصبح مكانك شاغراً لعضو آخر.')) return;
  const ref = db.collection('jamiyat').doc(j.id), batch = db.batch();
  batch.update(ref, { memberUids: FV.arrayRemove(uid), turns: FV.arrayRemove(uid) });
  batch.delete(ref.collection('members').doc(uid));
  batch.delete(ref.collection('wishes').doc(uid));
  try { await batch.commit(); toast('خرجت من العضوية وبقيت مشرفاً'); jlog(j.id, 'remove', `${dispName(state.profile)} (المشرف) خرج من العضوية وبقي مشرفاً`); schedStats(true); }
  catch (e) { toast('تعذر الخروج: ' + e.message, 'error'); }
}
function rateBadge(c, u) {
  const r = commitRate(c, u); if (!r) return '<span class="text-[10px] px-1.5 py-0.5 rounded-md bg-slate-100 text-slate-500">جديد</span>';
  const cl = r.pct >= 90 ? 'bg-emerald-100 text-emerald-700' : r.pct >= 70 ? 'bg-amber-100 text-amber-700' : 'bg-rose-100 text-rose-700';
  return `<span class="text-[10px] px-1.5 py-0.5 rounded-md ${cl}" title="${r.on} من ${r.tot} دورات في الموعد">التزام ${r.pct}%</span>`;
}

function memberStatement(c, uid) {
  const a = c.acct[uid] || {};
  return { name: dispName(state.members[uid]), a, rate: commitRate(c, uid), sh: sharesOf(c.turns, uid),
    turnsOf: c.turns.map((u, k) => u === uid ? k : -1).filter(k => k >= 0),
    pays: state.payments.filter(p => p.uid === uid).sort((x, y) => (x.month - y.month) || String(x.id).localeCompare(String(y.id))) };
}
const turnState = (c, k) => !c.started ? 'قادم' : k < c.cur ? 'حلّ دورك' : k === c.cur ? 'الدور الحالي' : 'قادم';
function openMemberStatement(uid) {
  const c = ctx(); if (!c) return; uid = uid || state.user.uid;
  if (uid !== state.user.uid && !c.canManage) return;
  if (!state.members[uid]) return toast('العضو غير موجود', 'error');
  const d = memberStatement(c, uid), j = c.j, stl = p => p.status === 'confirmed' ? '<span class="text-emerald-600">مؤكدة</span>' : '<span class="text-amber-600">بانتظار التأكيد</span>';
  showModal('كشف حساب ' + esc(d.name), `<div class="space-y-3 text-xs">
    <div class="grid grid-cols-2 gap-2">${[['المستحق حتى الآن', d.a.owed], ['المؤكد', d.a.confirmed], ['بانتظار التأكيد', d.a.pending], ['المتبقي', d.a.remaining]].map(([t, v]) => `<div class="p-2.5 bg-slate-50 rounded-xl"><p class="text-[10px] text-slate-500">${t}</p><b class="text-sm">${fmtNum(v || 0)}</b> <span class="text-[10px] text-slate-400">ريال</span></div>`).join('')}</div>
    <div class="p-2.5 bg-slate-50 rounded-xl flex justify-between"><span>الأسهم: <b>${d.sh}</b></span><span>الالتزام بالمواعيد: <b>${d.rate ? d.rate.pct + '%' : '—'}</b></span></div>
    ${uid === state.user.uid || relOn() ? `<div><p class="font-bold mb-1">${uid === state.user.uid ? 'نشاطك' : 'نشاطه'} في كل الجمعيات</p>${statsTiles(uid === state.user.uid && state.stats ? state.stats : (state.members[uid] || {}).st)}</div>` : ''}
