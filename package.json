  box.innerHTML = Array.from({ length: cfg.len }, (_, i) => `<span style="width:14px;height:14px;border-radius:50%;border:2px solid #94a3b8;background:${i < lockBuf.length ? '#fff' : 'transparent'}"></span>`).join('');
}
