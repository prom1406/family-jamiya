.ap-panel{display:flex;flex-direction:column;gap:1rem;animation:apIn .35s cubic-bezier(.2,.8,.2,1)}
@keyframes apIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.ap-form{display:flex;flex-direction:column;gap:1rem}
.ap-card{background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:1rem;box-shadow:0 1px 2px rgba(15,23,42,.04),0 10px 26px -20px rgba(15,23,42,.25);display:flex;flex-direction:column;gap:.8rem}
