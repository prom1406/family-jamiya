    <textarea name="annText" rows="2" class="inp" maxlength="300" placeholder="نص الإعلان (يظهر أعلى الصفحة لكل مستخدم مسجّل)">${esc(s.annText || '')}</textarea>
    <div class="flex flex-wrap gap-3 items-center"><select name="annType" class="inp !w-auto"><option value="info" ${s.annType === 'info' ? 'selected' : ''}>معلومة</option><option value="warn" ${s.annType === 'warn' ? 'selected' : ''}>تنبيه</option><option value="ok" ${s.annType === 'ok' ? 'selected' : ''}>خبر سار</option></select>${sw('annActive', s.annActive, 'تفعيل الإعلان')}</div>
    <hr class="border-slate-100"><h4 class="font-black text-sm"><i class="fa-solid fa-screwdriver-wrench text-amber-600"></i> وضع الصيانة</h4>
    ${sw('maintenance', s.maintenance, 'إيقاف المنصة مؤقتاً لكل المستخدمين (المشرفون لا يتأثرون)')}
    <input name="maintMsg" class="inp" maxlength="200" value="${esc(s.maintMsg || '')}" placeholder="رسالة الصيانة (اختياري)">
    <hr class="border-slate-100"><h4 class="font-black text-sm"><i class="fa-solid fa-gauge-high text-emerald-600"></i> سجل التزام الأعضاء</h4>
    ${sw('relOn', s.relOn !== false, 'إظهار سجل التزام العضو (نسبة الالتزام وعدد الجمعيات) للمشرف عند دعوته وفي قائمة أعضاء جمعيته. أوقفه لإخفائه عن الجميع.')}
    <hr class="border-slate-100"><h4 class="font-black text-sm"><i class="fa-solid fa-user-lock text-rose-600"></i> التسجيل الجديد</h4>
    ${sw('regClosed', s.regClosed, 'إيقاف تسجيل الحسابات الجديدة')}
    <input name="regMsg" class="inp" maxlength="200" value="${esc(s.regMsg || '')}" placeholder="رسالة تظهر لمن يحاول التسجيل (اختياري)">
    <button class="btn b-pri w-full py-3" type="submit"><i class="fa-solid fa-floppy-disk"></i> حفظ الإعدادات</button></form>
  <div class="card p-5 space-y-3"><h4 class="font-black text-sm"><i class="fa-solid fa-bullhorn text-teal-600"></i> إشعار مخصص للأعضاء</h4>
    <form id="f-adm-bc" class="space-y-3"><select name="target" class="inp"><option value="all">كل المستخدمين</option>${A.jamiyat.map(j => `<option value="${esc(j.id)}">أعضاء جمعية: ${esc(j.name)}</option>`).join('')}</select>
    <input name="title" class="inp" maxlength="100" placeholder="عنوان الإشعار" required><textarea name="body" rows="3" class="inp" maxlength="500" placeholder="نص الإشعار…" required></textarea>
    <button class="btn b-pri w-full py-3" type="submit"><i class="fa-solid fa-paper-plane"></i> إرسال الإشعار</button></form></div>
  <div class="card p-5 space-y-3"><h4 class="font-black text-sm"><i class="fa-solid fa-user-shield text-violet-600"></i> المشرفون</h4>
    <div class="space-y-1.5">${adm.map(a => `<div class="p-2.5 bg-slate-50 rounded-xl text-xs flex justify-between items-center gap-2"><span><b>${esc(a.name)}</b> <span class="text-slate-500" dir="ltr">${esc(a.email)}</span></span>${owner ? `<button class="btn b-red" data-act="adm-admin-del" data-id="${esc(a.id)}">إزالة</button>` : ''}</div>`).join('') || '<p class="text-xs text-slate-400">لا يوجد مشرفون إضافيون (المالك يملك الصلاحية دائماً).</p>'}</div>
    ${owner ? `<form id="f-adm-addadmin" class="flex gap-2"><input name="email" type="email" dir="ltr" class="inp flex-1" placeholder="بريد مستخدم مسجّل لمنحه صلاحية المشرف" required><button class="btn b-pri" type="submit">إضافة</button></form>` : '<p class="text-[11px] text-slate-400">إدارة المشرفين للمالك فقط.</p>'}</div>
  <div class="card p-5 space-y-3"><h4 class="font-black text-sm"><i class="fa-solid fa-toolbox text-slate-600"></i> أدوات</h4>
    <div class="flex flex-wrap gap-2"><button class="btn b-pri" data-act="test-mail"><i class="fa-solid fa-envelope"></i> اختبار البريد</button><button class="btn b-sec" data-act="adm-export"><i class="fa-solid fa-file-csv"></i> تصدير المستخدمين CSV</button></div></div>
  <details class="card p-5"><summary class="font-black text-sm cursor-pointer"><i class="fa-solid fa-shield-halved text-teal-600"></i> قواعد Firestore المطلوبة لهذه اللوحة</summary>
    <p class="text-[11px] text-slate-500 my-3 leading-relaxed">بدون هذه القواعد لن تُحفظ الإحصاءات ولن تعمل الملاحظات والحظر. انسخها وأضِفها لقواعدك الحالية ثم اضغط Publish.</p>
    <pre class="text-[11px] bg-slate-900 text-emerald-200 rounded-xl p-3 overflow-x-auto leading-relaxed" dir="ltr" style="text-align:left">${esc(ADMIN_RULES)}</pre><button class="btn b-sec mt-3" data-act="adm-copy-rules"><i class="fa-solid fa-copy"></i> نسخ القواعد</button></details>`;
