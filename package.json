.ap-stat span{display:block;font-size:.66rem;opacity:.85;margin-top:2px}
.ap-prog{margin-top:1rem}
.ap-prog-h{display:flex;justify-content:space-between;font-size:.72rem;margin-bottom:.4rem;opacity:.92}
.ap-bar{height:6px;border-radius:99px;background:rgba(255,255,255,.22);overflow:hidden}
