// أنواع الدورات: الشهرية على أساس الأشهر الميلادية، والبقية على أساس عدد ثابت من الأيام
const FREQS = {
  monthly:  { label: 'شهرية',        every: 'شهرياً',        days: 0,  unit: 'شهر' },
  tenday:   { label: 'كل 10 أيام',   every: 'كل 10 أيام',    days: 10, unit: 'دورة' },
  biweekly: { label: 'كل أسبوعين',   every: 'كل أسبوعين',    days: 14, unit: 'دورة' },
  weekly:   { label: 'أسبوعية',      every: 'أسبوعياً',      days: 7,  unit: 'أسبوع' }
};
const freqOf = j => FREQS[j && j.frequency] || FREQS.monthly;
const maxDayOf = j => freqOf(j).days || 31;
const DAY_MS = 86400000;
function monthIdx(j) { // رقم الدورة الحالية (سالب = لم تبدأ)
  const f = freqOf(j), s = new Date(j.startDate + 'T00:00:00'), n = new Date();
  if (!f.days) return (n.getFullYear() - s.getFullYear()) * 12 + n.getMonth() - s.getMonth();
  const today = new Date(n.getFullYear(), n.getMonth(), n.getDate());
  return Math.floor(Math.round((today - s) / DAY_MS) / f.days);
}
function periodStart(j, idx) {
  const f = freqOf(j), s = new Date(j.startDate + 'T00:00:00');
  if (!f.days) return new Date(s.getFullYear(), s.getMonth() + idx, 1);
  return new Date(s.getFullYear(), s.getMonth(), s.getDate() + idx * f.days);
}
// يوم محدد داخل الدورة: للشهرية رقم اليوم من الشهر، ولغيرها رقم اليوم منذ بداية الدورة (1 = أول يوم)
function dayIn(j, idx, day) {
  const f = freqOf(j), first = periodStart(j, idx);
  if (!f.days) {
    const last = new Date(first.getFullYear(), first.getMonth() + 1, 0).getDate();
    return new Date(first.getFullYear(), first.getMonth(), Math.min(day, last));
  }
  return new Date(first.getFullYear(), first.getMonth(), first.getDate() + Math.min(day, f.days) - 1);
}
function periodLabel(j, idx) {
  const f = freqOf(j);
  if (!f.days) return fmtMonth(periodStart(j, idx));
  const a = periodStart(j, idx), b = new Date(a.getFullYear(), a.getMonth(), a.getDate() + f.days - 1);
  const o = { day: 'numeric', month: 'long' };
  return `${a.toLocaleDateString(LOCD(), o)} – ${b.toLocaleDateString(LOCD(), o)}`;
}
const dayStart = d => new Date(d.getFullYear(), d.getMonth(), d.getDate());
function periodEnd(j, idx) { const n = periodStart(j, idx + 1); return new Date(n.getFullYear(), n.getMonth(), n.getDate() - 1); } // آخر يوم في الدورة
const daysAr = n => n === 1 ? 'يوم واحد' : n === 2 ? 'يومان' : n >= 3 && n <= 10 ? n + ' أيام' : n + ' يوماً';
const r2 = n => Math.round(n * 100) / 100;
const fmtNum = n => Number(r2(n)).toLocaleString(LOCN(), { maximumFractionDigits: 2 });

// حساب العضو التراكمي: كل ما دفعه يُقسَّم على قيمة القسط الحالية.
// المستحق = (عدد الدورات حتى الآن ما عدا دور استلامه) × القسط. الزائد رصيد مقدّم يغطي الدفعات القادمة.
function accountFor(j, turns, cur, started, payments, uid, amount = j.amount) {
  const sh = Math.max(1, turns.filter(x => x === uid).length); // عدد أسهمه: كل سهم له دور
  let n = 0; if (started) for (let k = 0; k <= cur; k++) n += sh - (turns[k] === uid ? 1 : 0);
  const owed = r2(n * amount);
  let confirmed = 0, pending = 0;
  payments.forEach(p => { if (p.uid !== uid) return; if (p.status === 'confirmed') confirmed += Number(p.amount) || 0; else pending += Number(p.amount) || 0; });
  confirmed = r2(confirmed); pending = r2(pending);
  const paid = r2(confirmed + pending), eps = 0.005;
  const remaining = r2(Math.max(0, owed - paid));
  const credit = r2(Math.max(0, paid - owed));
  let status = 'wait';
  if (started) status = confirmed >= owed - eps ? 'confirmed' : paid >= owed - eps ? 'pending' : paid > 0 ? 'partial' : 'unpaid';
  return { n, owed, confirmed, pending, paid, remaining, credit, status, covers: amount > 0 ? r2(paid / amount) : 0, mine: payments.filter(p => p.uid === uid) };
}
// بطاقة الجمعية الرئيسية: «لم تبدأ بعد» أو الدورة الحالية وعدد الأيام المتبقية فيها
