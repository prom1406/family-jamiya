    if (!(day >= 1 && day <= 28)) return toast('يوم السداد من 1 إلى 28', 'error');
    if (fx && !(fixed >= 1)) return toast('قيمة الاشتراك الشهري غير صحيحة', 'error');
    doc.targetAmount = target; doc.monthlyDay = day; doc.famStart = isoDay(new Date()); if (fixed) doc.monthlyAmount = fixed;
  } else {
    const endDate = f.endDate.value, tv = f.target.value.trim(), target = tv ? parseFloat(tv) : 0;
    if (!endDate) return toast('حدد تاريخ نهاية التعاون', 'error');
    if (endDate < isoDay(new Date())) return toast('تاريخ النهاية يجب ألا يكون في الماضي', 'error');
    if (tv && !(target >= 1)) return toast('المبلغ المستهدف غير صحيح', 'error');
    doc.endDate = endDate; doc.endAt = firebase.firestore.Timestamp.fromDate(new Date(endDate + 'T23:59:59')); if (target) doc.targetAmount = target;
  }
