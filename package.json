function tabWa() {
  const A = state.admin;
  return `<div class="card p-5 space-y-3"><h4 class="font-black text-sm"><i class="fa-brands fa-whatsapp text-emerald-600"></i> رسالة واتساب لجميع المستخدمين</h4>
