    if (uid) sendNotifs([uid], 'تم تعيينك نائباً للمشرف', `في جمعية «${c.j.name}»: يمكنك دعوة الأعضاء وتذكيرهم بالسداد`, c.j.id, 'member');
  } catch (e) { toast(e.message, 'error'); }
}
async function handleInvite(f) {
  const c = ctx(); const name = f.name.value.trim(), phone = normPhone(f.phone.value), email = lc(f.email.value);
  if (name.length < 2) return toast('اكتب اسم العضو', 'error');
  if (!validPhone(phone)) return toast('رقم الجوال يجب أن يبدأ بـ 05 ويتكون من 10 أرقام', 'error');
  if (email && !validEmail(email)) return toast('البريد غير صحيح', 'error');
  if (Object.values(state.members).some(m => normPhone(m.phone) === phone || (email && lc(m.email) === email))) return toast('هذا الشخص عضو بالفعل', 'error');
  if (state.jInvites.some(i => i.status === 'pending' && (normPhone(i.phone) === phone || (email && lc(i.email) === email)))) return toast('توجد دعوة معلّقة لنفس الرقم أو البريد، أعد إرسالها من قائمة الدعوات', 'error');
  const pending = state.jInvites.filter(i => i.status === 'pending').length;
  if (filledOf(c.j) >= c.j.count) return toast('اكتمل عدد الأعضاء. احذف أحد الأعضاء أولاً لتتمكن من إضافة عضو جديد', 'error');
  if (filledOf(c.j) + pending >= c.j.count) return toast('عدد الأعضاء والدعوات المعلّقة وصل للحد. ألغِ دعوة معلّقة أو احذف عضواً', 'error');
  const id = `${c.j.id}__p${phone}`;
  const inv = { jamiyaId: c.j.id, jamiyaName: c.j.name, amount: c.j.amount, every: freqOf(c.j).every, family: c.j.type === 'family', email, phone, name,
    invitedBy: state.user.uid, inviterName: dispName(state.profile), creatorUid: c.j.creatorUid, status: 'pending' };
  try {
    const b = db.batch(); b.set(db.collection('invites').doc(id), { ...inv, createdAt: FV.serverTimestamp() });
    if (inv.family && c.isCreator && !Object.values(state.guests || {}).some(g => g.inviteId === id)) b.set(jref().collection('guests').doc(newGid()), { name, inviteId: id, linked: '', createdAt: FV.serverTimestamp() }); // المدعو يظهر مشاركاً فوراً
    await b.commit();
    closeModal(); showInviteShare({ ...inv, id }, true);
