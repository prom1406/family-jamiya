/* --- مكونات العرض --- */
function kpi(label, value, icon, tone = 'text-slate-900', sub = '') {
  return `<div class="card p-4"><div class="flex justify-between items-start"><p class="text-xs text-slate-500">${label}</p><i class="fa-solid ${icon} text-slate-300"></i></div><h3 class="text-2xl font-black mt-1 ${tone}">${value}</h3>${sub ? `<p class="text-[11px] mt-0.5">${sub}</p>` : ''}</div>`;
}
const delta = (cur, prev) => !prev ? '' : (() => { const p = Math.round((cur - prev) / prev * 100); return `<span class="${p >= 0 ? 'text-emerald-600' : 'text-rose-600'} font-bold">${p >= 0 ? '▲' : '▼'} ${nf(Math.abs(p))}٪ عن الفترة السابقة</span>`; })();
function barChart(labels, vals, every = 1, tips) {
  const mx = Math.max(1, ...vals), showV = vals.length <= 16;
  return `<div class="flex items-end gap-[3px]" dir="ltr" style="height:150px">${vals.map((v, i) => `<div class="flex-1 min-w-0 h-full flex flex-col justify-end items-center" title="${esc(tips ? tips[i] : labels[i])}: ${nf(v)}">${showV ? `<span class="text-[9px] text-slate-500 mb-0.5">${v ? nf(v) : ''}</span>` : ''}<div class="bar ${v ? '' : 'z'} w-full" style="height:${v ? Math.max(Math.round(v / mx * 100), 3) : 2}%"></div></div>`).join('')}</div>
  <div class="flex gap-[3px] mt-1" dir="ltr">${labels.map((l, i) => `<span class="flex-1 min-w-0 text-center text-[9px] text-slate-400 ${i % every ? 'invisible' : ''}">${l}</span>`).join('')}</div>`;
}
function breakdown(title, icon, map, label = k => k) {
  const rows = Object.entries(map).filter(([, v]) => v > 0).sort((a, b) => b[1] - a[1]).slice(0, 8), tot = rows.reduce((s, [, v]) => s + v, 0);
  return `<div class="card p-5"><h4 class="font-black text-sm mb-3"><i class="fa-solid ${icon} text-teal-600"></i> ${title}</h4><div class="space-y-2.5">${rows.map(([k, v]) => `<div><div class="flex justify-between text-[11px] mb-1"><span class="font-bold">${esc(label(k))}</span><span class="text-slate-500">${nf(v)} • ${nf(Math.round(v / tot * 100))}٪</span></div><div class="hbar"><i style="width:${Math.round(v / tot * 100)}%"></i></div></div>`).join('') || '<p class="text-xs text-slate-400">لا توجد بيانات بعد.</p>'}</div></div>`;
}
function dayKeys(n, off = 0) { const a = []; for (let i = n - 1 + off; i >= off; i--) a.push(dayKey(Date.now() - i * 86400000)); return a; }
const sumF = (keys, f) => keys.reduce((s, k) => s + ((state.admin.stats[k] || {})[f] || 0), 0);
