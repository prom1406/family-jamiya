function lockForgot(auto) {
  if (!auto && !confirm('سيتم تسجيل خروجك وإلغاء القفل على هذا الجهاز، ثم تدخل بكلمة المرور وتفعّل قفلاً جديداً. متابعة؟')) return;
  try { localStorage.removeItem(lockKey()); } catch (e) {}
