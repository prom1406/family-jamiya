/* ============ إشعارات النظام (تظهر خارج التطبيق على الجوال) ============ */
/* داخل تطبيق iOS: إشعارات آبل (APNs عبر FCM) بإضافة FirebaseMessaging الأصلية؛ في المتصفح: Web Push كما كان. */
const NP = () => window.Capacitor && Capacitor.Plugins && Capacitor.Plugins.FirebaseMessaging;
const nativePerm = () => state._nperm || 'prompt'; // granted | denied | prompt
const notifSupported = () => IS_NATIVE || 'Notification' in window;
const notifOn = () => IS_NATIVE ? (nativePerm() === 'granted' && lsGet('jm_notif') !== '0') : (notifSupported() && Notification.permission === 'granted' && lsGet('jm_notif') !== '0');
const notifCanAsk = () => IS_NATIVE ? nativePerm() === 'prompt' : (notifSupported() && Notification.permission === 'default' && (!isIOS() || isStandalone()));
const notifDenied = () => IS_NATIVE ? nativePerm() === 'denied' : (notifSupported() && Notification.permission === 'denied');
async function showSysNotif(title, body, tag, jid) {
  if (IS_NATIVE) return; // الإشعارات تصل من آبل (الخادم) حتى والتطبيق مغلق
  const opts = { body, tag, icon: 'icon-192.png', badge: 'icon-192.png', lang: 'ar', dir: 'rtl', data: { jid: jid || '', url: location.pathname } };
  try { const reg = await navigator.serviceWorker.getRegistration(); if (reg) return await reg.showNotification(title, opts); } catch (e) {}
  try { new Notification(title, opts); } catch (e) {}
}
// تُعرض فقط والتطبيق في الخلفية (داخل التطبيق تكفي الرسائل)، ولا تتكرر لنفس الحدث
const seenKey = () => 'jm_nseen_' + (state.user ? state.user.uid : '');
function pushLocal(title, body, tag, jid) {
  if (!notifOn()) return;
  let seen = []; try { seen = JSON.parse(lsGet(seenKey()) || '[]'); } catch (e) {}
  if (seen.includes(tag)) return;
  if (document.visibilityState === 'hidden') { showSysNotif(title, body, tag, jid); }
  else if (document.visibilityState === 'visible' && !String(tag).startsWith('al_')) { /* مرئي: نسجله كمُشاهَد */ }
  else return; // تنبيهات المواعيد تنتظر حتى يصبح التطبيق في الخلفية
  seen.push(tag); lsSet(seenKey(), JSON.stringify(seen.slice(-300)));
}
// فتح من أيقونة تطبيق مثبّت (أندرويد) لكن الصفحة خارج نطاقه: يحدث لمن ثبّت التطبيق على الدومين القديم
const fromStaleApp = () => !isStandalone() && /^android-app:/.test(document.referrer || '');
const NEW_HOST = new URL(APP_URL).hostname;
