const dayKey = (t = Date.now()) => new Date(t + 3 * 3600000).toISOString().slice(0, 10); // بتوقيت الرياض
const tsd = v => !v ? null : (v.toDate ? v.toDate() : new Date(v));
const nf = n => Number(n || 0).toLocaleString(LOCN());
const fmtDT = d => d ? fmtDate(d) + ' ' + d.toLocaleTimeString(LOCN(), { hour: '2-digit', minute: '2-digit' }) : '—';
const ssGet = k => { try { return sessionStorage.getItem(k); } catch (e) { return null; } };
const ssSet = (k, v) => { try { sessionStorage.setItem(k, v); } catch (e) {} };
const ssDel = k => { try { sessionStorage.removeItem(k); } catch (e) {} };
const lsGet = k => { try { return localStorage.getItem(k); } catch (e) { return null; } };
const lsSet = (k, v) => { try { localStorage.setItem(k, v); } catch (e) {} };
const fkey = s => String(s).replace(/[.\/~*\[\]`\s]/g, '_').slice(0, 30) || '_';
function ago(d) {
  if (!d) return 'لم يُسجَّل';
  const s = Math.max(0, (Date.now() - d.getTime()) / 1000);
  if (s < 90) return 'الآن';
  if (s < 3600) return 'قبل ' + nf(Math.round(s / 60)) + ' دقيقة';
  if (s < 86400) return 'قبل ' + nf(Math.round(s / 3600)) + ' ساعة';
  if (s < 86400 * 30) return 'قبل ' + nf(Math.round(s / 86400)) + ' يوم';
  return 'قبل ' + nf(Math.round(s / 86400 / 30)) + ' شهر';
}
