    <div class="flex gap-2">${opts ? '<button class="btn b-pri flex-1 py-3" type="submit">حفظ</button>' : ''}${c.j.deputyUid ? '<button class="btn b-red py-3" type="button" data-act="deputy-clear">إلغاء النيابة</button>' : ''}</div></form>`);
