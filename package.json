/* ---- حذف الحساب من داخل التطبيق (شرط App Store 5.1.1(v)) ----
   يحذف ملفه الشخصي وحجز رقم جواله ثم حساب Firebase. ما يخص الجمعيات المشتركة مع آخرين يبقى للمشرفين.
   ملاحظة: إبطال رمز Apple (revoke) يحتاج خادماً/Cloud Function، انظر README-IOS.md. */
async function deleteMyAccount() {
  const u = auth.currentUser; if (!u) return;
  if (!confirm('سيُحذف حسابك وبياناتك الشخصية نهائياً ولا يمكن التراجع عن ذلك. هل أنت متأكد؟')) return;
  const typed = prompt('للتأكيد اكتب كلمة: حذف');
  if (typed === null || typed.trim() !== 'حذف') return toast('لم يتم حذف الحساب', 'info');
  try {
    // إعادة التحقق من الهوية (يطلبها Firebase قبل الحذف)
    const ids = (u.providerData || []).map(p => p && p.providerId);
    if (ids.includes('apple.com') && IS_NATIVE_IOS) {
      await u.reauthenticateWithCredential(await appleNativeCredential());
    } else if (ids.includes('google.com')) {
      if (IS_NATIVE) await u.reauthenticateWithCredential(await googleNativeCredential());
      else await u.reauthenticateWithPopup(new firebase.auth.GoogleAuthProvider());
    } else if (ids.includes('password') && u.email) {
      const pw = prompt('اكتب كلمة المرور للتأكيد'); if (!pw) return;
      await u.reauthenticateWithCredential(firebase.auth.EmailAuthProvider.credential(u.email, pw));
    }
    const ph = state.profile && state.profile.phone;
    await Promise.race([unregisterPush(), new Promise(r => setTimeout(r, 3000))]).catch(() => {});
    await db.collection('users').doc(u.uid).delete().catch(() => {});
    if (ph) await db.collection('phones').doc(ph).delete().catch(() => {});
    await u.delete();
    toast('تم حذف حسابك نهائياً', 'success');
  } catch (e) {
    if (e && e.code === 'auth/requires-recent-login') return toast('لأمانك: سجّل الخروج ثم الدخول مجدداً ثم أعد المحاولة', 'error');
    if (/cancel|1001|dismiss/i.test(String((e && (e.message || e.code)) || ''))) return;
    toast('تعذر حذف الحساب: ' + ((e && e.message) || e), 'error');
  }
}
