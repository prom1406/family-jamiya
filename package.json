/* --- التتبع (يعمل عند المستخدمين العاديين) --- */
function devInfo() {
  const ua = navigator.userAgent;
  const os = /android/i.test(ua) ? 'Android' : isIOS() ? 'iOS' : /windows/i.test(ua) ? 'Windows' : /mac/i.test(ua) ? 'Mac' : /linux/i.test(ua) ? 'Linux' : 'أخرى';
  const br = /edg/i.test(ua) ? 'Edge' : /samsungbrowser/i.test(ua) ? 'Samsung' : /opr|opera/i.test(ua) ? 'Opera' : /firefox|fxios/i.test(ua) ? 'Firefox' : /chrome|crios/i.test(ua) ? 'Chrome' : /safari/i.test(ua) ? 'Safari' : 'أخرى';
  const dev = /ipad|tablet/i.test(ua) ? 'tablet' : /mobi|android|iphone|ipod/i.test(ua) ? 'mobile' : 'desktop';
  return { os, br, dev, pwa: isStandalone() };
}
function trafficSource() {
  try {
    const q = new URLSearchParams(location.search), u = q.get('utm_source') || q.get('src') || q.get('ref');
    if (u) return u.slice(0, 20);
    if (document.referrer) { const h = new URL(document.referrer).hostname.replace(/^www\./, ''); if (h && h !== location.hostname) return h; }
  } catch (e) {}
  return 'مباشر';
}
// الإحصاءات تُجمَّع في الذاكرة وتُكتب دفعة واحدة كل 30 ثانية (بدل كتابة لكل نقرة)
let statBuf = {}, statTimer = null;
const mergeSpec = (t, sp) => { Object.entries(sp).forEach(([k, v]) => { if (v && typeof v === 'object') mergeSpec(t[k] = t[k] || {}, v); else t[k] = (t[k] || 0) + v; }); return t; };
function incStat(spec) { mergeSpec(statBuf, spec); if (!statTimer) statTimer = setTimeout(flushStats, 30000); return Promise.resolve(); }
function flushStats() {
  clearTimeout(statTimer); statTimer = null;
  const spec = statBuf; statBuf = {}; if (!Object.keys(spec).length) return Promise.resolve();
  const conv = o => Object.fromEntries(Object.entries(o).map(([k, v]) => [k, v && typeof v === 'object' ? conv(v) : FV.increment(v)]));
  const d = dayKey();
  return db.collection('stats').doc(d).set({ day: d, ...conv(spec) }, { merge: true }).catch(() => {});
}
document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') flushStats(); });
window.addEventListener('pagehide', flushStats);
function logEvent(type, extra = {}) {
  const u = auth.currentUser; if (!u) return Promise.resolve();
  return db.collection('events').add({ type, uid: u.uid, email: lc(u.email), name: (state.profile && state.profile.name) || u.displayName || '', ts: FV.serverTimestamp(), ...extra }).catch(() => {});
}
function trackVisit() { // زيارة واحدة لكل جلسة متصفح، حتى قبل تسجيل الدخول
  if (ssGet('jm_visit')) return; ssSet('jm_visit', '1');
  const d = devInfo();
  incStat({ visits: 1, dev: { [d.dev]: 1 }, os: { [fkey(d.os)]: 1 }, br: { [fkey(d.br)]: 1 }, src: { [fkey(trafficSource())]: 1 }, hours: { [new Date().getHours()]: 1 }, ...(d.pwa ? { pwa: 1 } : {}) });
}
function trackView(v) {
  if (!state.user || !state.profile || state.isAdmin || v === 'loading' || state._tv === v) return;
  state._tv = v; incStat({ pv: 1, views: { [v]: 1 } });
}
let hbTimer = null, lastBeat = 0;
