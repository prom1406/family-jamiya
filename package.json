    logEvent('adm_admin', { target: uid, targetName: u.name, info: on ? 'منح' : 'سحب' }); toast('تم التحديث'); reopenTarget(uid);
  } catch (e) { toast('تعذر التنفيذ: ' + e.message, 'error'); }
}
async function addAdminByEmail(f) {
