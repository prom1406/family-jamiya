  showModal(mode === 'off' ? 'إيقاف قفل التطبيق' : mode === 'change' ? 'تغيير رمز القفل' : 'تفعيل قفل التطبيق', `<form id="${mode === 'off' ? 'f-lockoff' : 'f-lock'}" class="space-y-3">
    ${need ? '<div><label class="text-xs font-semibold block mb-1">الرمز الحالي</label><input name="cur" type="password" inputmode="numeric" maxlength="6" class="inp" required autocomplete="off"></div>' : ''}
    ${mode === 'off' ? '' : '<div><label class="text-xs font-semibold block mb-1">الرمز الجديد (4 إلى 6 أرقام)</label><input name="pin" type="password" inputmode="numeric" pattern="[0-9]{4,6}" maxlength="6" class="inp" required autocomplete="off"></div><div><label class="text-xs font-semibold block mb-1">أعد كتابة الرمز</label><input name="pin2" type="password" inputmode="numeric" maxlength="6" class="inp" required autocomplete="off"></div><p class="text-[11px] text-slate-500 leading-relaxed">القفل يحمي التطبيق على هذا الجهاز فقط، وهو حماية من الفضول وليس بديلاً عن قفل الجوال.</p>'}
