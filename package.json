    if (Object.keys(upd).length) await ref.update(upd).catch(() => {});
    closeModal(); toast('سُجّلت مساهمتك'); jlog(j.id, 'pay', `${dispName(state.profile)} سجّل مساهمة شخصية بمبلغ ${fmtNum(amount)} ريال`);
