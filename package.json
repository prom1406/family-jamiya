/* ===== مميزات النمو: اقتراح إنشاء جمعية، طلب تقييم، شارة المنظّم ===== */
const GK = { create: 'jm_g_create', review: 'jm_g_review', twa: 'jm_twa' };
const PLAY_URL = 'https://play.google.com/store/apps/details?id=com.aljamiya.app';
try { if ((document.referrer || '').indexOf('android-app://') === 0) localStorage.setItem(GK.twa, '1'); } catch (e) {}
const isTwa = () => lsGet(GK.twa) === '1';
const gDismissed = (k, days) => { const t = Number(lsGet(k) || 0); return !!t && (days === 0 || Date.now() - t < days * 86400000); };
const trustedOrganizer = () => state.jamiyat.some(j => j.creatorUid === state.user.uid && j.closed === true && j.hasConfirmed === true);
function growthCards() {
  if (!state.user || state.isAdmin) return '';
  const confirmedAsMember = state.jamiyat.filter(j => j.creatorUid !== state.user.uid && j.hasConfirmed);
  const owns = state.jamiyat.some(j => j.creatorUid === state.user.uid);
  let h = '';
  if (trustedOrganizer()) h += `<div class="p-3 rounded-2xl bg-amber-50 border border-amber-200 text-xs flex items-center gap-2"><i class="fa-solid fa-award text-amber-500 text-lg"></i><span><b>منظّم موثوق</b> — أتممت جمعية كاملة بنجاح، جزاك الله خيراً.</span></div>`;
  if (confirmedAsMember.length && !owns && !gDismissed(GK.create, 7)) h += `<div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-100 text-xs space-y-2">
    <p class="font-black text-sm text-emerald-900"><i class="fa-solid fa-wand-magic-sparkles"></i> جرّبت التطبيق كعضو، فما رأيك أن تدير جمعيتك الخاصة؟</p>
    <p class="text-slate-600 leading-relaxed">أنشئ جمعية لعائلتك أو زملائك في دقيقتين، وأرسل الدعوات بالواتساب، وتابع السداد والتذكيرات من مكان واحد.</p>
    <div class="flex gap-2"><button class="btn b-pri" data-act="growth-create">أنشئ جمعيتي</button><button class="btn b-sec" data-act="growth-dismiss" data-k="create">لاحقاً</button></div></div>`;
  if (isTwa() && state.jamiyat.some(j => j.hasConfirmed) && !gDismissed(GK.review, 0)) h += `<div class="p-4 rounded-2xl bg-sky-50 border border-sky-100 text-xs space-y-2">
    <p class="font-black text-sm text-sky-900"><i class="fa-solid fa-star"></i> هل أعجبك التطبيق؟</p>
    <p class="text-slate-600 leading-relaxed">تقييمك على Google Play يساعد غيرك على اكتشافه، ويستغرق نصف دقيقة.</p>
    <div class="flex gap-2"><a class="btn b-pri" data-act="growth-review" target="_blank" rel="noopener" href="${PLAY_URL}">قيّم التطبيق</a><button class="btn b-sec" data-act="growth-dismiss" data-k="review">لا، شكراً</button></div></div>`;
  return h ? `<div class="space-y-2">${h}</div>` : '';
}

const relOn = () => (state.settings || {}).relOn !== false; // مفتاح المالك لإظهار سجل الالتزام للمشرفين
const staffJams = () => state.jamiyat.filter(j => j.type !== 'family' && (j.creatorUid === state.user.uid || (j.deputyUid && j.deputyUid === state.user.uid)));
function followData() {
  const me = state.user.uid, now = Date.now(), people = {}; let running = 0, notStarted = 0, finished = 0, waiting = 0;
  staffJams().forEach(j => {
    if (!j.startDate) return; const idx = monthIdx(j);
    if (idx < 0) { notStarted++; return; } if (idx >= j.count) { finished++; return; }
    const pays = state.pays[j.id]; if (!pays) { waiting++; return; } running++;
    const turns = j.turns || [], cur = idx, mem = (state.fMem || {})[j.id] || {}, due = dayIn(j, cur, j.lastDay), dueEnd = due.getTime() + DAY_MS;
    [...new Set(turns)].forEach(u => {
      if (u === me) return;
      const a = accountFor(j, turns, cur, true, pays, u), r = rateOf(j, pays, u);
      const pp = people[u] = people[u] || { uid: u, name: '', phone: '', rows: [], total: 0, late: false, on: 0, due: 0 };
      const m = mem[u]; if (m) { pp.name = pp.name || dispName(m); if (m.phone && (j.creatorUid === me || m.showPhone)) pp.phone = pp.phone || m.phone; }
      if (r) { pp.on += r.on; pp.due += r.tot; }
      if (!(a.remaining > 0.005) || (u === turns[cur] && sharesOf(turns, u) === 1)) return;
      const prev = cur > 0 ? accountFor(j, turns, cur - 1, true, pays, u) : null;
      const late = dueEnd < now || !!(prev && ['unpaid', 'partial'].includes(prev.status));
      pp.rows.push({ j, remaining: a.remaining, late, lateDays: dueEnd < now ? Math.floor((now - dueEnd) / DAY_MS) + 1 : 0, due, pend: a.pending });
      pp.total = r2(pp.total + a.remaining); if (late) pp.late = true;
    });
  });
  const list = Object.values(people).filter(x => x.rows.length).sort((a, b) => (b.late - a.late) || (b.total - a.total));
  return { list, running, notStarted, finished, waiting, total: r2(list.reduce((t, x) => t + x.total, 0)), nLate: list.filter(x => x.late).length, nOk: Object.values(people).filter(x => !x.rows.length).length };
}
