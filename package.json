/* --- نوافذ المستخدم والجمعية --- */
const admWa = p => { const d = normPhone(p); return validPhone(d) ? 'https://wa.me/966' + d.slice(1) : ''; };
const cell = (l, v) => `<div class="p-2.5 bg-slate-50 rounded-xl"><p class="text-[10px] text-slate-400">${l}</p><p class="font-bold text-[12px] break-words">${v}</p></div>`;
function notesBlock(t) {
  const n = state.admin.notes[t] || { items: [], flag: '' };
  return `<div class="space-y-2"><h4 class="font-black text-sm"><i class="fa-solid fa-note-sticky text-amber-500"></i> ملاحظات الإدارة <span class="text-[10px] text-slate-400 font-normal">(لا يراها المستخدم)</span></h4>
    <select class="inp" data-adm-flag data-t="${esc(t)}">${Object.entries(FLAGS).map(([k, v]) => `<option value="${k}" ${k === (n.flag || '') ? 'selected' : ''}>${v[0]}</option>`).join('')}</select>
    <div class="space-y-1.5">${[...(n.items || [])].reverse().map(i => `<div class="p-2.5 bg-amber-50 border border-amber-100 rounded-xl text-[12px] flex justify-between gap-2"><div class="min-w-0"><p class="whitespace-pre-wrap break-words">${esc(i.text)}</p><p class="text-[10px] text-slate-400 mt-1">${fmtDT(new Date(i.ts))}</p></div><button class="text-rose-500 flex-none" data-act="adm-note-del" data-t="${esc(t)}" data-id="${esc(i.id)}" aria-label="حذف"><i class="fa-solid fa-trash-can"></i></button></div>`).join('') || '<p class="text-[11px] text-slate-400">لا توجد ملاحظات.</p>'}</div>
    <form id="f-adm-note" data-t="${esc(t)}" class="flex gap-2"><textarea name="text" rows="2" class="inp" maxlength="600" placeholder="أضف ملاحظة…" required></textarea><button class="btn b-pri flex-none" type="submit">إضافة</button></form></div>`;
}
function openAdminUser(uid) {
  const A = state.admin, u = A.users.find(x => x.id === uid); if (!u) return;
  const x = userInfo(u), b = A.blocked[uid], a = x.a, owner = lc(state.user.email) === OWNER_EMAIL, self = uid === state.user.uid, isOwnerAcc = lc(u.email) === OWNER_EMAIL;
  const js = A.jamiyat.filter(j => (j.memberUids || []).includes(uid)), wa = admWa(u.phone);
  showModal(esc(u.name || 'مستخدم'), `<div class="space-y-4 text-xs">
    <div class="flex flex-wrap gap-1.5">${x.online ? bdg('<i class="dot-on"></i> متصل الآن', 'bg-emerald-100 text-emerald-700') : ''}${x.blocked ? bdg('محظور', 'bg-rose-100 text-rose-700') : ''}${x.isAdm ? bdg('مشرف', 'bg-violet-100 text-violet-700') : ''}${x.flag ? bdg(FLAGS[x.flag][0], FLAGS[x.flag][1]) : ''}</div>
