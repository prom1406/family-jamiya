           isCreator: j.creatorUid === state.user.uid, isDeputy: !!j.deputyUid && j.deputyUid === state.user.uid, canManage: j.creatorUid === state.user.uid || (!!j.deputyUid && j.deputyUid === state.user.uid), isRec: recUid === state.user.uid,
