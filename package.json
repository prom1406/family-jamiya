/* ---- تطبيق iOS (Capacitor): الدخول بحساب Apple ----
   داخل التطبيق يُخفى زر جوجل (جوجل يمنع نافذة تسجيله داخل WebView) ويظهر زر Apple بدلاً منه.
   الدخول أصلي عبر AuthenticationServices (إضافة SignInWithApple)، ثم نمرّر الرمز إلى Firebase JS SDK ليبقى كل شيء كما هو. */
async function appleNativeCredential() {
  const plugin = window.Capacitor && Capacitor.Plugins && Capacitor.Plugins.SignInWithApple;
  if (!plugin) throw new Error('إضافة الدخول بآبل غير متوفرة في هذه النسخة');
  const raw = Array.from(crypto.getRandomValues(new Uint8Array(16))).map(b => b.toString(16).padStart(2, '0')).join('');
  const hashed = Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(raw)))).map(b => b.toString(16).padStart(2, '0')).join('');
  const res = await plugin.authorize({ clientId: 'com.prom1406.sewaa', redirectURI: 'https://aljamiyahapp.firebaseapp.com/__/auth/handler', scopes: 'email name', state: raw.slice(0, 8), nonce: hashed });
  const tok = res && res.response && res.response.identityToken;
  if (!tok) throw new Error('لم يصل رمز التحقق من Apple');
  return new firebase.auth.OAuthProvider('apple.com').credential({ idToken: tok, rawNonce: raw });
}
async function googleNativeCredential() {
  const plugin = window.Capacitor && Capacitor.Plugins && Capacitor.Plugins.SocialLogin;
  if (!plugin) throw new Error('إضافة الدخول بجوجل غير متوفرة في هذه النسخة');
  await plugin.initialize({ google: { iOSClientId: GOOGLE_IOS_CLIENT_ID, webClientId: GOOGLE_WEB_CLIENT_ID } });
  const res = await plugin.login({ provider: 'google', options: { scopes: ['email', 'profile'] } });
  const tok = res && res.result && res.result.idToken;
  if (!tok) throw new Error('لم يصل رمز التحقق من جوجل');
  return firebase.auth.GoogleAuthProvider.credential(tok);
}
async function doGoogleNative() {
  try {
    const r = await auth.signInWithCredential(await googleNativeCredential());
    try { localStorage.setItem('jm_email', r.user.email || ''); } catch (e) {}
  } catch (e) {
    const msg = String((e && (e.message || e.code)) || '');
    if (/cancel|dismiss|1001|-5\b/i.test(msg)) return; // المستخدم أغلق النافذة
    toast(e && e.code && String(e.code).startsWith('auth/') ? authErr(e) : 'تعذر الدخول عبر جوجل: ' + msg, 'error');
  }
}
