  return `<div class="p-4 bg-amber-50 border border-amber-200 rounded-2xl text-xs space-y-2"><p class="font-black text-amber-900"><i class="fa-solid fa-envelope-circle-check"></i> فعّل بريدك لتنضم أو تنشئ جمعية</p>
    <p class="text-amber-800 leading-relaxed">أرسلنا رابط التفعيل إلى <b dir="ltr">${esc(state.user.email)}</b>. افتحه ثم ارجع هنا وسيُحدَّث تلقائياً.</p>
    <div class="flex gap-2"><button class="btn b-pri flex-1" data-act="verify-check">تم التفعيل</button><button class="btn b-sec flex-1" data-act="verify-resend">إعادة الإرسال</button></div><button class="btn b-sec w-full" data-act="phone-verify"><i class="fa-solid fa-mobile-screen"></i> وثّق جوالك بدلاً من البريد</button></div>`;
}

/* ---- توثيق الجوال بديلاً عن البريد: رمز SMS يُربط بحساب الدخول الحالي فيُعدّ الحساب موثّقاً ---- */
let phoneVerifier = null;
// مهلة لعمليات الجوال: إن علق reCAPTCHA أو الشبكة يظهر سبب واضح بدل انتظار بلا نهاية
const withTimeout = (p, ms = 25000) => Promise.race([p, new Promise((_, rej) => setTimeout(() => rej(Object.assign(new Error('timeout'), { code: 'auth/client-timeout' })), ms))]);
// داخل تطبيق iOS لا يعمل reCAPTCHA الويب (النطاق capacitor://localhost)، فيُرسَل الرمز عبر Firebase الأصلي
// ثم يُكمل الدخول/الربط بمكتبة الويب باستخدام verificationId (الإضافة مضبوطة بـ skipNativeAuth)
const nativeAuthPlugin = () => window.Capacitor && Capacitor.Plugins && Capacitor.Plugins.FirebaseAuthentication;
const useNativePhone = () => IS_NATIVE && !!nativeAuthPlugin();
function nativeSendCode(phoneE164) {
  const P = nativeAuthPlugin(), hs = [];
  return new Promise(async (resolve, reject) => {
    let t;
    const done = (fn, v) => { clearTimeout(t); hs.forEach(h => { try { h.remove(); } catch (_) {} }); fn(v); };
    t = setTimeout(() => done(reject, Object.assign(new Error('timeout'), { code: 'auth/client-timeout' })), 60000);
    try {
      hs.push(await P.addListener('phoneCodeSent', ev => done(resolve, ev && ev.verificationId)));
      hs.push(await P.addListener('phoneVerificationFailed', ev => done(reject, Object.assign(new Error((ev && ev.message) || 'native phone verification failed'), { code: 'auth/native-failed' }))));
      await P.signInWithPhoneNumber({ phoneNumber: phoneE164, timeout: 0 });
    } catch (e) { done(reject, e); }
  });
}
const phoneAuthErr = e => ({
  'auth/client-timeout': 'لم يكتمل التحقق من الأمان (reCAPTCHA) خلال 25 ثانية. تأكد من الإنترنت وأعد المحاولة [client-timeout]',
  'auth/internal-error': 'تعذر إرسال الرمز الآن، أعد المحاولة بعد قليل [internal-error]',
  'auth/invalid-phone-number': 'رقم الجوال غير صحيح',
  'auth/missing-phone-number': 'اكتب رقم الجوال',
  'auth/too-many-requests': 'محاولات كثيرة، انتظر قليلاً ثم أعد المحاولة',
  'auth/invalid-verification-code': 'الرمز غير صحيح',
  'auth/code-expired': 'انتهت صلاحية الرمز، اطلب رمزاً جديداً',
  'auth/credential-already-in-use': 'هذا الجوال مرتبط بحساب آخر',
  'auth/provider-already-linked': 'حسابك موثّق بجوال بالفعل',
  'auth/captcha-check-failed': 'تعذر التحقق من الأمان، أعد المحاولة',
  'auth/quota-exceeded': 'تجاوزت حد الرسائل المسموح، حاول لاحقاً',
  'auth/operation-not-allowed': 'أرسلنا الطلب لكن Firebase يمنع الرسائل إلى هذه الدولة. فعّل السعودية (+966) في Authentication ← Settings ← SMS region policy'
}[e && e.code]) || (e && e.message === 'PHONE_TAKEN' ? PHONE_TAKEN_MSG : authErr(e) + (e && e.code ? ' [' + e.code + ']' : ''));
function openPhoneVerify() {
  if (!state.user) return;
  showModal('وثّق جوالك', `<div class="space-y-3">
    <p class="text-xs text-slate-600 leading-relaxed">أرسل رمز تحقق إلى جوالك. بعد التوثيق لا تحتاج تفعيل البريد.</p>
    <form id="f-phone-send" class="space-y-3">
      <input name="phone" class="inp" dir="ltr" type="tel" inputmode="numeric" autocomplete="tel" placeholder="05xxxxxxxx" value="${esc(normPhone(state.profile && state.profile.phone))}" required>
      <div id="pv-recaptcha"></div>
      <button class="btn b-pri w-full py-3" type="submit">أرسل الرمز</button>
    </form>
    <form id="f-phone-code" class="space-y-3 hide">
      <input name="code" class="inp" dir="ltr" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="رمز التحقق" required>
      <button class="btn b-pri w-full py-3" type="submit">تأكيد</button>
    </form></div>`);
}
async function sendPhoneCode(f) {
  const p = normPhone(f.phone.value), btn = f.querySelector('button[type=submit]');
  if (!validPhone(p)) return toast('رقم الجوال يجب أن يبدأ بـ 05 ويتكون من 10 أرقام', 'error');
  btn.disabled = true;
  try {
    if (phone05FromUser(auth.currentUser) === p) { toast('هذا هو رقمك الموثّق الحالي', 'info'); btn.disabled = false; return; }
    const e164 = '+966' + p.slice(1), changing = !!phone05FromUser(auth.currentUser);
    if (useNativePhone()) {
      const vid = await nativeSendCode(e164);
      const cred = code => firebase.auth.PhoneAuthProvider.credential(vid, code);
      state._phoneConf = { confirm: code => changing ? auth.currentUser.updatePhoneNumber(cred(code)) : auth.currentUser.linkWithCredential(cred(code)) };
    } else {
    phoneVerifier = freshRecaptcha(phoneVerifier, 'pv-recaptcha');
    if (phone05FromUser(auth.currentUser)) { // تغيير رقم موثّق
      const vid = await withTimeout(new firebase.auth.PhoneAuthProvider().verifyPhoneNumber('+966' + p.slice(1), phoneVerifier));
      state._phoneConf = { confirm: code => auth.currentUser.updatePhoneNumber(firebase.auth.PhoneAuthProvider.credential(vid, code)) };
    } else state._phoneConf = await withTimeout(auth.currentUser.linkWithPhoneNumber('+966' + p.slice(1), phoneVerifier));
    }
    state._phoneP = p;
    f.classList.add('hide'); $('f-phone-code').classList.remove('hide');
    toast('أرسلنا رمز التحقق إلى جوالك', 'success');
  } catch (e) {
    toast(phoneAuthErr(e), 'error');
    if (phoneVerifier) { try { phoneVerifier.clear(); } catch (_) {} phoneVerifier = null; }
  } finally { btn.disabled = false; }
}
async function confirmPhoneCode(f) {
  const btn = f.querySelector('button[type=submit]');
  if (!state._phoneConf) return toast('أرسل الرمز أولاً', 'error');
  btn.disabled = true;
  try {
    await state._phoneConf.confirm(f.code.value.trim());
    await auth.currentUser.getIdToken(true); // ليحمل الرمز مطالبة رقم الجوال قبل كتابة الملف الشخصي
    state.user = auth.currentUser; state._phoneConf = null;
    const p = state._phoneP, old = state.profile && state.profile.phone;
    if (state.profile && normPhone(old) !== p) {
      await saveProfileWithPhone(state.user.uid, { phone: p }, 'update', validPhone(old) ? old : null);
      state.profile = { ...state.profile, phone: p };
    }
    cleanup(state.unsubs); if (state.profile) startListeners();
    closeModal(); toast('تم توثيق جوالك ✓', 'success');
    const n = state._afterVerify; state._afterVerify = null;
    if (n) n(); else render();
  } catch (e) { toast(phoneAuthErr(e), 'error'); }
  finally { btn.disabled = false; }
}

/* ---- الدخول/التسجيل برقم الجوال من شاشة الدخول: رمز SMS يكفي، والبريد اختياري ---- */
let authVerifier = null;
// reCAPTCHA لا يُرسم مرتين في العنصر نفسه: نُزيل القديم ونستبدله بعنصر جديد لكل محاولة
function freshRecaptcha(oldVerifier, wrapperId) {
  if (oldVerifier) { try { oldVerifier.clear(); } catch (e) {} }
  const wrap = $(wrapperId); if (!wrap) throw new Error('recaptcha container missing');
  wrap.innerHTML = ''; // الحاوية الخارجية ثابتة، ونضع داخلها عنصراً جديداً لكل محاولة
  const box = document.createElement('div'); box.id = wrapperId + '-' + Date.now(); wrap.appendChild(box);
  return new firebase.auth.RecaptchaVerifier(box.id, { size: 'invisible' });
}
async function sendAuthCode(f) {
  const p = normPhone(f.phone.value), btn = f.querySelector('button[type=submit]');
  if (!validPhone(p)) return toast('رقم الجوال يجب أن يبدأ بـ 05 ويتكون من 10 أرقام', 'error');
  btn.disabled = true;
  try {
    if (useNativePhone()) {
      const vid = await nativeSendCode('+966' + p.slice(1));
      state._phoneConf = { confirm: code => auth.signInWithCredential(firebase.auth.PhoneAuthProvider.credential(vid, code)) };
    } else {
      authVerifier = freshRecaptcha(authVerifier, 'auth-recaptcha');
      state._phoneConf = await withTimeout(auth.signInWithPhoneNumber('+966' + p.slice(1), authVerifier));
    }
    state._phoneP = p; state._phoneLabel = p; state._phoneName = (f.name.value || '').trim();
    state.phoneStep = 'code'; render();
    toast('أرسلنا رمز التحقق إلى جوالك', 'success');
  } catch (e) {
    toast(phoneAuthErr(e), 'error');
    if (authVerifier) { try { authVerifier.clear(); } catch (_) {} authVerifier = null; }
  } finally { btn.disabled = false; }
}
async function confirmAuthCode(f) {
  const btn = f.querySelector('button[type=submit]');
  if (!state._phoneConf) { state.phoneStep = 'phone'; render(); return toast('أعد إرسال الرمز', 'error'); }
  btn.disabled = true; state._registering = true; // نمنع bootUser حتى يُضبط الاسم
  try {
    const cred = await state._phoneConf.confirm(f.code.value.trim());
    state._phoneConf = null; state.phoneStep = 'pw';
    if (state._phoneName.length >= 3) await cred.user.updateProfile({ displayName: state._phoneName }).catch(() => {});
    state._registering = false;
    await bootUser(auth.currentUser);
    if (auth.currentUser && phone05FromUser(auth.currentUser) && !hasPassword(auth.currentUser)) openSetPassword();
  } catch (e) { state._registering = false; toast(phoneAuthErr(e), 'error'); }
  finally { btn.disabled = false; }
}
// دخول بالجوال وكلمة المرور: لا رسائل نصية بعد إنشاء كلمة المرور
async function submitPwLogin(f) {
  const p = normPhone(f.phone.value), btn = f.querySelector('button[type=submit]');
  if (!validPhone(p)) return toast('رقم الجوال يجب أن يبدأ بـ 05 ويتكون من 10 أرقام', 'error');
  btn.disabled = true;
  try { await auth.signInWithEmailAndPassword(phoneLoginEmail(p), f.password.value); lsSet('jm_phone_pw', '1'); }
  catch (e) {
    const wrong = ['auth/invalid-credential', 'auth/invalid-login-credentials', 'auth/wrong-password', 'auth/user-not-found'].includes(e.code);
    toast(wrong ? 'الجوال أو كلمة المرور غير صحيحة. إن لم تنشئ كلمة مرور بعد فادخل برمز SMS' : authErr(e), 'error');
  } finally { btn.disabled = false; }
}
// إنشاء كلمة المرور بعد أول دخول برمز SMS (يُربط بالحساب نفسه دون حساب جديد)
async function submitSetPassword(f) {
  const u = auth.currentUser, pass = f.password.value;
  if (!u || hasPassword(u)) return closeModal();
  if (pass.length < 6) return toast('كلمة المرور 6 أحرف على الأقل', 'error');
  const btn = f.querySelector('button[type=submit]'); btn.disabled = true;
  try {
    const em = realEmail(u) || phoneLoginEmail(phone05FromUser(u));
    await u.linkWithCredential(firebase.auth.EmailAuthProvider.credential(em, pass));
    lsSet('jm_phone_pw', '1'); closeModal(); toast('تم حفظ كلمة المرور ✓ ادخل بها لاحقاً برقم جوالك', 'success'); render();
  } catch (e) { toast(authErr(e), 'error'); }
  finally { btn.disabled = false; }
}
function openSetPassword() {
  showModal('أنشئ كلمة مرور', `<form id="f-setpw" class="space-y-3"><p class="text-xs text-slate-600 leading-relaxed">ادخل بها لاحقاً برقم جوالك دون انتظار رسالة نصية. يمكنك تغييرها من الملف الشخصي.</p>
    <div><label class="text-xs font-semibold block mb-1">كلمة المرور</label><input name="password" type="password" minlength="6" class="inp" required autocomplete="new-password" placeholder="6 أحرف على الأقل"></div>
    <button class="btn b-pri w-full py-3" type="submit">حفظ</button><button type="button" class="w-full text-xs text-slate-500" data-act="close">لاحقاً</button></form>`);
}

/* ---- البيانات تُطلب عند الحاجة: الجوال والحساب البنكي قبل الانضمام لجمعية فقط ---- */
const profileComplete = p => !!p && validPhone(p.phone) && !!p.bank && (String(p.bank).startsWith('كاش') || validIban(p.iban));
function needDetails(next) {
  if (profileComplete(state.profile)) return next();
  state._afterDetails = next;
  const p = state.profile || {}, known = BANKS.includes(p.bank), sel = known ? p.bank : (p.bank ? OTHER_BANK : undefined), lb = 'text-xs font-semibold block mb-1';
  showModal('خطوة أخيرة قبل المتابعة', `<form id="f-need" class="space-y-3"><p class="text-xs text-slate-600 leading-relaxed">لتشارك في جمعية نحتاج جوالك (للتواصل والتذكير) وحسابك البنكي (لتستلم دورك). تُدخلها مرة واحدة فقط.</p>
    <div><label class="${lb}">رقم الجوال (05xxxxxxxx)</label><input name="phone" class="inp" type="tel" inputmode="numeric" autocomplete="tel" value="${esc(p.phone)}" placeholder="05xxxxxxxx"></div>
    <div><label class="${lb}">البنك</label><select name="bank" class="inp">${bankOpts(sel)}</select><div data-other class="${sel === OTHER_BANK ? '' : 'hide'} mt-2"><input name="bankOther" class="inp" placeholder="اكتب اسم البنك أو المحفظة" value="${esc(known ? '' : p.bank)}"></div></div>
    <div><label class="${lb}">الآيبان (SA + 22 رقماً) — اتركه فارغاً للكاش</label><input name="iban" class="inp" dir="ltr" value="${esc(p.iban)}" placeholder="SA0000000000000000000000"></div>
    <label class="flex items-start gap-2 text-xs"><input type="checkbox" name="waOptIn" class="mt-0.5" checked> <span>أرغب بتنبيهات السداد والدعوات عبر واتساب</span></label>
    <button class="btn b-pri w-full py-3" type="submit">حفظ ومتابعة</button></form>`);
}
async function doNeedDetails(f) {
  const phone = normPhone(f.phone.value), bank = resolveBank(f), iban = fixIban(f.iban.value); if (bank === null) return;
  if (!validPhone(phone)) return toast('رقم الجوال يجب أن يبدأ بـ 05 ويتكون من 10 أرقام', 'error');
  if (!bank.startsWith('كاش') && !validIban(iban)) return toast('الآيبان يجب أن يكون SA متبوعاً بـ 22 رقماً', 'error');
  const old = state.profile && state.profile.phone, data = { phone, bank, iban: bank.startsWith('كاش') ? '' : iban, waOptIn: f.waOptIn.checked };
  try {
    await saveProfileWithPhone(state.user.uid, data, 'update', validPhone(old) ? old : null);
