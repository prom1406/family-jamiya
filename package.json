    switch (A.uf) {
      case 'online': return x.online; case 'active7': return lastTime(x) > now - 7 * 864e5; case 'idle': return x.lastAct && lastTime(x) < now - 30 * 864e5;
      case 'never': return !x.logins; case 'blocked': return x.blocked; case 'noted': return x.nNotes > 0 || !!x.flag;
