async function adminDeleteJam(id) {
  const A = state.admin, j = A.jamiyat.find(x => x.id === id);
  if (!j || lc(state.user.email) !== OWNER_EMAIL) return toast('الحذف للمالك فقط', 'error');
  const typed = prompt('للتأكيد اكتب اسم الجمعية تماماً:\n' + j.name);
  if (typed === null) return;
  if (typed.trim() !== String(j.name).trim()) return toast('الاسم غير مطابق، لم يتم الحذف', 'error');
  const ref = db.collection('jamiyat').doc(id), wipe = async q => { const snap = await q.get(); for (let i = 0; i < snap.docs.length; i += 400) { const b = db.batch(); snap.docs.slice(i, i + 400).forEach(d => b.delete(d.ref)); await b.commit(); } };
  toast('جارٍ الحذف…', 'info');
  try {
    await wipe(ref.collection('payments')); await wipe(ref.collection('proofs')); await wipe(ref.collection('wishes')); await wipe(ref.collection('chat')); await wipe(ref.collection('log')); await wipe(ref.collection('pledges')); await wipe(db.collection('invites').where('jamiyaId', '==', id)); await wipe(ref.collection('members'));
    await ref.delete(); await db.collection('admin_notes').doc('j_' + id).delete().catch(() => {});
    A.jamiyat = A.jamiyat.filter(x => x.id !== id); delete A.notes['j_' + id];
    logEvent('adm_jam_del', { target: id, targetName: j.name, info: 'المشرف: ' + (j.creatorName || '') });
    closeModal(); render(); toast('تم حذف الجمعية');
  } catch (e) { toast('تعذر الحذف: ' + e.message + ' — تأكد من نشر القواعد المحدّثة', 'error'); }
}
/* ===== رسالة واتساب جماعية: يختار المالك المستلمين واحداً واحداً، ومن أُرسل له يخرج من القائمة ===== */
const waDoc = () => state.admin.notes.wa_broadcast || {};
const waText = () => state.admin.waText !== undefined ? state.admin.waText : (waDoc().text || '');
const waFill = (txt, u) => txt.replace(/\{الاسم\}/g, String(u.name || '').trim().split(/\s+/)[0] || '');
function waLists() {
  const A = state.admin, sent = new Set(waDoc().sentUids || []), q = lc(A.waQ), qd = normPhone(A.waQ);
  const eligible = A.users.filter(u => admWa(u.phone) && (!A.waOnlyOpt || u.waOptIn !== false));
  const todo = eligible.filter(u => !sent.has(u.id) && (!q || lc(u.name).includes(q) || lc(u.nick).includes(q) || (qd && String(u.phone || '').includes(qd))))
    .sort((a, b) => String(a.name).localeCompare(String(b.name), 'ar'));
  return { todo, left: eligible.filter(u => !sent.has(u.id)).length, done: eligible.filter(u => sent.has(u.id)).length, noPhone: A.users.filter(u => !admWa(u.phone)).length };
}
function waStatsHtml() { const L = waLists(); return `المتبقي <b>${nf(L.left)}</b> • أُرسل لهم <b>${nf(L.done)}</b>${L.noPhone ? ` • بدون رقم صالح ${nf(L.noPhone)}` : ''}`; }
function waListHtml() {
  const { todo, left } = waLists();
  if (!todo.length) return `<p class="text-xs text-slate-400 p-3 text-center">${left ? 'لا توجد نتائج للبحث.' : 'انتهت القائمة 🎉 أُرسلت الرسالة لجميع المستخدمين.'}</p>`;
  return todo.map(u => `<div class="p-3 bg-slate-50 rounded-xl flex items-center justify-between gap-2 text-xs"><div class="min-w-0"><b class="block truncate">${esc(u.name || '—')}${u.waOptIn === false ? ' ' + bdg('لم يفعّل واتساب', 'bg-amber-50 text-amber-700') : ''}</b><span class="text-[11px] text-slate-500" dir="ltr">${esc(u.phone || '')}</span></div>
