  d.innerHTML = `<img src="icon-192.png" style="width:64px;height:64px;border-radius:16px" alt=""><p style="font-weight:900;font-size:18px">أدخل رمز القفل</p><div id="lock-dots" style="display:flex;gap:12px;height:16px"></div><p id="lock-msg" style="font-size:12px;color:#fda4af;height:16px"></p>
    <div style="display:grid;grid-template-columns:repeat(3,72px);gap:12px;direction:ltr">${[1, 2, 3, 4, 5, 6, 7, 8, 9, '', 0, '⌫'].map(k => k === '' ? '<span></span>' : `<button type="button" data-k="${k}" style="height:56px;border-radius:16px;background:#1e293b;color:#fff;font-size:22px;font-weight:700">${k}</button>`).join('')}</div>
    <button type="button" data-forgot style="font-size:12px;color:#94a3b8;text-decoration:underline">نسيت الرمز؟ تسجيل الخروج</button>`;
  document.body.appendChild(d); paintDots(); d.addEventListener('click', onLockClick);
}
function onLockClick(e) {
  const b = e.target.closest('button'); if (!b) return;
