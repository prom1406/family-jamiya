function cycleRowHtml(j) {
  if (j.type === 'family') return '';
  const idx = monthIdx(j);
  if (idx < 0) return '<p class="text-[11px] font-bold text-amber-700 mt-1">لم تبدأ بعد</p>';
  const mgr = j.creatorUid === state.user.uid, finished = idx >= j.count;
  const cur = Math.min(idx, j.count - 1), shown = Math.min(idx + 1, j.count);
  const body = mgr && !finished
    ? `<input type="number" min="1" max="${j.count}" value="${shown}" dir="ltr" aria-label="رقم الدورة الحالية" class="inp !py-0 !px-1 w-12 text-center text-xs font-black"><button type="button" data-act="jam-cycle-save" data-id="${esc(j.id)}" class="px-2 py-0.5 rounded-lg bg-teal-600 text-white text-[11px] font-bold">حفظ</button>`
    : `<b class="text-slate-700">${shown}</b>`;
