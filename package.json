  const uid = state.user.uid, p = state.profile, ref = db.collection('jamiyat').doc(), batch = db.batch();
  const doc = { type: 'family', mode: monthly ? 'monthly' : 'once', name, icon: cleanIcon(f.icon.value), goal, reasons, benBank: bank, benIban: iban,
    closed: false, count: 30, amount: 0, creatorUid: uid, creatorName: dispName(p), memberUids: [uid], turns: [uid], modRequest: null, createdAt: FV.serverTimestamp() };
  if (monthly) {
