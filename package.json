/* ============ إنشاء وفتح الجمعية ============ */
function handleCreate(f) { const go = () => handleCreateCore(f); needVerified(() => (f.joinSelf && !f.joinSelf.checked) ? go() : needDetails(go)); }
async function handleCreateCore(f) {
  const name = f.jname.value.trim(), count = parseInt(f.count.value), amount = parseFloat(f.amount.value);
  const startDate = f.start.value, lastDay = parseInt(f.lastDay.value), payDay = parseInt(f.payDay.value);
  const frequency = FREQS[f.frequency.value] ? f.frequency.value : 'monthly', maxDay = maxDayOf({ frequency });
  if (!name || !startDate) return toast('أكمل الحقول المطلوبة', 'error');
  if (!(count >= 2 && count <= 30)) return toast('عدد الأعضاء بين 2 و30', 'error');
  if (!(amount >= 1)) return toast('قيمة الاشتراك غير صحيحة', 'error');
  if (!(lastDay >= 1 && lastDay <= maxDay && payDay >= 1 && payDay <= maxDay)) return toast(`الأيام بين 1 و${maxDay}`, 'error');
  const uid = state.user.uid, p = state.profile, joinSelf = f.joinSelf ? f.joinSelf.checked : true;
  const ref = db.collection('jamiyat').doc();
  const batch = db.batch();
  batch.set(ref, { name, icon: cleanIcon(f.icon.value), count, amount, frequency, startDate, lastDay, payDay, creatorUid: uid, creatorName: dispName(p), memberUids: joinSelf ? [uid] : [], turns: joinSelf ? [uid] : [], modRequest: null, createdAt: FV.serverTimestamp() });
  if (joinSelf) batch.set(ref.collection('members').doc(uid), memberDoc(uid, p));
  try { await batch.commit(); toast(joinSelf ? 'تم إنشاء الجمعية' : 'تم إنشاء الجمعية وأنت مشرف فقط'); schedStats(true); wzDone('jamiya', ref.id, name); }
  catch (e) { toast('تعذر الإنشاء: ' + e.message, 'error'); }
}
/* ============ تنبيهات الصفحة الرئيسية + التقويم ============ */
function stopPayListeners() { Object.values(state.payLs).forEach(u => u()); state.payLs = {}; }
// مشرف الجمعية يقرأ كل دفعاتها، والعضو يقرأ دفعاته فقط (أقل استهلاكاً للحصة المجانية)
function syncPayListeners() {
  if (!state.user) return;
  const uid = state.user.uid, want = new Set();
  // فقط الجمعيات الجارية (بدأت ولم تنتهِ) وغير المفتوحة الآن (المفتوحة لها مستمع خاص بها)
  state.jamiyat.forEach(j => {
    const idx = j.startDate ? monthIdx(j) : -1;
    if (idx >= 0 && idx < j.count && !(state.view === 'jamiya' && state.activeId === j.id)) want.add(j.id);
  });
  Object.keys(state.payLs).forEach(id => { if (!want.has(id)) { state.payLs[id](); delete state.payLs[id]; } });
  state.jamiyat.forEach(j => {
    const staff = j.creatorUid === uid || (!!j.deputyUid && j.deputyUid === uid); state.payRole = state.payRole || {};
    if (state.payLs[j.id] && state.payRole[j.id] !== staff) { state.payLs[j.id](); delete state.payLs[j.id]; }
    if (!want.has(j.id) || state.payLs[j.id]) return;
    state.payRole[j.id] = staff;
    const col = db.collection('jamiyat').doc(j.id).collection('payments');
    const q = staff ? col : col.where('uid', '==', uid);
    state.payLs[j.id] = q.onSnapshot(s => {
      state.pays[j.id] = s.docs.map(d => ({ id: d.id, ...d.data() })); notifyPays(j, state.pays[j.id]);
      if (state.view === 'home') render(); else renderNav();
    }, () => {});
  });
}
document.addEventListener('visibilitychange', () => { if (!document.hidden) { if (state.view === 'home') render(); else renderNav(); } });
function runAfterOpen() {
  const a = state.afterOpen;
  if (!a || a.id !== state.activeId || !state.j || !state.gotM || !state.gotP) return;
  state.afterOpen = null;
  if (a.act === 'wa-remind') openWaReminders();
  if (a.act === 'invite-modal') openModal('invite');
}
function homeAlerts() {
  const uid = state.user.uid, out = [], today = new Date(); today.setHours(0, 0, 0, 0);
  const diff = d => Math.round((d - today) / DAY_MS), SOON = 5;
  const when = n => n < 0 ? `متأخر ${-n} ${-n === 1 ? 'يوم' : 'أيام'}` : n === 0 ? 'آخر موعد اليوم' : n === 1 ? 'آخر موعد غداً' : `آخر موعد بعد ${n} أيام`;
  state.jamiyat.forEach(j => {
    const pays = state.pays[j.id]; if (!pays || !j.startDate) return;
    const idx = monthIdx(j); if (idx < 0 || idx >= j.count) return;
    const cur = idx, turns = j.turns || [], recUid = turns[cur];
    const due = dayIn(j, cur, j.lastDay), left = diff(due), payoutLeft = diff(dayIn(j, cur, j.payDay));
    const owes = u => (u !== recUid || sharesOf(turns, u) > 1) && ['unpaid', 'partial'].includes(accountFor(j, turns, cur, true, pays, u).status);
    // 1) قسطي أنا
    if (turns.includes(uid) && owes(uid)) {
      const mine = accountFor(j, turns, cur, true, pays, uid);
      const prev = cur > 0 ? accountFor(j, turns, cur - 1, true, pays, uid) : null;
      const late = (prev && ['unpaid', 'partial'].includes(prev.status)) || left < 0;
      if (late || left <= SOON) out.push({ lvl: late ? 0 : 1, id: j.id, title: `قسط جمعية «${j.name}»`,
        text: `المتبقي عليك ${fmtNum(mine.remaining)} ريال — ${late ? 'متأخر، سدّد في أقرب وقت' : when(left)} (${fmtDate(due)})` });
    }
    // 2) المشرف: أعضاء لم يسددوا
    if ((j.creatorUid === uid || (j.deputyUid && j.deputyUid === uid)) && (left <= SOON)) {
      const n = [...new Set(turns)].filter(u => u !== uid && owes(u)).length;
      if (n > 0) out.push({ lvl: left < 0 ? 0 : 1, id: j.id, remind: true, title: `جمعية «${j.name}»`,
        text: `${n} ${n === 1 ? 'عضو لم يسدد' : 'أعضاء لم يسددوا'} بعد — ${when(left)} (${fmtDate(due)})` });
    }
    // 3) دوري في القبض قريباً
    if (recUid === uid && payoutLeft >= 0 && payoutLeft <= 7)
      out.push({ lvl: 2, id: j.id, title: `دورك في القبض 🎉`, text: `جمعية «${j.name}» — ${payoutLeft === 0 ? 'اليوم' : payoutLeft === 1 ? 'غداً' : `بعد ${payoutLeft} أيام`} (${fmtDate(dayIn(j, cur, j.payDay))})` });
  });
  return out.sort((a, b) => a.lvl - b.lvl);
}
const ALERT_ST = [['bg-rose-50 border-rose-200', 'fa-triangle-exclamation text-rose-500'], ['bg-amber-50 border-amber-200', 'fa-clock text-amber-500'], ['bg-indigo-50 border-indigo-200', 'fa-gift text-indigo-500']];
const alertCount = () => { try { return state.user && state.profile ? homeAlerts().length : 0; } catch (e) { return 0; } };
const KIND_IC = { pay: 'fa-coins text-emerald-600', member: 'fa-user-plus text-sky-600', mod: 'fa-pen-to-square text-indigo-600', custom: 'fa-bullhorn text-teal-600', remind: 'fa-bell text-amber-500' , admin: 'fa-user-shield text-emerald-600', invite: 'fa-envelope-open-text text-sky-600', cycle: 'fa-rotate text-emerald-600' };
const bellCount = () => alertCount() + unreadCount();
