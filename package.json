document.addEventListener('click', e => {
  const el = e.target.closest('[data-act]'); if (!el) return;
  const fn = actions[el.dataset.act]; if (fn) fn(el);
});
document.addEventListener('change', e => {
  if (e.target.matches && e.target.matches('select[data-freq]') && e.target.form) {
    const dl = dayLabels(e.target.value), fm = e.target.form;
    const l1 = fm.querySelector('[data-lbl-last]'), l2 = fm.querySelector('[data-lbl-pay]');
    if (l1) l1.textContent = dl.last; if (l2) l2.textContent = dl.pay;
    ['lastDay', 'payDay'].forEach(n => { if (fm[n]) { fm[n].max = dl.max; if (+fm[n].value > dl.max) fm[n].value = dl.max; } });
  }
  if (e.target.name === 'bank' && e.target.form) {
    const box = e.target.form.querySelector('[data-other]');
    if (box) box.classList.toggle('hide', e.target.value !== OTHER_BANK);
  }
});
document.addEventListener('input', e => {
  const fm = e.target.form; if (!fm) return;
  if (fm.querySelector('[data-identity]')) updPreview(fm);
