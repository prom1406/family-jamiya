async function loadAdmin(force) {
  if (!state.isAdmin) return;
  const A = state.admin;
  if (!force && A.loaded && Date.now() - (A.at || 0) < 300000) { if (state.view === 'admin') render(); return; } // لا نعيد قراءة كل البيانات خلال 5 دقائق
