async function submitSelfContrib(f) {
  const c = ctx(); if (!c || !c.family || !c.isCreator) return; const j = c.j, uid = state.user.uid, amount = parseFloat(f.amount.value);
  if (!famState(j).open) return toast('باب المساهمة مغلق', 'error');
  if (!(amount > 0)) return toast('المبلغ غير صحيح', 'error');
  const btn = f.querySelector('button[type=submit]'); btn.disabled = true;
  const ref = jref(), pr = ref.collection('payments').doc(`${famCycle1(j)}_${uid}_${Date.now()}`);
  try {
