.ap-tabs{display:flex;gap:.3rem;overflow-x:auto;scrollbar-width:none;padding:.3rem;background:var(--brand-soft);border-radius:18px}
.ap-tabs::-webkit-scrollbar{display:none}
.ap-tab{flex:1 0 auto;display:flex;flex-direction:column;align-items:center;gap:.25rem;padding:.55rem .7rem;border-radius:14px;font-size:.72rem;font-weight:800;color:var(--muted);background:transparent;border:0;white-space:nowrap;transition:background .25s,color .25s,box-shadow .25s,transform .15s}
