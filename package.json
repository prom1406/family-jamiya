  showModal('تعديل بيانات ' + esc(u.name), `<form id="f-adm-contact" data-id="${uid}" class="space-y-3">
    <div><label class="text-xs font-semibold block mb-1">رقم الجوال (05xxxxxxxx)</label><input name="phone" class="inp" dir="ltr" inputmode="numeric" value="${esc(u.phone || '')}" required></div>
    <div><label class="text-xs font-semibold block mb-1">البريد الإلكتروني</label><input name="email" type="email" dir="ltr" class="inp" value="${esc(u.email || '')}" required></div>
    <p class="p-3 bg-amber-50 border border-amber-200 rounded-xl text-[11px] text-amber-900 leading-relaxed">يُحدَّث الجوال والبريد في بيانات الحساب وفي كل جمعياته. أما <b>بريد تسجيل الدخول</b> فيبقى كما هو لأن تغييره يتم من Firebase Console ← Authentication.</p>
    <button class="btn b-pri w-full py-3" type="submit"><i class="fa-solid fa-floppy-disk"></i> حفظ</button></form>`);
}
async function adminSaveContact(f) {
  const A = state.admin, uid = f.dataset.id, u = A.users.find(x => x.id === uid);
  if (!u || lc(state.user.email) !== OWNER_EMAIL) return toast('التعديل للمالك فقط', 'error');
  const phone = normPhone(f.phone.value), email = lc(f.email.value), oldPhone = normPhone(u.phone), oldEmail = lc(u.email);
  if (!validPhone(phone)) return toast('رقم الجوال يجب أن يبدأ بـ 05 ويتكون من 10 أرقام', 'error');
  if (!validEmail(email)) return toast('البريد غير صحيح', 'error');
  const chPhone = phone !== oldPhone, chEmail = email !== oldEmail;
  if (!chPhone && !chEmail) return toast('لم يتغير شيء', 'info');
  if (chEmail && A.users.some(x => x.id !== uid && lc(x.email) === email)) return toast('هذا البريد مسجّل لمستخدم آخر', 'error');
  const btn = f.querySelector('button[type=submit]'); btn.disabled = true;
  const patch = {}; if (chPhone) patch.phone = phone; if (chEmail) patch.email = email;
  try {
    if (chPhone) {
      const nRef = db.collection('phones').doc(phone), oRef = oldPhone ? db.collection('phones').doc(oldPhone) : null, uRef = db.collection('users').doc(uid);
      await db.runTransaction(async t => {
        const ns = await t.get(nRef); if (ns.exists && ns.data().uid !== uid) throw new Error('PHONE_TAKEN');
        const os = oRef ? await t.get(oRef) : null;
        if (os && os.exists && oldPhone !== phone) t.delete(oRef);
        t.set(nRef, { uid }); t.update(uRef, patch);
      });
    } else await db.collection('users').doc(uid).update(patch);
    let failed = 0;
    await Promise.all(A.jamiyat.filter(j => (j.memberUids || []).includes(uid)).map(j => db.collection('jamiyat').doc(j.id).collection('members').doc(uid).update(patch).catch(() => { failed++; })));
    Object.assign(u, patch);
    logEvent('adm_contact', { target: uid, targetName: u.name, info: [chPhone ? 'الجوال: ' + oldPhone + ' ← ' + phone : '', chEmail ? 'البريد: ' + oldEmail + ' ← ' + email : ''].filter(Boolean).join(' • ') });
    toast(failed ? 'حُفظت البيانات، وتعذر تحديث ' + nf(failed) + ' جمعية (راجع القواعد)' : 'تم تحديث البيانات', failed ? 'info' : 'success'); reopenTarget(uid);
  } catch (e) {
    btn.disabled = false;
    toast(e.message === 'PHONE_TAKEN' ? 'رقم الجوال مسجّل لحساب آخر' : e.code === 'permission-denied' ? 'لا توجد صلاحية: انشر قواعد Firestore المحدّثة أولاً' : 'تعذر الحفظ: ' + e.message, 'error');
  }
}
async function toggleAdmin(uid) {
  const A = state.admin, u = A.users.find(x => x.id === uid); if (!u) return;
  const on = !A.admins[uid]; if (!confirm((on ? 'منح' : 'سحب') + ' صلاحية المشرف ' + (on ? 'إلى ' : 'من ') + u.name + '؟')) return;
  try {
