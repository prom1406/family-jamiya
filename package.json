  showModal('حذف الجمعية', `<form id="f-delete" class="space-y-3">
    <div class="p-3 bg-rose-50 border border-rose-200 rounded-xl text-xs text-rose-800 leading-relaxed"><b>تحذير:</b> سيتم حذف الجمعية نهائياً مع الأعضاء والمدفوعات والإيصالات والدعوات لجميع المشاركين، ولا يمكن التراجع.${hasPays ? `<br>يوجد ${state.payments.length} دفعة مسجّلة سيُحذف سجلها.` : ''}</div>
    <div><label class="text-xs font-semibold block mb-1">للتأكيد اكتب اسم الجمعية: <b>${esc(c.j.name)}</b></label><input name="confirm" class="inp" autocomplete="off" required></div>
    <div class="flex gap-2"><button type="button" class="btn b-sec flex-1" data-act="close">إلغاء</button><button class="btn flex-1 bg-rose-600 text-white" type="submit"><i class="fa-solid fa-trash"></i> حذف نهائياً</button></div></form>`);
}
async function submitDelete(f) {
  const c = ctx(); if (!c || !c.isCreator) return toast('الحذف متاح لمشرف الجمعية فقط', 'error');
  if (c.j.hasConfirmed) return toast(DEL_LOCK_MSG, 'error');
  if (f.confirm.value.trim() !== c.j.name.trim()) return toast('اكتب اسم الجمعية كما هو تماماً للتأكيد', 'error');
  const btn = f.querySelector('button[type=submit]'); btn.disabled = true; btn.textContent = 'جارٍ الحذف...';
  const id = c.j.id, ref = db.collection('jamiyat').doc(id), uid = state.user.uid;
  cleanup(state.jUnsubs); // نوقف الاستماع حتى لا تتأثر الشاشة أثناء الحذف
  const wipe = async q => { const snap = await q.get(); for (let i = 0; i < snap.docs.length; i += 400) { const b = db.batch(); snap.docs.slice(i, i + 400).forEach(d => b.delete(d.ref)); await b.commit(); } };
  try {
    await wipe(ref.collection('payments'));
    await wipe(ref.collection('proofs'));
    await wipe(ref.collection('wishes'));
    await wipe(ref.collection('chat'));
    await wipe(ref.collection('log'));
    await wipe(ref.collection('pledges'));
    await wipe(db.collection('invites').where('jamiyaId', '==', id).where('creatorUid', '==', uid));
    await wipe(ref.collection('members'));
