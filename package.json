    g('jamiyat', db.collection('jamiyat')), g('users', db.collection('users')), g('activity', db.collection('activity')), g('blocked', db.collection('blocked')),
    g('admin_notes', db.collection('admin_notes')), g('admins', db.collection('admins')),
    g('stats', db.collection('stats').orderBy('day', 'desc').limit(70)), g('events', db.collection('events').orderBy('ts', 'desc').limit(200)), g('qattahs', db.collection('qattahs'))]);
  const map = (s, f) => { const o = {}; if (s) s.docs.forEach(d => { o[d.id] = f ? f(d) : d.data(); }); return o; };
  if (j) A.jamiyat = j.docs.map(d => ({ id: d.id, ...d.data() }));
  if (qz) A.qattahs = qz.docs.map(d => ({ id: d.id, ...d.data() }));
  if (u) A.users = u.docs.map(d => ({ id: d.id, ...d.data() }));
  A.act = map(ac); A.blocked = map(bl); A.notes = map(nt); A.admins = map(ad); A.stats = map(st);
  A.events = ev ? ev.docs.map(d => ({ id: d.id, ...d.data() })) : [];
