      <p class="p-3 bg-amber-50 border border-amber-200 rounded-xl text-amber-900">${notifDenied() ? 'الإشعارات مغلقة لسِواء في إعدادات جوالك.' : 'تعذّر تفعيل الإشعارات على هذا الجهاز.'}</p>
      ${notifDenied() ? '<p>افتح <b>الإعدادات ← الإشعارات ← سِواء</b> وفعّل «السماح بالإشعارات»، ثم ارجع للتطبيق.</p>' : ''}
      <button type="button" class="btn b-pri w-full" data-act="reg-push"><i class="fa-solid fa-rotate"></i> إعادة تسجيل الجهاز</button></div>`);
  }
  const ios = isIOS(), denied = notifSupported() && Notification.permission === 'denied';
  const why = denied ? 'الإشعارات محظورة لهذا الموقع في إعدادات جوالك.' : reason === 'ios' ? 'على الآيفون لا تعمل الإشعارات إلا من التطبيق المثبّت على الشاشة الرئيسية.' : 'تعذّر تفعيل الإشعارات من هذه النافذة.';
  const steps = denied
    ? [ios ? 'افتح <b>الإعدادات ← الإشعارات ← سِواء</b> وفعّل «السماح بالإشعارات».' : 'اضغط أيقونة القفل بجانب الرابط ← <b>الأذونات ← الإشعارات ← السماح</b>، أو من إعدادات التطبيق ← الإشعارات.', 'ارجع للتطبيق واضغط «إعادة تسجيل الجهاز».']
    : ['احذف أيقونة <b>سِواء</b> القديمة من شاشتك الرئيسية (التي ثبّتّها قبل تغيير الرابط). بياناتك محفوظة في حسابك ولن تضيع.',
       ios ? `افتح <b dir="ltr">${NEW_HOST}</b> في Safari ← زر المشاركة ← <b>إضافة إلى الشاشة الرئيسية</b>.` : `افتح <b dir="ltr">${NEW_HOST}</b> في كروم ← القائمة ⋮ ← <b>تثبيت التطبيق</b>.`,
       'افتح التطبيق من الأيقونة الجديدة وسجّل الدخول بنفس بريدك، ثم اضغط <b>تفعيل الإشعارات</b>.'];
  showModal('تفعيل الإشعارات', `<div class="space-y-3 text-xs leading-relaxed">
    <p class="p-3 bg-amber-50 border border-amber-200 rounded-xl text-amber-900">${why} ${denied ? '' : 'تم نقل سِواء إلى رابطها الجديد <b dir="ltr">' + NEW_HOST + '</b>، والإشعارات مرتبطة بالرابط الذي ثبّتّ التطبيق منه، لذلك يلزم تثبيته من جديد مرة واحدة.'}</p>
    <ol class="space-y-2.5">${steps.map((t, i) => `<li class="flex gap-3 items-center"><span class="jicon !w-9 !h-9 !text-sm">${i + 1}</span><span>${t}</span></li>`).join('')}</ol>
    <a class="btn b-pri w-full" href="${APP_URL}" target="_blank" rel="noopener"><i class="fa-solid fa-up-right-from-square"></i> فتح الرابط الجديد</a>
    <button type="button" class="btn b-sec w-full" data-act="reg-push"><i class="fa-solid fa-rotate"></i> إعادة تسجيل الجهاز</button></div>`);
}
async function enableNotifs() {
  if (IS_NATIVE) {
    const r = await nativePushRegister(true, true);
    if (r.ok) toast('تم تفعيل الإشعارات'); else if (nativePerm() === 'denied') notifHelp('denied'); else toast('تعذّر تفعيل الإشعارات: ' + r.err, 'error');
    renderBanner(); if (state.view === 'profile') render(); return;
  }
  if (!notifSupported()) return notifHelp('ios');
  if (isIOS() && !isStandalone()) return notifHelp('ios');
  let p = Notification.permission;
  if (p === 'default') { try { p = await Notification.requestPermission(); } catch (e) { p = 'default'; } }
  if (p === 'granted') {
    lsSet('jm_notif', '1');
    const r = await registerPush(true);
    if (r && r.ok) { toast('تم تفعيل الإشعارات'); showSysNotif('سِواء', 'الإشعارات مفعّلة ✓', 'welcome_' + Date.now()); }
    else { toast('سُمح بالإشعارات لكن تعذّر تسجيل الجهاز، جرّب «إعادة تسجيل الجهاز»', 'error'); console.warn('push reg', r && r.err); }
  } else notifHelp(p === 'denied' ? 'denied' : 'stale'); // «default» بعد الطلب = لم تظهر النافذة (غالباً تطبيق قديم مثبّت على الدومين السابق)
  renderBanner(); if (state.view === 'profile') render();
}
