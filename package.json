  const n = Math.floor(Number(el.parentElement.querySelector('input').value));
  if (!(n >= 1 && n <= j.count)) return toast(`رقم الدورة يجب أن يكون بين 1 و ${j.count}`, 'error');
  const startDate = isoDay(periodStart(j, monthIdx(j) - (n - 1)));
