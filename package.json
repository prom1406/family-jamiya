  const action = c.isRec ? '<div class="text-center"><span class="px-3 py-1.5 bg-yellow-300 text-slate-900 text-xs font-bold rounded-xl">أنت مستلم هذه الدورة</span></div>'
    : !c.started || !j.memberUids.includes(uid) ? ''
    : me && ['unpaid', 'partial'].includes(me.status) ? `<div class="rounded-2xl bg-white p-3 text-slate-800 flex items-center justify-between gap-3"><div class="text-xs"><span class="text-slate-500">المتبقي عليك</span><b class="block text-base text-rose-600">${fmtNum(me.remaining)} ريال</b></div><button class="btn b-pri" data-act="pay-modal"><i class="fa-solid fa-file-arrow-up"></i> رفع إثبات السداد</button></div>`
    : me ? `<div class="rounded-2xl bg-white/20 p-3 text-center space-y-1.5"><b class="text-xs">${me.status === 'confirmed' ? 'تم تأكيد سدادك ✓' : 'إيصالك بانتظار تأكيد المستلم'}</b>${me.credit > 0 ? `<div class="text-[11px] text-emerald-50">رصيد مقدّم ${fmtNum(me.credit)} ريال</div>` : ''}<button class="text-[11px] underline" data-act="pay-modal">دفعة مقدّمة</button></div>` : '';
  let cycleRow = '';
  if (!c.finished) {
    const t0 = dayStart(new Date());
    if (c.started) {
      const end = periodEnd(j, c.cur), left = Math.max(0, Math.round((end - t0) / DAY_MS));
      cycleRow = `<div class="rounded-2xl bg-white/15 py-2 px-3 flex justify-between items-center gap-2"><span class="text-right"><span class="text-[10px] text-emerald-100 block">تنتهي الدورة</span><b class="text-xs">${fmtDate(end)}</b></span><span class="px-3 py-1 rounded-full bg-white/25 text-xs font-black">${left === 0 ? 'تنتهي اليوم' : 'باقي ' + daysAr(left)}</span></div>`;
    } else {
      const st0 = periodStart(j, 0), left = Math.max(0, Math.round((st0 - t0) / DAY_MS));
      cycleRow = `<div class="rounded-2xl bg-white/15 py-2 px-3 flex justify-between items-center gap-2"><span class="text-right"><span class="text-[10px] text-emerald-100 block">تبدأ الدورة الأولى</span><b class="text-xs">${fmtDate(st0)}</b></span><span class="px-3 py-1 rounded-full bg-white/25 text-xs font-black">${left === 0 ? 'تبدأ اليوم' : 'بعد ' + daysAr(left)}</span></div>`;
    }
  }
  const recBox = c.finished ? `<div class="rounded-3xl p-6 text-white shadow-lg" style="background:linear-gradient(135deg,#1e293b,#334155)"><h3 class="text-lg font-black">اكتملت الجمعية 🎉</h3><p class="text-xs text-slate-300 mt-1">استلم جميع الأعضاء أدوارهم.</p></div>`
    : `<div class="rounded-3xl p-5 text-white shadow-lg space-y-4" style="background:linear-gradient(135deg,#0f4c3a,#1e5a46 55%,#0fb16b)">
      <div class="flex justify-between items-start gap-3"><div class="min-w-0"><p class="text-[11px] text-emerald-100 font-bold">${c.started ? 'مستلم دفعة ' + periodLabel(j, c.cur) : 'أول مستلم (لم تبدأ الجمعية بعد)'}</p>
        <h3 class="text-xl font-black leading-snug">${c.rec ? esc(dispName(c.rec)) : 'لم يكتمل ترتيب الأعضاء'}</h3></div>
        <span class="flex-none px-2.5 py-1 rounded-full text-[10px] font-black bg-white/25">${c.started ? 'الدورة ' + (c.cur + 1) + ' من ' + j.count : 'لم تبدأ'}</span></div>
      ${c.rec && c.rec.iban ? `<div class="rounded-2xl bg-white/15 p-3 flex items-center justify-between gap-2"><div class="min-w-0 text-xs"><p class="text-emerald-100">${esc(c.rec.bank || '')}</p><p class="font-black break-all" dir="ltr">${esc(c.rec.iban)}</p></div><button class="flex-none px-3 py-1.5 bg-white/25 rounded-xl text-[11px] font-bold" data-act="copy-iban" data-v="${esc(fixIban(c.rec.iban))}"><i class="fa-regular fa-copy"></i> نسخ</button></div>` : ''}
      <div class="grid grid-cols-2 gap-2 text-center"><div class="rounded-2xl bg-white/15 py-2"><span class="text-[10px] text-emerald-100 block">آخر موعد للسداد</span><b class="text-xs">${fmtDate(due)}</b></div><div class="rounded-2xl bg-white/15 py-2"><span class="text-[10px] text-emerald-100 block">موعد الاستلام</span><b class="text-xs">${fmtDate(payout)}</b></div></div>
      ${cycleRow}
      <div><div class="flex justify-between text-[11px] text-emerald-100 mb-1"><span>المؤكد ${money(collected)}</span><span>من ${money(target)} • ${pct}%</span></div><div class="h-2.5 rounded-full bg-white/25 overflow-hidden"><div class="h-full rounded-full bg-white" style="width:${pct}%"></div></div></div>
      ${action}</div>`;

  const rows = c.turns.map((u, i) => {
    const nSh = sharesOf(c.turns, u);
    if (c.turns.indexOf(u) !== i) return `<div class="p-3 bg-slate-50 border border-slate-100 rounded-xl flex flex-wrap justify-between items-center gap-2 text-xs"><div class="flex items-center gap-3"><span class="w-7 h-7 rounded-full bg-sky-100 text-sky-800 font-bold flex items-center justify-center">${i + 1}</span><div><p class="font-bold">${esc(dispName(state.members[u]))} <span class="text-[10px] text-sky-600">(سهم إضافي)</span></p><p class="text-[10px] text-slate-400">دوره: ${periodLabel(j, i)}</p></div></div>${swapBtn(c, i)}</div>`;
    const m = state.members[u] || { name: '...', email: '' };
    const st = payStatus(c, u), b = badge[st], ac = c.acct[u];
    const nPending = ac.mine.filter(p => p.status === 'pending').length;
    const canReview = nPending > 0 && (c.isRec || c.isCreator);
    const bits = [];
    if (m.phone && canSeeField(m, 'phone')) bits.push(`<span dir="ltr">${esc(m.phone)}${c.isCreator && u !== uid && !m.showPhone ? ' <i class="fa-solid fa-eye-slash" title="للمشرف فقط"></i>' : ''}</span>`);
    if (m.email && canSeeField(m, 'email')) bits.push(`<span dir="ltr">${esc(m.email)}${c.isCreator && u !== uid && !m.showEmail ? ' <i class="fa-solid fa-eye-slash" title="للمشرف فقط"></i>' : ''}</span>`);
    const contact = bits.length ? `<p class="text-[10px] text-slate-500 flex flex-wrap gap-x-3">${bits.join('')}</p>` : '';
    const detail = c.started ? `مدفوع ${fmtNum(ac.paid)} من ${fmtNum(ac.owed)}${ac.credit > 0 ? ` • رصيد مقدّم ${fmtNum(ac.credit)}` : ac.remaining > 0 ? ` • متبقي ${fmtNum(ac.remaining)}` : ''}` : '';
    return `<div class="p-3 bg-slate-50 border border-slate-100 rounded-xl flex flex-wrap justify-between items-center gap-2 text-xs">
      <div class="flex items-center gap-3"><span class="w-7 h-7 rounded-full bg-emerald-100 text-emerald-800 font-bold flex items-center justify-center">${i + 1}</span>
      <div><p class="font-bold">${esc(dispName(m))} ${u === j.creatorUid ? '<span class="text-[10px] text-indigo-600">(مشرف)</span>' : ''}${j.deputyUid && u === j.deputyUid ? '<span class="text-[10px] text-amber-600">(نائب المشرف)</span>' : ''}${nSh > 1 ? ' <span class="text-[10px] text-sky-600">(' + nSh + ' أسهم)</span>' : ''} ${c.canManage ? rateBadge(c, u) : ''}</p><p class="text-[10px] text-slate-400">دوره: ${periodLabel(j, i)}</p>${contact}${detail ? `<p class="text-[10px] text-slate-500">${detail}</p>` : ''}${(c.canManage && relOn()) || u === uid ? statLine(u === uid && state.stats ? state.stats : m.st) : ''}</div></div>
      <div class="flex items-center gap-2 flex-wrap">
        ${c.finished ? '' : `<span class="px-2 py-1 rounded-lg font-bold ${b[1]}">${b[0]}</span>`}
        ${swapBtn(c, i)}
        ${c.canManage ? `<button class="px-2 py-1 bg-slate-100 text-slate-600 rounded-lg" data-act="stmt" data-uid="${esc(u)}" aria-label="كشف"><i class="fa-solid fa-file-lines"></i></button>` : ''}
        ${c.isCreator && u !== j.creatorUid && !ac.mine.length && (!c.started || i > c.cur) ? `<button class="px-2 py-1 bg-rose-50 text-rose-600 rounded-lg" data-act="rm-member" data-uid="${esc(u)}" aria-label="حذف العضو"><i class="fa-solid fa-user-minus"></i> حذف</button>` : ''}
        ${ac.mine.length ? `<button class="${canReview ? 'btn bg-emerald-600 text-white' : 'px-2 py-1 bg-indigo-50 text-indigo-600 rounded-lg'}" data-act="member-pays" data-uid="${esc(u)}"><i class="fa-solid ${canReview ? 'fa-check' : 'fa-paperclip'}"></i> ${canReview ? 'مراجعة وتأكيد (' + nPending + ')' : 'المدفوعات (' + ac.mine.length + ')'}</button>` : ''}
      </div></div>`;
  }).join('');

  const pend = state.jInvites.filter(i => i.status === 'pending').map(i => `<div class="p-3 bg-amber-50 border border-amber-200 rounded-xl text-xs">
      <p class="font-bold">${esc(i.name)}</p>${i.phone ? `<p class="text-slate-600" dir="ltr">${esc(i.phone)}</p>` : ''}${i.email ? `<p class="text-slate-500 break-all" dir="ltr">${esc(i.email)}</p>` : ''}
      <div class="flex gap-1.5 mt-2 flex-wrap"><button class="btn b-pri" data-act="resend" data-id="${esc(i.id)}"><i class="fa-brands fa-whatsapp"></i> إرسال</button><button class="btn b-red" data-act="cancel-inv" data-id="${esc(i.id)}">إلغاء</button></div></div>`).join('');

  const mr = j.modRequest;
  const modBox = mr ? `<div class="bg-indigo-50 border border-indigo-200 p-4 rounded-2xl text-xs space-y-2">
      <p class="font-bold text-indigo-900"><i class="fa-solid fa-circle-exclamation"></i> طلب تعديل من ${esc(mr.byName)}:</p><p class="text-indigo-800">${esc(mr.text)}</p>
      <p class="text-indigo-700">موافقون ${mr.approvals.length} • رافضون ${mr.rejections.length} من ${j.memberUids.length} • الحالة: ${{ pending: 'قيد التصويت', approved: 'مقبول (يطبّقه المشرف)', rejected: 'مرفوض' }[mr.status]}</p>
      <div class="flex gap-2 flex-wrap">${mr.status === 'pending' ? `<button class="btn bg-emerald-600 text-white" data-act="vote-yes">موافق</button><button class="btn bg-rose-600 text-white" data-act="vote-no">غير موافق</button>` : ''}
      ${c.isCreator ? '<button class="btn b-sec" data-act="close-mod">إغلاق الطلب</button>' : ''}</div></div>` : '';

  const sched = Array.from({ length: j.count }, (_, i) => {
    const u = c.turns[i], m = u && state.members[u];
    return `<div class="flex justify-between text-xs py-1.5 border-b border-slate-100 ${i === c.cur && c.started && !c.finished ? 'font-bold text-emerald-700' : ''}"><span>${i + 1}. ${periodLabel(j, i)}</span><span>${m ? esc(dispName(m)) : '— شاغر —'}</span></div>`;
  }).join('');

  const tab = state.jamTab || 'overview', card = (ttl, body) => `<div class="card p-5 space-y-3">${ttl ? `<h4 class="font-black text-sm">${ttl}</h4>` : ''}${body}</div>`;
  const fq = freqOf(j), per = fq.days ? ' من الدورة' : '';
  const info = [['التكرار', fq.label], ['القسط', money(j.amount)], ['آخر موعد للسداد', 'يوم ' + j.lastDay + per], ['موعد الاستلام', 'يوم ' + j.payDay + per], ['البداية', fmtDate(new Date(j.startDate + 'T00:00:00'))], ['الأعضاء', c.turns.length + ' من ' + j.count]];
  const details = card('<i class="fa-solid fa-circle-info text-emerald-600"></i> تفاصيل الجمعية', `<div class="grid grid-cols-2 gap-2">${info.map(([t, v]) => `<div class="p-2.5 bg-slate-50 rounded-xl"><p class="text-[10px] text-slate-500">${t}</p><b class="text-xs">${v}</b></div>`).join('')}</div>`);

  const overview = recBox + swapCard(c) + modBox + details;
  const people = card(`<div class="flex justify-between items-center"><span><i class="fa-solid fa-users text-emerald-600"></i> الأعضاء وترتيب القبض</span><span class="text-xs bg-slate-100 px-2 py-1 rounded-lg font-semibold">${c.turns.length}/${j.count}</span></div>`,
      `${c.isCreator && c.turns.length > 1 ? '<button class="btn b-sec w-full" data-act="order-modal"><i class="fa-solid fa-arrow-down-1-9"></i> تعديل ترتيب القبض</button>' : ''}<div class="space-y-2">${rows}</div>`)
    + (c.canManage ? card('<i class="fa-solid fa-clock-rotate-left text-amber-500"></i> دعوات معلّقة', `<div class="space-y-2">${pend || '<p class="text-xs text-slate-400 text-center py-2">لا توجد دعوات معلّقة.</p>'}</div>`) : '');
  const schedTab = card('<i class="fa-solid fa-calendar-days text-teal-600"></i> الجدول الزمني', `<div>${sched}</div><button class="btn b-sec w-full" data-act="add-cal"><i class="fa-solid fa-calendar-plus"></i> أضف المواعيد للتقويم</button>`);
  const tools = card('<i class="fa-solid fa-toolbox text-slate-500"></i> أدوات', `<div class="grid grid-cols-2 gap-2"><button class="btn b-sec" data-act="export-modal"><i class="fa-solid fa-file-export"></i> تصدير الكشف</button><button class="btn b-sec" data-act="mod-modal"><i class="fa-solid fa-pen-to-square"></i> اقتراح تعديل</button></div>`);
  const mgr = c.canManage ? card('<i class="fa-solid fa-user-gear text-indigo-600"></i> أدوات المشرف', `<div class="grid grid-cols-2 gap-2">
      ${filledOf(j) >= j.count ? '<button class="btn b-sec" data-act="full-note"><i class="fa-solid fa-user-check"></i> اكتمل العدد</button>' : '<button class="btn b-pri" data-act="invite-modal"><i class="fa-solid fa-user-plus"></i> دعوة عضو</button>'}
      <button class="btn b-sec" data-act="remind"><i class="fa-solid fa-bell"></i> تذكير بالبريد</button><button class="btn bg-emerald-50 text-emerald-700" data-act="wa-remind"><i class="fa-brands fa-whatsapp"></i> تذكير واتساب</button>
      ${c.isCreator ? `<button class="btn b-sec" data-act="notif-modal"><i class="fa-solid fa-bullhorn"></i> إشعار للأعضاء</button><button class="btn b-sec" data-act="deputy-modal"><i class="fa-solid fa-user-shield"></i> نائب المشرف</button><button class="btn b-sec" data-act="edit-modal"><i class="fa-solid fa-gear"></i> تعديل</button>${(j.memberUids || []).includes(uid) ? '<button class="btn b-sec col-span-2" data-act="self-leave"><i class="fa-solid fa-right-from-bracket"></i> الخروج من العضوية (أبقى مشرفاً فقط)</button>' : filledOf(j) < j.count ? '<button class="btn b-pri col-span-2" data-act="self-join"><i class="fa-solid fa-user-plus"></i> الانضمام كعضو في جمعيتي</button>' : ''}<button class="btn b-red col-span-2" data-act="delete-modal"><i class="fa-solid fa-trash"></i> حذف الجمعية</button>` : ''}</div>`) : '';
  const more = trustCard(c) + joinCard(c) + sharesCard(c) + wishCard(c) + chatCard(c) + tools + mgr;

  const pendRev = state.payments.filter(p => p.status === 'pending' && (c.isCreator || p.recipientUid === uid)).length, moreN = c.isCreator ? Object.keys(state.shareReqs || {}).length : 0;
  const tabs = [['overview', 'fa-house', 'الرئيسية', 0], ['people', 'fa-users', 'الأعضاء', pendRev], ['sched', 'fa-calendar-days', 'الجدول', 0], ['more', 'fa-ellipsis', 'المزيد', moreN]];
  const bar = `<div class="grid grid-cols-4 gap-1.5 p-1.5 bg-white/95 backdrop-blur rounded-2xl border border-slate-100 shadow-sm sticky top-2 z-10">${tabs.map(([k, ic, lb, n]) => `<button class="relative py-2 rounded-xl text-[11px] font-bold flex flex-col items-center gap-0.5 ${tab === k ? 'bg-emerald-600 text-white' : 'text-slate-500'}" data-act="jam-tab" data-v="${k}"><i class="fa-solid ${ic}"></i>${lb}${n ? `<span class="absolute -top-1 -left-1 min-w-[18px] h-[18px] px-1 rounded-full bg-rose-500 text-white text-[10px] flex items-center justify-center">${n}</span>` : ''}</button>`).join('')}</div>`;
  const body = tab === 'people' ? people : tab === 'sched' ? schedTab : tab === 'more' ? more : overview;
  return `<div class="space-y-4 max-w-2xl mx-auto">
    <div class="flex items-center gap-3"><button class="w-10 h-10 rounded-xl bg-white border border-slate-200 flex-none" data-act="go-home" aria-label="رجوع"><i class="fa-solid fa-arrow-right"></i></button>
      <div class="jicon">${iconHtml(j)}</div><div class="min-w-0"><h2 class="font-black text-lg truncate">${esc(j.name)}</h2><p class="text-[11px] text-slate-500 truncate">${fq.label} • القسط ${money(j.amount)} • ${c.turns.length}/${j.count} أعضاء</p></div></div>
    ${bar}${body}</div>`;
}

/* ---- البريد وكلمة المرور في الملف الشخصي ---- */
function emailCardHtml() {
  const u = state.user; if (!u) return '';
  const em = realEmail(u);
  if (em) {
    if (u.emailVerified) return '';
    return `<div class="card p-5 space-y-3"><h4 class="font-black text-sm"><i class="fa-solid fa-envelope-circle-check text-amber-500"></i> بريدك بانتظار التفعيل</h4>
      <p class="text-xs text-slate-500 leading-relaxed">أرسلنا رابط التفعيل إلى <b dir="ltr">${esc(em)}</b>. بعد تفعيله تعمل الدعوات بالبريد واستعادة كلمة المرور.</p>
      <div class="flex gap-2"><button class="btn b-pri flex-1" data-act="verify-check">تم التفعيل</button><button class="btn b-sec flex-1" data-act="resend-verify">إعادة الإرسال</button></div></div>`;
  }
  const lb = 'text-xs font-semibold block mb-1', pw = hasPassword(u);
  return `<div class="card p-5 space-y-3"><h4 class="font-black text-sm"><i class="fa-solid fa-envelope text-emerald-600"></i> أضف بريدك الإلكتروني</h4>
    <p class="text-xs text-slate-500 leading-relaxed">يتيح لك استعادة كلمة المرور، واستلام الدعوات المرسلة إلى بريدك.</p>
    ${pw ? '<p class="text-xs text-amber-800 leading-relaxed bg-amber-50 border border-amber-200 rounded-xl p-2.5">تنبيه: بعد إضافة البريد يصبح هو وسيلة الدخول بكلمة المرور، ولن يعمل الدخول برقم الجوال وكلمة المرور.</p>' : ''}
    <form id="f-addemail" class="space-y-3">
      <div><label class="${lb}">البريد الإلكتروني</label><input name="email" type="email" dir="ltr" inputmode="email" autocomplete="email" class="inp" required></div>
      ${pw ? '' : `<div><label class="${lb}">كلمة مرور للدخول بالبريد</label><input name="password" type="password" minlength="6" class="inp" required autocomplete="new-password" placeholder="6 أحرف على الأقل"></div>`}
      <button class="btn b-pri w-full py-3" type="submit">أضف البريد وأرسل رابط التفعيل</button></form></div>`;
}
function passCardHtml() {
  const u = state.user; if (!u || !hasPassword(u)) return '';
  return `<div class="card p-5 space-y-3"><h4 class="font-black text-sm"><i class="fa-solid fa-key text-slate-700"></i> كلمة المرور</h4>
    <form id="f-changepass" class="space-y-3"><div><label class="text-xs font-semibold block mb-1">كلمة مرور جديدة</label><input name="password" type="password" minlength="6" class="inp" required autocomplete="new-password" placeholder="6 أحرف على الأقل"></div>
    <button class="btn b-sec w-full" type="submit">تغيير كلمة المرور</button></form></div>`;
}
async function submitChangePass(f) {
  const u = auth.currentUser, pass = f.password.value;
  if (!u || !hasPassword(u)) return;
  if (pass.length < 6) return toast('كلمة المرور 6 أحرف على الأقل', 'error');
  const btn = f.querySelector('button[type=submit]'); btn.disabled = true;
  try { await u.updatePassword(pass); f.reset(); toast('تم تغيير كلمة المرور ✓', 'success'); }
  catch (e) { toast(e.code === 'auth/requires-recent-login' ? 'سجّل الخروج وادخل من جديد، ثم أعد تغيير كلمة المرور' : authErr(e), 'error'); }
  finally { btn.disabled = false; }
}
async function submitAddEmail(f) {
  const u = auth.currentUser, email = lc(f.email.value);
  if (!u || realEmail(u)) return;
  const pw = hasPassword(u);
  if (!validEmail(email)) return toast('البريد غير صحيح', 'error');
  if (!pw && f.password.value.length < 6) return toast('كلمة المرور 6 أحرف على الأقل', 'error');
  const btn = f.querySelector('button[type=submit]'); btn.disabled = true;
  try {
    if (pw) await u.updateEmail(email); // يحتفظ بكلمة المرور الحالية
    else await u.linkWithCredential(firebase.auth.EmailAuthProvider.credential(email, f.password.value)); // نفس الحساب
    await u.sendEmailVerification({ url: appUrl() }).catch(() => {});
    await db.collection('users').doc(u.uid).update({ email });
    state.user = auth.currentUser; state.profile = { ...state.profile, email };
    try { localStorage.setItem('jm_email', email); } catch (e) {}
    toast('أضفنا بريدك. افتح رابط التفعيل لتعمل الدعوات بالبريد', 'success');
    render();
  } catch (e) { toast(e.code === 'auth/requires-recent-login' ? 'سجّل الخروج وادخل من جديد ثم أعد إضافة البريد' : authErr(e), 'error'); }
  finally { btn.disabled = false; }
}
/* ============ التخزين المحلي للحساب: عرض فوري ثم تحديث من السيرفر ============ */
const CACHE_KEY = 'siwaa_cache_v1';
const readCache = () => { try { return JSON.parse(localStorage.getItem(CACHE_KEY) || 'null'); } catch (e) { return null; } };
const clearCache = () => { try { localStorage.removeItem(CACHE_KEY); } catch (e) {} };
let _cacheT = null;
function scheduleCache() { clearTimeout(_cacheT); _cacheT = setTimeout(saveCache, 500); }
function saveCache() {
  if (!state.user || !state.profile) return;
  try {
    localStorage.setItem(CACHE_KEY, JSON.stringify({
      uid: state.user.uid, profile: state.profile, isAdmin: !!state.isAdmin,
      jamiyat: state.jamiyat || [], jamiyatArch: state.jamiyatArch || [],
      qattahs: QT.list || [], qattahsArch: QT.arch || [],
      debts: DB.list || [], debtsArch: DB.arch || []
    }));
  } catch (e) {}
}
function setJamiyat(all) {
  const act = [], arch = [];
  all.forEach(j => (j.archivedAt ? arch : act).push(j));
  state.jamiyat = act; state.jamiyatArch = arch;
}
// تسجيل الدخول: إن وُجدت نسخة محلية لنفس الحساب تُعرض فوراً، ثم يُتحقق من السيرفر في الخلفية
async function bootUser(user) {
  const c = readCache();
  if (!user) clearCache();
  if (user && c && c.uid === user.uid && c.profile) {
    cleanup(state.unsubs); cleanup(state.jUnsubs); stopPayListeners(); state.pays = {}; stopBlockWatch(); stopHeartbeat(); state._tv = null; stopQattah(); stopDebts();
    state.user = user; state.profile = c.profile; state.isAdmin = !!c.isAdmin; state._restoreTried = false;
    state.jamiyat = c.jamiyat || []; state.jamiyatArch = c.jamiyatArch || []; state.invites = [];
    QT.list = c.qattahs || []; QT.arch = c.qattahsArch || []; DB.list = c.debts || []; DB.arch = c.debtsArch || [];
    maybeLock(true); watchBlocked(); trackSession(); renderBanner();
    startListeners(); startQattahListeners(); startDebtListeners();
    state.view = state.isAdmin ? 'admin' : (launchAction() || 'home');
    render(); if (state.isAdmin) loadAdmin();
    checkPendingJoin();
    refreshAccount(user);
    return;
  }
  return bootUserFull(user);
}
async function refreshAccount(user) {
  try {
    if (isVerified(user)) await user.getIdToken(true).catch(() => {});
    const snap = await db.collection('users').doc(user.uid).get({ source: 'server' }).catch(() => null);
    if (!snap) return; // لا اتصال: نبقى على البيانات المحفوظة
    if (!snap.exists) { clearCache(); return bootUserFull(user); }
    state.profile = snap.data();
    const adm = await db.collection('admins').doc(user.uid).get({ source: 'server' }).catch(() => ({ exists: false }));
    state.isAdmin = adm.exists || (lc(user.email) === OWNER_EMAIL && user.emailVerified);
    if (!state.isAdmin && await isBlockedNow()) return;
    renderNav(); if (state.view === 'home') render(true);
  } catch (e) {}
}

/* ============ الأرشيف: المنتهي ينتقل تلقائياً، ويعيده المشرف متى شاء ============ */
const archToday = () => isoDay(new Date());
const archFin = {
  jam: j => j.type === 'family'
    ? (j.closed === true || (j.mode !== 'monthly' && !!j.endDate && famState(j).ended))
    : (!!j.startDate && monthIdx(j) >= j.count),
  qt: q => !!q.eventEnd && q.eventEnd < archToday(),
  db: d => d.status === 'closed' || d.status === 'declined'
};
let _archT = null;
function scheduleArchive() { clearTimeout(_archT); _archT = setTimeout(archiveSync, 1500); }
async function archiveSync() {
  if (!state.user || !state.profile) return;
  const me = state.user.uid, b = db.batch(); let n = 0;
  const plan = (col, items, mine, fin) => items.forEach(it => {
    if (!mine(it)) return;
    const want = fin(it), archived = !!it.archivedAt, ref = db.collection(col).doc(it.id);
    if (want && !archived && !it.archiveSkip) { b.update(ref, { archivedAt: new Date().toISOString(), archivedBy: me, archiveAuto: true }); n++; }
    else if (!want && archived && it.archiveAuto) { b.update(ref, { archivedAt: FV.delete(), archivedBy: FV.delete(), archiveAuto: FV.delete() }); n++; }
    else if (!want && it.archiveSkip) { b.update(ref, { archiveSkip: FV.delete() }); n++; }
  });
  plan('jamiyat', [...state.jamiyat, ...(state.jamiyatArch || [])], j => j.creatorUid === me, archFin.jam);
  plan(QT_COL, [...QT.list, ...(QT.arch || [])], q => q.adminUid === me, archFin.qt);
  plan(DB_COL, [...DB.list, ...(DB.arch || [])], d => d.creatorUid === me, archFin.db);
  if (n) b.commit().catch(e => console.warn('الأرشفة: تعذر الحفظ', e && e.code));
}
async function archRestore(el) {
  const kind = el.dataset.kind, id = el.dataset.id;
  const col = kind === 'jam' ? 'jamiyat' : kind === 'qt' ? QT_COL : DB_COL;
  try {
    await db.collection(col).doc(id).update({ archivedAt: FV.delete(), archivedBy: FV.delete(), archiveAuto: FV.delete(), archiveSkip: true });
    toast('أُعيد إلى القائمة الرئيسية', 'success');
  } catch (e) { toast('تعذرت الإعادة: ' + (e.code === 'permission-denied' ? 'صلاحية غير كافية' : e.message), 'error'); }
}
const ARCH_ACTIONS = { 'go-archive': () => { state.view = 'archive'; render(); }, 'arch-restore': archRestore };
function vArchive() {
  const me = state.user.uid;
  const row = (kind, title, sub, id, mine, openAct) => `<div class="pf-row" style="cursor:default">
    <span class="pf-ic ${kind === 'jam' ? '' : 'warn'}"><i class="fa-solid ${kind === 'jam' ? 'fa-people-roof' : kind === 'qt' ? 'fa-hand-holding-dollar' : 'fa-scale-balanced'}"></i></span>
    <span class="pf-tx"><b>${esc(title)}</b><small>${sub}</small></span>
    <span class="flex gap-1.5 flex-none"><button type="button" class="btn b-sec" data-act="${openAct}" data-id="${esc(id)}">عرض</button>${mine ? `<button type="button" class="btn b-pri" data-act="arch-restore" data-kind="${kind}" data-id="${esc(id)}">إعادة</button>` : ''}</span></div>`;
  const jam = (state.jamiyatArch || []).map(j => row('jam', j.name, `${j.type === 'family' ? 'تعاون عائلي' : 'جمعية'} • ${j.type === 'family' ? (j.reached ? 'اكتمل الهدف' : 'أُغلق') : 'انتهت جميع الدورات'}`, j.id, j.creatorUid === me, 'open'));
  const qt = (QT.arch || []).map(q => row('qt', q.name, `قطة • انتهت الفعالية في ${esc(q.eventEnd)}`, q.id, q.adminUid === me, 'qt-open'));
  const dbs = (DB.arch || []).map(d => row('db', d.counterName || d.creatorName || 'دين', `${d.status === 'declined' ? 'مرفوض' : 'مسدّد أو مُعفى'} • ${fmtNum(d.amount)} ريال`, d.id, d.creatorUid === me, 'db-open'));
  const sec = (title, items) => items.length ? `<section class="pf-group"><div class="pf-title">${title} (${nf(items.length)})</div>${items.join('')}</section>` : '';
  const none = jam.length + qt.length + dbs.length === 0;
  return `<div class="pf fade">
    <p class="text-xs text-slate-500 leading-relaxed px-1">العناصر المنتهية تُنقل هنا تلقائياً: الجمعيات بعد اكتمال دوراتها، والتعاون بعد بلوغ هدفه أو إغلاقه أو انتهاء مدته، والقطة بعد انتهاء فعاليتها، والديون بعد سدادها أو إعفائها أو رفضها. يمكن للمشرف إعادة أي عنصر متى شاء.</p>
    ${none ? '<div class="card p-8 text-center text-xs text-slate-500"><i class="fa-solid fa-box-archive text-2xl mb-2 block text-slate-300"></i>لا توجد عناصر في الأرشيف</div>' : ''}
    ${sec('الجمعيات والتعاون', jam)}${sec('القطات', qt)}${sec('الديون', dbs)}
  </div>`;
}

