/* التحكم */
const ADMIN_RULES = `// أضِف هذه القواعد داخل: match /databases/{database}/documents { ... }
function signedIn() { return request.auth != null; }
function isOwner() { return signedIn() && request.auth.token.email == "${OWNER_EMAIL}" && request.auth.token.email_verified == true; }
function isAdm() { return isOwner() || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))); }

match /activity/{uid} {
  allow read: if isAdm() || (signedIn() && request.auth.uid == uid);
  allow write: if signedIn() && request.auth.uid == uid;
}
match /events/{id} {
  allow read: if isAdm();
  allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
}
match /stats/{day} {
  allow read: if isAdm();
  allow create: if request.resource.data.keys().hasOnly(['day','visits','pv','logins','dau','regs','pwa','dev','os','br','src','hours','views']);
  allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['day','visits','pv','logins','dau','regs','pwa','dev','os','br','src','hours','views']);
}
match /blocked/{uid} {
  allow read: if isAdm() || (signedIn() && request.auth.uid == uid);
  allow write: if isAdm();
}
match /admin_notes/{id} { allow read, write: if isAdm(); }
match /settings/{id} { allow read: if true; allow write: if isAdm(); }
match /admins/{uid} {
  allow read: if signedIn() && (request.auth.uid == uid || isAdm());
  allow write: if isOwner();
}
// ملاحظة: يجب أن تسمح قواعد users و jamiyat الحالية للمشرف بقراءة كل المستندات (كما تعمل اللوحة اليوم).`;
