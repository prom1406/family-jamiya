function famAmtAt(pl, k) { const h = Array.isArray(pl.hist) ? pl.hist : null; if (!h || !h.length) return Number(pl.amount) || 0; let a = Number(h[0].a) || 0; h.forEach(x => { if (Number(x.c) <= k) a = Number(x.a) || 0; }); return a; }
const famOwed = (j, pl) => { if (!pl) return 0; if (j.mode !== 'monthly') return Number(pl.amount) || 0; const from = Number(pl.from) || 0, cur = famCycle(j); let t = 0; for (let k = from; k <= cur; k++) t += famAmtAt(pl, k); return r2(t); };
function famState(j) {
  if (j.mode === 'monthly') return { monthly: true, end: null, ended: false, open: !j.closed, left: 0, cycle: famCycle(j), reached: !!j.reached };
  const end = famEnd(j), now = Date.now(), ended = now > end.getTime(); return { monthly: false, end, ended, open: !j.closed && !ended, left: Math.max(0, Math.ceil((end.getTime() - now) / DAY_MS)) };
}
// إجمالي المؤكد دون دفعة بعينها: يمنع عدّها مرتين إن كانت لقطة Firestore قد حدّثت state.payments قبل الفحص
const famConfirmedExcept = id => r2(state.payments.filter(p => p.status === 'confirmed' && p.id !== id).reduce((t, p) => t + (Number(p.amount) || 0), 0));
// يُغلق التعاون الشهري تلقائياً فقط عند بلوغ المؤكد للهدف ولا يبقى أي إيصال معلّق (exceptId: الدفعة الجارية، add: مبلغها إن صارت مؤكدة)
const famAutoClose = (j, exceptId, add) => j.type === 'family' && j.mode === 'monthly' && !j.closed && Number(j.targetAmount) > 0
  && r2(famConfirmedExcept(exceptId) + (Number(add) || 0)) >= Number(j.targetAmount) && !state.payments.some(p => p.status === 'pending' && p.id !== exceptId);
