  const empty = t => `<div class="text-center py-8 text-slate-400"><i class="fa-regular fa-bell-slash text-3xl mb-2 block"></i><p class="text-xs">${t}</p></div>`;
  let body;
  if (tab === 'alerts') body = A.length ? `<div class="space-y-2.5">${A.map(a => `<div class="p-4 ${ALERT_ST[a.lvl][0]} border rounded-2xl text-xs space-y-2.5">
      <div class="min-w-0"><p class="font-bold text-sm"><i class="fa-solid ${ALERT_ST[a.lvl][1]}"></i> ${esc(a.title)}</p><p class="text-slate-600 mt-0.5 leading-relaxed">${esc(a.text)}</p></div>
      <div class="flex gap-2"><button class="btn b-sec" data-act="alert-go" data-id="${esc(a.id)}">فتح الجمعية</button>${a.remind ? `<button class="btn bg-emerald-50 text-emerald-700" data-act="alert-remind" data-id="${esc(a.id)}"><i class="fa-brands fa-whatsapp"></i> تذكير</button>` : ''}</div></div>`).join('')}</div>` : empty('لا توجد مواعيد قريبة 🎉');
  else body = N.length ? `<div class="space-y-2">${N.map(n => `<button class="w-full text-right p-3 rounded-2xl border text-xs ${n.read !== true ? 'bg-teal-50 border-teal-200' : 'bg-slate-50 border-slate-100'}" data-act="inbox-go" data-id="${esc(n.jid || '')}">
      <div class="flex justify-between gap-2"><b><i class="fa-solid ${KIND_IC[n.kind] || 'fa-bell text-slate-500'}"></i> ${esc(n.title)}</b><span class="text-[10px] text-slate-400 flex-none">${ago(tsd(n.createdAt))}</span></div>
      <p class="text-slate-600 mt-1 leading-relaxed">${esc(n.body)}</p></button>`).join('')}</div><button class="btn b-sec w-full" data-act="inbox-clear"><i class="fa-solid fa-trash-can"></i> مسح الكل</button>` : empty('لا توجد إشعارات بعد');
  showModal('التنبيهات', chips + body);
  if (tab === 'inbox') markInboxRead();
}
async function clearInbox() {
