/* ============ المصادقة ============ */
auth.onAuthStateChanged(async user => { if (state._registering) return; await bootUser(user); });
async function bootUserFull(user) {
  cleanup(state.unsubs); cleanup(state.jUnsubs); stopPayListeners(); state.pays = {}; stopBlockWatch(); stopHeartbeat(); state._tv = null; stopQattah(); stopDebts();
  state.user = user; state.profile = null; state.isAdmin = false; state._restoreTried = false;
  state.jamiyat = []; state.jamiyatArch = []; state.invites = [];
  if (!user) { unlock(); state.view = 'auth'; return render(); }

  let loadErr = null;
  try {
    // تحديث الرمز ليحمل حالة تفعيل البريد الحالية، وإلا ترفض القواعد القراءة حتى ساعة بعد التفعيل
    if (isVerified(user)) await user.getIdToken(true).catch(() => {});
    let snap = await db.collection('users').doc(user.uid).get();
    if (!snap.exists && snap.metadata && snap.metadata.fromCache) snap = await db.collection('users').doc(user.uid).get({ source: 'server' }); // لا نصدّق «غير موجود» القادم من الذاكرة المؤقتة
    state.profile = snap.exists ? snap.data() : null;
    const adm = await db.collection('admins').doc(user.uid).get().catch(() => ({ exists: false }));
    state.isAdmin = adm.exists || (lc(user.email) === OWNER_EMAIL && user.emailVerified);
  } catch (e) { loadErr = e; toast('تعذر تحميل الحساب: ' + e.message, 'error'); }

  // فشلت قراءة الملف الشخصي: لا ننشئ ملفاً جديداً حتى لا نمسح بيانات حساب قديم موجود، ونطلب إعادة المحاولة
  if (loadErr && !state.profile) { state.view = 'loaderr'; return render(); }
  if (!state.isAdmin && await isBlockedNow()) return;
  if (!state.profile && user.displayName) { if (!(await autoProfile(user, user.displayName))) return; }
  if (!state.profile) { state.view = 'complete'; return render(); }
  maybeLock(true); watchBlocked(); trackSession(); renderBanner();
  claimPhone(user.uid, state.profile.phone);
  startListeners();
  startQattahListeners();
  startDebtListeners();
  if (state.isAdmin) { state.view = 'admin'; render(); loadAdmin(); toast('مرحباً بك في لوحة المالك', 'info'); return; }
  state.view = launchAction() || 'home'; render();
  checkPendingJoin();
}

/* حجز رقم الجوال: مستند في phones/{الرقم} يحمل uid صاحبه، فلا يمكن لحسابين استخدام نفس الرقم */
async function saveProfileWithPhone(uid, data, mode, oldPhone) {
  const phoneRef = db.collection('phones').doc(data.phone), userRef = db.collection('users').doc(uid);
  await db.runTransaction(async t => {
    const ps = await t.get(phoneRef);
    if (ps.exists && ps.data().uid !== uid) throw new Error('PHONE_TAKEN');
    if (oldPhone && oldPhone !== data.phone) t.delete(db.collection('phones').doc(oldPhone));
    t.set(phoneRef, { uid });
    if (mode === 'update') t.update(userRef, data); else t.set(userRef, data);
  });
}
async function claimPhone(uid, phone) { // للحسابات القديمة: يحجز رقمها بصمت إن لم يكن محجوزاً
  try { if (!validPhone(phone)) return; const r = db.collection('phones').doc(phone); const x = await r.get(); if (!x.exists) await r.set({ uid }); } catch (e) {}
}
const PHONE_TAKEN_MSG = 'رقم الجوال هذا مسجّل مسبقاً بحساب آخر';
const phoneSaveErr = e => e && e.message === 'PHONE_TAKEN' ? PHONE_TAKEN_MSG : (e && e.code === 'permission-denied' ? 'تعذر حجز رقم الجوال: انشر قواعد Firestore الجديدة (مجموعة phones) ثم أعد المحاولة' : (e && e.message) || 'خطأ غير معروف');

function cleanup(arr) { arr.forEach(u => u()); arr.length = 0; }

// استعادة بيانات حساب فُرّغ ملفه (الجوال والبنك) من نسخته المحفوظة في ملف عضويته داخل جمعياته
async function maybeRestoreProfile() {
  const p = state.profile; if (!p || !state.user || state._restoreTried || state.isAdmin || !state.jamiyat.length) return;
  if (validPhone(normPhone(p.phone))) return;
  state._restoreTried = true;
  for (const j of state.jamiyat) {
    try {
      const sn = await db.collection('jamiyat').doc(j.id).collection('members').doc(state.user.uid).get(), m = sn.exists ? sn.data() : null;
      if (!m || !validPhone(normPhone(m.phone))) continue;
      const upd = { name: (m.name || p.name || '').trim() || p.name, phone: normPhone(m.phone), bank: m.bank || '', iban: m.iban || '', waOptIn: m.waOptIn !== false, nick: m.nick || '', showAs: (m.showAs === 'nick' && m.nick) ? 'nick' : 'name', showPhone: !!m.showPhone, showEmail: !!m.showEmail };
      await saveProfileWithPhone(state.user.uid, upd, 'update', null);
      state.profile = { ...p, ...upd }; toast('استُعيدت بياناتك (الجوال والحساب البنكي) من جمعياتك', 'success'); renderBanner(); render(); return;
    } catch (e) { /* ننتقل للجمعية التالية */ }
  }
}
function startListeners() {
  const uid = state.user.uid, email = realEmail(state.user), phone = phone05FromUser(state.user), ver = isVerified(state.user);
  let invA = [], invB = [], jA = [], jB = [];
  const mergeJ = () => { const m = new Map(); [...jA, ...jB].forEach(x => m.set(x.id, x)); setJamiyat([...m.values()]); maybeRestoreProfile(); syncPayListeners(); schedStats(); if (state.view === 'home') render(true); else renderNav(); };
  const merge = () => { const m = new Map(); [...invA, ...invB].forEach(i => m.set(i.id, i)); state.invites = [...m.values()];
    state.invites.forEach(i => pushLocal('دعوة جديدة للانضمام', `دعاك ${i.inviterName || ''} إلى جمعية «${i.jamiyaName || ''}»`, 'inv_' + i.id)); if (state.view === 'home') render(true); };
  state.unsubs.push(
    db.collection('jamiyat').where('memberUids', 'array-contains', uid).onSnapshot(s => {
      jA = s.docs.map(d => ({ id: d.id, ...d.data() })); mergeJ();
    }, e => toast('خطأ في تحميل الجمعيات: ' + e.message, 'error')),
    db.collection('jamiyat').where('creatorUid', '==', uid).onSnapshot(s => {
      jB = s.docs.map(d => ({ id: d.id, ...d.data() })); mergeJ();
    }, e => console.warn('تعذر تحميل الجمعيات التي أشرف عليها (تحقق من قواعد Firestore):', e.code)),
    ...(state.user.emailVerified && email ? [db.collection('invites').where('email', '==', email).where('status', '==', 'pending').onSnapshot(s => {
      invA = s.docs.map(d => ({ id: d.id, ...d.data() })); merge();
    }, e => toast('خطأ في تحميل الدعوات: ' + e.message, 'error'))] : [])
  );
  listenNotifs(); registerPush();
  if (ver && validPhone(phone)) state.unsubs.push(
    db.collection('invites').where('phone', '==', phone).where('status', '==', 'pending').onSnapshot(s => {
      invB = s.docs.map(d => ({ id: d.id, ...d.data() })); merge();
    }, e => toast('تعذر تحميل دعوات الجوال: تحقق من قواعد Firestore (' + e.code + ')', 'error'))
  );
}

// إنشاء الملف الشخصي تلقائياً بالحد الأدنى (الاسم والبريد)، وباقي البيانات تُطلب عند الحاجة فقط
// حساب جوال لا يحق له الدخول (رقم محجوز لحساب آخر): نحذفه حتى لا يبقى يتيماً
async function discardPhoneAccount() {
  try { if (auth.currentUser && !auth.currentUser.email) await auth.currentUser.delete(); } catch (e) {}
  await auth.signOut().catch(() => {});
}
async function autoProfile(u, name) {
  if (state.settings.regClosed && !state.isAdmin) { toast(state.settings.regMsg || 'التسجيل الجديد متوقف مؤقتاً', 'error'); await auth.signOut().catch(() => {}); return false; }
  const ph = phone05FromUser(u);
  const profile = { name, email: realEmail(u), phone: ph, bank: '', iban: '', waOptIn: false, nick: '', showAs: 'name', showPhone: false, showEmail: false, avatar: u.photoURL || '', ownerNotified: false, createdAt: FV.serverTimestamp() };
  let existing = null;
  try {
    const ref = db.collection('users').doc(u.uid), pref = ph ? db.collection('phones').doc(ph) : null;
    await db.runTransaction(async t => {
      const sn = await t.get(ref); if (sn.exists) { existing = sn.data(); return; } // إنشاء فقط إن لم يكن الملف موجوداً
      if (pref) { const ps = await t.get(pref); if (ps.exists && ps.data().uid !== u.uid) throw new Error('PHONE_TAKEN'); t.set(pref, { uid: u.uid }); }
      t.set(ref, profile);
    });
