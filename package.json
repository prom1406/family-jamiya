/* المستخدمون */
const UF = [['all', 'الكل'], ['online', 'متصل الآن'], ['active7', 'نشط 7 أيام'], ['idle', 'خامل +30 يوماً'], ['never', 'لم يدخل بعد'], ['blocked', 'محظور'], ['noted', 'عليه ملاحظات']];
function filteredUsers() {
