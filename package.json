async function submitPledge(f) {
  const c = ctx(); if (!c || !c.family) return; const j = c.j, gid = f.gid ? f.gid.value : '', G = gid ? state.guests[gid] : null, uid = gid || state.user.uid, fs = famState(j), mo = fs.monthly, fixed = Number(j.monthlyAmount) || 0, old = gid ? state.pledges[gid] : famPledgeOf(uid);
  if (gid && (!G || !c.isCreator)) return;
  const amount = Math.round(parseFloat(f.amount.value) * 100) / 100;
  if (!fs.open) return toast('باب المساهمة مغلق', 'error');
  if (!(amount >= 1)) return toast('المبلغ غير صحيح', 'error');
  if (mo && fixed && amount !== fixed) return toast('الاشتراك الشهري ثابت ومحدد من المشرف', 'error');
  const sm = famSums(uid), paid = r2(sm.conf + sm.pend);
  if (!mo && amount < paid) return toast(`لا يقل المبلغ عما سددته (${fmtNum(paid)} ريال)`, 'error');
  const doc = { uid, amount, updatedAt: FV.serverTimestamp() };
  if (mo) {
    const cyc = famCycle(j); doc.from = old ? (Number(old.from) || 0) : cyc; doc.chk = cyc;
    if (old) { // تعديل: يسري من الشهر الحالي ويحفظ ما سبق
      const h = (Array.isArray(old.hist) && old.hist.length ? old.hist : [{ c: Number(old.from) || 0, a: Number(old.amount) || 0 }]).map(x => ({ c: Number(x.c), a: Number(x.a) })).filter(x => x.c < cyc);
      if (!h.length || h[h.length - 1].a !== amount) h.push({ c: Math.max(cyc, h.length ? 0 : doc.from), a: amount });
      if (h.length > 1) doc.hist = h; // مقطع واحد = مبلغ ثابت، فلا حاجة للسجل
    }
  }
  const first = !old, w = mo ? 'قيمته الشهرية' : 'مساهمته';
  try {
    await jref().collection('pledges').doc(uid).set(doc);
    closeModal(); toast(G ? 'سُجّل تعهد ' + G.name : first ? (mo ? 'تم تثبيت قيمتك الشهرية' : 'تم تحديد مساهمتك') : 'تم التحديث');
    if (G) return jlog(j.id, 'pledge', `${dispName(state.profile)} سجّل تعهد ${G.name} بمبلغ ${fmtNum(amount)} ريال${mo ? ' شهرياً' : ''}`);
    jlog(j.id, 'pledge', `${dispName(state.profile)} ${first ? 'حدد' : 'عدّل'} ${w} بمبلغ ${fmtNum(amount)} ريال`);
    sendNotifs([j.creatorUid], first ? 'تعهد جديد بمساهمة' : 'تعديل مبلغ مساهمة', `${dispName(state.profile)} ${first ? 'حدد' : 'عدّل'} ${w} في «${j.name}»: ${fmtNum(amount)} ريال${mo ? ' شهرياً' : ''}`, j.id, 'pledge');
  } catch (e) { toast(e.code === 'permission-denied' ? 'تعذر الحفظ: التعاون مغلق أو لم تُنشر قواعد Firestore المحدّثة' : 'تعذر الحفظ: ' + e.message, 'error'); }
}
