/* ============ دفع الإشعارات للجوال المغلق (FCM) ============
   الصق هنا مفتاح الويب (Web Push certificate / VAPID) من: Firebase ← إعدادات المشروع ← Cloud Messaging */
const VAPID_KEY = 'BG6l6SR11DQISd1WtcgOLJSS6rVbTN5uudknpGyt8yZBhYqCnjQpaJ9QKC6QQuILPbvtUWVpWnSroZFrSCJsYPM';
// تطبيق iOS: طلب الإذن تلقائياً (نافذة آبل) ثم تسجيل رمز FCM في حساب المستخدم
function nativePushListeners() {
  const p = NP(); if (!p || state._npl) return; state._npl = true;
  p.addListener('tokenReceived', e => { if (e && e.token && state.user) { state._tok = e.token; db.collection('users').doc(state.user.uid).set({ fcmTokens: FV.arrayUnion(e.token) }, { merge: true }).catch(() => {}); } });
  p.addListener('notificationActionPerformed', e => {
    const d = (e && e.notification && e.notification.data) || {}, id = d.jid || d.jamiyaId || d.id;
    if (id) { openNotifTarget(String(id)); setTimeout(() => { if (state.profile && !state.j && !state.view.startsWith('q')) openNotifTarget(String(id)); }, 1500); }
  });
}
async function nativePushRegister(force, ask) {
  try {
    const p = NP(); if (!p || !state.user) return { ok: false, err: 'unsupported' };
    nativePushListeners();
    let perm = (await p.checkPermissions()).receive;
    if (perm !== 'granted' && perm !== 'denied' && ask) perm = (await p.requestPermissions()).receive;
    state._nperm = perm === 'granted' ? 'granted' : perm === 'denied' ? 'denied' : 'prompt';
    if (state._nperm !== 'granted') { if (state.view === 'profile') render(); return { ok: false, err: 'permission-' + state._nperm }; }
    if (lsGet('jm_notif') === null || force) lsSet('jm_notif', '1');
    const tok = (await p.getToken()).token;
    if (!tok) return { ok: false, err: 'no-token' };
    state._tok = tok; // يُستخدم في «الإقرار» حتى لا يكرر الخادم إشعاراً سلّمه التطبيق المفتوح
    const key = state.user.uid + ':' + tok;
    if (force || state._pushReg !== key) { await db.collection('users').doc(state.user.uid).set({ fcmTokens: FV.arrayUnion(tok) }, { merge: true }); state._pushReg = key; }
    return { ok: true };
  } catch (e) { console.warn('native push', e.code || e.message); return { ok: false, err: e.code || e.message }; }
}
async function registerPush(force) {
  if (IS_NATIVE) return nativePushRegister(!!force, true);
  try {
    if (!VAPID_KEY || !state.user || !notifOn() || !firebase.messaging || !(await firebase.messaging.isSupported())) return { ok: false, err: 'unsupported' };
    const reg = await navigator.serviceWorker.ready;
    const tok = await firebase.messaging().getToken({ vapidKey: VAPID_KEY, serviceWorkerRegistration: reg });
    if (!tok) return { ok: false, err: 'no-token' };
    state._tok = tok;
    const key = state.user.uid + ':' + tok;
    if (force || state._pushReg !== key) { await db.collection('users').doc(state.user.uid).set({ fcmTokens: FV.arrayUnion(tok) }, { merge: true }); state._pushReg = key; }
    return { ok: true };
  } catch (e) { console.warn('push', e.code || e.message); return { ok: false, err: e.code || e.message }; }
}
// عند تسجيل الخروج: نفكّ ارتباط هذا الجهاز بالحساب ونُلغي رمزه، فيبدأ الحساب التالي برمز جديد نظيف
async function unregisterPush() {
  if (IS_NATIVE) {
    try {
      const p = NP(); if (!p || !state.user || nativePerm() !== 'granted') return;
      const tok = (await p.getToken()).token;
      if (tok) await db.collection('users').doc(state.user.uid).update({ fcmTokens: FV.arrayRemove(tok) });
      await p.deleteToken(); state._pushReg = '';
    } catch (e) { console.warn('unpush native', e.code || e.message); }
    return;
  }
  try {
    if (!state.user || !VAPID_KEY || !notifSupported() || Notification.permission !== 'granted' || !firebase.messaging || !(await firebase.messaging.isSupported())) return;
    const m = firebase.messaging(), reg = await navigator.serviceWorker.ready;
    const tok = await m.getToken({ vapidKey: VAPID_KEY, serviceWorkerRegistration: reg });
    if (tok) await db.collection('users').doc(state.user.uid).update({ fcmTokens: FV.arrayRemove(tok) });
    await m.deleteToken(); state._pushReg = '';
  } catch (e) { console.warn('unpush', e.code || e.message); }
}
/* ============ مركز الإشعارات: مستند لكل إشعار يصل للمستلم (يُسلَّم فور فتح التطبيق أو وهو في الخلفية) ============ */
async function sendNotifs(uids, title, body, jid, kind, tag) {
  const me = state.user && state.user.uid;
  const list = [...new Set(uids || [])].filter(u => u && u !== me);
  if (!list.length) return 0;
  try {
    for (let i = 0; i < list.length; i += 400) {
      const b = db.batch();
      list.slice(i, i + 400).forEach(to => b.set(db.collection('notifs').doc(), { toUid: to, fromUid: me, title: String(title).slice(0, 100), body: String(body).slice(0, 500), jid: jid || '', kind: kind || 'info', tag: tag || '', pushed: false, read: false, createdAt: FV.serverTimestamp() }));
      await b.commit();
    }
    return list.length;
  } catch (e) { console.warn('notif', e.code || e.message); return 0; }
}
// معرّف هذا الجهاز: بصمة رمز FCM (يطابقها الخادم) + معرّف محلي احتياطي. كل جهاز يؤكد استلامه بنفسه دون أن يمنع الدفع لبقية أجهزة الحساب
const devId = () => { let d = lsGet('jm_dev'); if (!d) { d = 'd' + Math.random().toString(36).slice(2, 12); lsSet('jm_dev', d); } return d; };
const devKeys = () => [devId(), ...(state._tok ? [state._tok.slice(-24)] : [])];
const ackedHere = n => Array.isArray(n.ack) && devKeys().some(k => n.ack.includes(k));
const nSecs = n => (n.createdAt && n.createdAt.seconds) || 0;
const unreadCount = () => (state.inbox || []).filter(n => n.read !== true).length;
function listenNotifs() {
  const uid = state.user.uid; state.nq = []; state.inbox = []; state._pruned = new Set();
  state.unsubs.push(db.collection('notifs').where('toUid', '==', uid).onSnapshot(s => {
    const all = s.docs.map(d => ({ id: d.id, ...d.data() })).sort((a, b) => nSecs(b) - nSecs(a));
    state.inbox = all.filter(n => n.kind !== 'chatmsg'); // رسائل الدردشة تُنبَّه فقط ولا تزاحم صندوق الإشعارات
    all.filter(n => n.kind === 'chatmsg' && nSecs(n) && Date.now() / 1000 - nSecs(n) > 600 && !state._pruned.has(n.id)).forEach(n => { state._pruned.add(n.id); db.collection('notifs').doc(n.id).delete().catch(() => {}); });
    s.docChanges().forEach(c => {
      if (c.type !== 'added' || c.doc.metadata.hasPendingWrites) return;
      const n = { id: c.doc.id, ...c.doc.data() };
      // يُعرض محلياً إن لم يدفعه الخادم لجهاز المستخدم (أو لم يكن للمستخدم جهاز مسجّل)
      if (n.kind === 'chatmsg' && state.chatUnsub && state.j && state.j.id === n.jid && document.visibilityState !== 'hidden') { c.doc.ref.update({ ack: FV.arrayUnion(...devKeys()), read: true }).catch(() => {}); return; } // الدردشة مفتوحة أمامه
      if (n.read !== true && !ackedHere(n) && (n.pushed !== true || n.noPush === true)) state.nq.push(n);
    });
    state.inbox.slice(30).forEach(n => { if (!state._pruned.has(n.id)) { state._pruned.add(n.id); db.collection('notifs').doc(n.id).delete().catch(() => {}); } }); // نحتفظ بآخر 30
    flushNotifs(); renderNav();
  }, () => {}));
}
function flushNotifs() {
  const q = state.nq || []; if (!q.length) return;
  const hidden = document.visibilityState === 'hidden';
  if (hidden && !notifOn()) return; // تبقى بانتظار فتح التطبيق
  state.nq = [];
  let seen = []; try { seen = JSON.parse(lsGet(seenKey()) || '[]'); } catch (e) {}
  const tg = n => n.tag || ('n_' + n.id);
  const fresh = q.filter(n => !seen.includes(tg(n)));
  fresh.sort((a, b) => nSecs(a) - nSecs(b));
  const show = (title, body, tag, jid) => hidden ? showSysNotif(title, body, tag, jid) : toast(title + ' — ' + body, 'info');
  fresh.slice(0, 3).forEach(n => show(n.title, n.body, tg(n), n.jid));
  if (fresh.length > 3) show('سِواء', 'لديك ' + nf(fresh.length - 3) + ' إشعارات أخرى جديدة', 'more_' + Date.now(), '');
  fresh.forEach(n => seen.push(tg(n))); lsSet(seenKey(), JSON.stringify(seen.slice(-300)));
  q.forEach(n => db.collection('notifs').doc(n.id).update({ ack: FV.arrayUnion(...devKeys()) }).catch(() => {}));
}
async function markInboxRead() {
  const un = (state.inbox || []).filter(n => n.read !== true).slice(0, 30); if (!un.length) return;
  un.forEach(n => { n.read = true; }); renderNav();
  try { const b = db.batch(); un.forEach(n => b.update(db.collection('notifs').doc(n.id), { read: true })); await b.commit(); } catch (e) {}
}
document.addEventListener('visibilitychange', flushNotifs);
