<style>
:root{--brand:#1e5a46;--brand-2:#1e5a46;--ink:#0f172a;--bg:#f5f7f5;--tab-h:64px;--sat:env(safe-area-inset-top,0px);--sab:env(safe-area-inset-bottom,0px)}
*{-webkit-tap-highlight-color:transparent}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;background:#f5f7f5;overscroll-behavior-y:none}
body{font-family:'Cairo',system-ui,-apple-system,sans-serif;color:var(--ink);min-height:100vh;min-height:100dvh;overscroll-behavior-y:none;
  background:radial-gradient(900px 420px at 100% -8%,#d1fae5 0,transparent 60%),radial-gradient(800px 380px at -10% 0,#ccfbf1 0,transparent 55%),var(--bg);background-attachment:fixed;
  padding-bottom:calc(var(--tab-h) + var(--sab) + 16px)}
@media(min-width:768px){body{padding-bottom:28px}}
body.standalone{-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
body.standalone input,body.standalone textarea,body.standalone .sel{-webkit-user-select:text;user-select:text}
img{-webkit-user-drag:none}

/* الرأس */
.app-header{position:sticky;top:0;z-index:40;padding-top:var(--sat);background:rgba(255,255,255,.82);-webkit-backdrop-filter:saturate(180%) blur(14px);backdrop-filter:saturate(180%) blur(14px);border-bottom:1px solid rgba(226,232,240,.7)}
.app-header .logo{width:38px;height:38px;border-radius:12px;box-shadow:0 2px 10px rgba(30,90,70,.25);object-fit:cover}

/* البطاقات */
.card{background:rgba(255,255,255,.94);border:1px solid rgba(226,232,240,.9);border-radius:1.4rem;box-shadow:0 1px 2px rgba(15,23,42,.04),0 8px 24px -12px rgba(15,23,42,.12)}
@keyframes fade{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.fade{animation:fade .28s cubic-bezier(.2,.8,.2,1)}
@keyframes sheetUp{from{transform:translateY(100%)}to{transform:none}}

/* الحقول والأزرار */
.inp{width:100%;min-height:48px;padding:.7rem 1rem;border:1.5px solid #e2e8f0;border-radius:.95rem;font-size:16px;background:#f8fafc;transition:.15s;font-family:inherit}
.inp:focus{outline:none;border-color:#0fb16b;background:#fff;box-shadow:0 0 0 4px rgba(15,177,107,.15)}
textarea.inp{min-height:96px}
.btn{min-height:42px;padding:.55rem 1rem;border-radius:.95rem;font-weight:800;font-size:.8rem;transition:transform .12s,filter .15s,background .15s;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:.4rem;font-family:inherit;border:0;white-space:nowrap}
.btn:active{transform:scale(.96)}
.btn:disabled{opacity:.5;cursor:not-allowed}
.hide{display:none!important}
.b-pri{background:linear-gradient(135deg,#1e5a46,#1e5a46);color:#fff;box-shadow:0 6px 16px -6px rgba(30,90,70,.55)}.b-pri:hover{filter:brightness(.95)}
.b-sec{background:#eef2f6;color:#334155}.b-sec:hover{background:#e2e8f0}
.b-red{background:#fff1f2;color:#e11d48}.b-red:hover{background:#ffe4e6}
.b-white{background:#fff;color:#0f4c3a;box-shadow:0 6px 16px -8px rgba(0,0,0,.35)}

/* الواجهة الرئيسية */
.hero{position:relative;overflow:hidden;color:#fff;border-radius:1.6rem;padding:1.4rem;background:linear-gradient(135deg,#1e5a46 0%,#1e5a46 55%,#0f4c3a 100%);box-shadow:0 16px 36px -16px rgba(30,90,70,.65)}
.hero::before,.hero::after{content:"";position:absolute;border-radius:50%;background:rgba(255,255,255,.1);pointer-events:none}
.hero::before{width:180px;height:180px;top:-70px;left:-50px}.hero::after{width:120px;height:120px;bottom:-50px;right:30%}
.hero>*{position:relative;z-index:1}
.stat{background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.22);border-radius:1rem;padding:.6rem .9rem;min-width:5.5rem}
.jcard{display:flex;justify-content:space-between;align-items:center;gap:.75rem;padding:1rem;background:#fff;border:1px solid #e8edf2;border-radius:1.3rem;box-shadow:0 6px 18px -14px rgba(15,23,42,.35);transition:transform .15s,box-shadow .15s;cursor:pointer}
.jcard:active{transform:scale(.985)}
.jicon{width:46px;height:46px;border-radius:14px;display:flex;align-items:center;justify-content:center;flex:none;font-size:1.15rem;color:#fff;background:linear-gradient(135deg,#0fb16b,#1e5a46)}
.bar{height:6px;border-radius:99px;background:#e2e8f0;overflow:hidden}.bar>i{display:block;height:100%;background:linear-gradient(90deg,#0fb16b,#0fb16b);border-radius:99px}

/* شرائط الأزرار القابلة للتمرير في الجوال */
.chips{display:flex;flex-wrap:wrap;gap:.45rem}
.chips .btn{flex:1 1 28%;min-width:0;min-height:38px;padding:.4rem .35rem;font-size:.72rem;gap:.3rem}
@media(min-width:768px){.chips .btn{flex:none;min-height:42px;padding:.55rem 1rem;font-size:.8rem}}

/* شريط التنقل السفلي (الجوال) */
.tabbar{position:fixed;left:0;right:0;bottom:0;z-index:45;display:flex;height:calc(var(--tab-h) + var(--sab));padding-bottom:var(--sab);background:rgba(255,255,255,.92);-webkit-backdrop-filter:saturate(180%) blur(18px);backdrop-filter:saturate(180%) blur(18px);border-top:1px solid #e2e8f0}
.tab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-size:10.5px;font-weight:800;color:#64748b;background:none;border:0;cursor:pointer;font-family:inherit;position:relative}
.tab i{font-size:19px;transition:transform .2s}
.tab.on{color:var(--brand)}.tab.on i{transform:translateY(-1px) scale(1.12)}
.tab.on::before{content:"";position:absolute;top:0;width:28px;height:3px;border-radius:0 0 4px 4px;background:var(--brand)}
@media(min-width:768px){.tabbar{display:none!important}.dnav{display:flex!important}}
.dnav{display:none;align-items:center;gap:.4rem}

/* النوافذ المنبثقة */
.sheet-wrap{position:fixed;inset:0;z-index:60;background:rgba(15,23,42,.55);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;padding:1rem}
.sheet{background:#fff;width:100%;max-width:28rem;max-height:90vh;max-height:90dvh;overflow-y:auto;padding:1.4rem;border-radius:1.6rem;box-shadow:0 30px 60px -20px rgba(0,0,0,.5);-webkit-overflow-scrolling:touch}
@media(max-width:639px){
  .sheet-wrap{align-items:flex-end;padding:0}
  .sheet{max-width:none;border-radius:1.6rem 1.6rem 0 0;padding-bottom:calc(1.4rem + var(--sab));animation:sheetUp .28s cubic-bezier(.2,.8,.2,1)}
  .sheet::before{content:"";display:block;width:42px;height:4px;border-radius:9px;background:#cbd5e1;margin:-.4rem auto .9rem}
}

/* التنبيهات */
.toasts{position:fixed;z-index:80;left:50%;transform:translateX(-50%);top:calc(var(--sat) + 66px);width:min(92vw,24rem);display:flex;flex-direction:column;gap:.5rem;pointer-events:none}
.toast{color:#fff;padding:.8rem 1rem;border-radius:1rem;box-shadow:0 14px 30px -10px rgba(0,0,0,.4);font-size:.8rem;font-weight:700;pointer-events:auto;transition:opacity .3s}
.toast.success{background:#1e5a46}.toast.error{background:#e11d48}.toast.info{background:#1e293b}

/* شريط التثبيت */
.ibar{position:fixed;z-index:44;left:.75rem;right:.75rem;bottom:calc(var(--tab-h) + var(--sab) + 10px);display:flex;align-items:center;gap:.75rem;padding:.7rem .8rem;background:#0f172a;color:#fff;border-radius:1.2rem;box-shadow:0 18px 40px -12px rgba(0,0,0,.55)}
.ibar img{width:40px;height:40px;border-radius:11px;flex:none;background:#fff}
.ibar .x{background:none;border:0;color:#94a3b8;padding:.35rem;cursor:pointer}
@media(min-width:768px){.ibar{bottom:1rem;max-width:30rem;margin-inline:auto}}

/* خطوط أوضح في الجوال */
@media(max-width:639px){
  body .text-xs{font-size:.8rem;line-height:1.25rem}
  body [class*="text-[11px]"]{font-size:.75rem}
  body [class*="text-[10px]"]{font-size:.7rem}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
body.has-ibar{padding-bottom:calc(var(--tab-h) + var(--sab) + 104px)}
@media(min-width:768px){body.has-ibar{padding-bottom:104px}}
.bellbtn{position:relative}.bellbtn .cnt{position:absolute;top:-6px;left:-6px;min-width:19px;height:19px;padding:0 5px;border-radius:99px;background:#e11d48;color:#fff;font-size:10px;font-weight:900;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 2px #fff}
#print-root{display:none}
@media print{body>*:not(#print-root){display:none!important}#print-root{display:block!important}@page{margin:12mm}}

/* ===== ثيم عصري: ألوان هادئة وأزرار وبطاقات أنعم ===== */
:root{--brand:#1e5a46;--brand-2:#0fb16b;--accent:#6366f1;--tab-h:80px;--bg:#f5f7f5}
body{background:radial-gradient(700px 360px at 100% -6%,rgba(15,177,107,.38) 0,transparent 62%),radial-gradient(640px 340px at -8% 4%,rgba(165,180,252,.30) 0,transparent 58%),var(--bg);background-attachment:fixed}
.app-header{background:rgba(255,255,255,.72);border-bottom:1px solid rgba(255,255,255,.6);box-shadow:0 8px 28px -20px rgba(15,23,42,.35)}
.app-header .logo{border-radius:14px;box-shadow:0 6px 16px -6px rgba(30,90,70,.55)}
.card{border:1px solid rgba(255,255,255,.8);border-radius:1.6rem;background:rgba(255,255,255,.86);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);box-shadow:0 1px 1px rgba(15,23,42,.03),0 14px 34px -18px rgba(15,60,70,.28)}
.inp{border-radius:1.1rem;border:1.5px solid #e3ebee;background:rgba(248,251,251,.9)}
.inp:focus{border-color:var(--brand);box-shadow:0 0 0 4px rgba(30,90,70,.16)}
.btn{border-radius:999px;min-height:44px;padding:.55rem 1.15rem;letter-spacing:.1px}
.b-pri{background:linear-gradient(135deg,#0fb16b 0%,#1e5a46 45%,#0fb16b 100%);box-shadow:0 10px 22px -10px rgba(30,90,70,.75),inset 0 1px 0 rgba(255,255,255,.28)}
.b-pri:hover{filter:brightness(1.05)}
.b-sec{background:rgba(255,255,255,.85);color:#1e5a46;border:1px solid #dbe8ea;box-shadow:0 4px 12px -8px rgba(15,60,70,.3)}.b-sec:hover{background:#fff;border-color:#bcd6da}
.b-red{background:#fff1f3;color:#e11d48;border:1px solid #ffd5dc}
.b-white{box-shadow:0 10px 22px -12px rgba(0,0,0,.4)}
.hero{border-radius:1.9rem;background:linear-gradient(135deg,#0f4c3a 0%,#1e5a46 42%,#14b8c4 100%);box-shadow:0 22px 44px -22px rgba(30,90,70,.8)}
.hero::before{background:rgba(255,255,255,.13)}.hero::after{background:rgba(129,140,248,.35)}
.stat{background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.3);border-radius:1.15rem;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}
.jcard{border:1px solid rgba(255,255,255,.85);border-radius:1.5rem;background:rgba(255,255,255,.9);box-shadow:0 14px 30px -20px rgba(15,60,70,.4);animation:fade .4s cubic-bezier(.2,.8,.2,1) both}
.jcard:hover{transform:translateY(-2px);box-shadow:0 18px 36px -18px rgba(15,60,70,.45)}
.jcard:nth-child(2){animation-delay:.05s}.jcard:nth-child(3){animation-delay:.1s}.jcard:nth-child(4){animation-delay:.15s}
.jicon{border-radius:16px;box-shadow:0 8px 16px -8px rgba(30,90,70,.6)}
.jcard:nth-child(4n+2) .jicon{background:linear-gradient(135deg,#818cf8,#6366f1);box-shadow:0 8px 16px -8px rgba(99,102,241,.6)}
.jcard:nth-child(4n+3) .jicon{background:linear-gradient(135deg,#fbbf24,#f59e0b);box-shadow:0 8px 16px -8px rgba(245,158,11,.6)}
.jcard:nth-child(4n+4) .jicon{background:linear-gradient(135deg,#fb7185,#e11d48);box-shadow:0 8px 16px -8px rgba(225,29,72,.55)}
.bar{height:8px;background:#e4edf0}.bar>i{background:linear-gradient(90deg,#0fb16b,#0fb16b)}
.tabbar{left:12px;right:12px;bottom:calc(var(--sab) + 10px);height:66px;padding-bottom:0;border-radius:26px;background:rgba(255,255,255,.88);border:1px solid rgba(255,255,255,.9);box-shadow:0 18px 40px -14px rgba(15,60,70,.45)}
.tab{color:#7a8c92;z-index:0}
.tab.on{color:var(--brand)}
.tab.on::before{top:8px;width:54px;height:32px;border-radius:99px;background:rgba(30,90,70,.14);z-index:-1}
.sheet{border-radius:1.9rem}
@media(max-width:639px){.sheet{border-radius:1.9rem 1.9rem 0 0}.sheet::before{background:#d3dfe2}}
.toast{border-radius:1.2rem}.toast.success{background:linear-gradient(135deg,#1e5a46,#0fb16b)}.toast.info{background:#223641}
.ibar{border-radius:1.5rem;background:linear-gradient(135deg,#0f2f3a,#16424a)}
.emo{width:40px;height:40px;border-radius:12px;background:#f1f5f9;font-size:1.2rem;border:1.5px solid transparent;cursor:pointer;display:inline-flex;align-items:center;justify-content:center}
.emo.on{border-color:var(--brand);background:#ccfbf1}

.atabs{display:flex;gap:.4rem;overflow-x:auto;padding:.2rem 0 .4rem;scrollbar-width:none}.atabs::-webkit-scrollbar{display:none}
.achip{flex:none;padding:.5rem .95rem;border-radius:999px;font-size:.75rem;font-weight:800;background:rgba(255,255,255,.9);color:#1e5a46;border:1px solid #dbe8ea;cursor:pointer;font-family:inherit;display:inline-flex;gap:.4rem;align-items:center;white-space:nowrap}
.achip.on{background:linear-gradient(135deg,#0fb16b,#1e5a46);color:#fff;border-color:transparent}
.bar{border-radius:5px 5px 2px 2px;background:linear-gradient(180deg,#0fb16b,#1e5a46);min-height:2px}.bar.z{background:#e2e8f0}
.hbar{height:7px;border-radius:99px;background:#e2e8f0;overflow:hidden}.hbar>i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,#0fb16b,#0fb16b)}
.bdg{display:inline-flex;align-items:center;gap:.25rem;padding:.1rem .5rem;border-radius:99px;font-size:10px;font-weight:800}
.dot-on{display:inline-block;width:9px;height:9px;border-radius:50%;background:#0fb16b;box-shadow:0 0 0 3px rgba(15,177,107,.25)}

/* ===== الهوية المالية: زجاجية زمردية (Advanced Glassmorphism) ===== */
:root{--brand:#0f4c3a;--brand-2:#1e5a46;--ink:#0f172a;--bg:#f8fafc;--loss:#e11d48}
body{font-family:'Cairo',system-ui,sans-serif;color:var(--ink);
  background:radial-gradient(900px 420px at 100% -8%,rgba(15,177,107,.35) 0,transparent 60%),radial-gradient(800px 380px at -10% 0,rgba(15,177,107,.28) 0,transparent 55%),linear-gradient(160deg,#f8fafc 0%,#e2e8f0 100%);background-attachment:fixed}
.app-header{background:rgba(255,255,255,.28);-webkit-backdrop-filter:blur(16px) saturate(160%);backdrop-filter:blur(16px) saturate(160%);border-bottom:1px solid rgba(255,255,255,.45);box-shadow:inset 0 1px 0 rgba(255,255,255,.5),0 12px 28px -18px rgba(15,23,42,.25)}
.app-header .logo{border-radius:14px;box-shadow:0 8px 18px -8px rgba(30,90,70,.6)}
.card{background:rgba(255,255,255,.94);border:1px solid rgba(255,255,255,.85);border-radius:1.6rem;box-shadow:0 2px 4px rgba(15,23,42,.04),0 12px 24px -10px rgba(15,23,42,.14),0 30px 60px -28px rgba(30,90,70,.22)}
.b-pri{background:linear-gradient(135deg,#1e5a46 0%,#0f4c3a 100%);box-shadow:0 12px 24px -10px rgba(30,90,70,.7),inset 0 1px 0 rgba(255,255,255,.3)}
.b-pri:hover{filter:brightness(1.04)}
.hero{background:linear-gradient(135deg,#0f4c3a 0%,#0f4c3a 100%);border-radius:2rem;padding:1rem;box-shadow:0 24px 48px -20px rgba(15,76,58,.6)}
.hero::before{background:rgba(15,177,107,.45);filter:blur(40px)}
.hero::after{background:rgba(15,177,107,.4);filter:blur(40px)}
.hero>*{position:relative;z-index:1;-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px)}
.stat{background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.35);border-radius:1.1rem;-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);box-shadow:inset 0 1px 0 rgba(255,255,255,.45)}
.tabbar{background:rgba(255,255,255,.3);-webkit-backdrop-filter:blur(16px) saturate(160%);backdrop-filter:blur(16px) saturate(160%);border:1px solid rgba(255,255,255,.45);box-shadow:inset 0 1px 0 rgba(255,255,255,.6),0 24px 48px -16px rgba(30,90,70,.35)}
.tab{font-weight:700}
.tab.on{color:var(--brand)}
.tab.on::before{background:rgba(30,90,70,.14)}
.jicon{background:linear-gradient(135deg,#0fb16b,#0f4c3a);box-shadow:0 8px 16px -8px rgba(30,90,70,.55)}
.jcard:nth-child(n) .jicon{background:linear-gradient(135deg,#0fb16b,#0f4c3a)}
.jcard:hover{transform:translateY(-2px)}
.bar>i,.hbar>i{background:linear-gradient(90deg,#1e5a46,#0f4c3a)}
.toast.success{background:linear-gradient(135deg,#1e5a46,#0f4c3a)}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
/* ===== تصميم v7 — «دفتر الثقة»: بترولي هادئ، ذهبي للمال، بلا زجاج ولا تدرجات زخرفية ===== */
:root{--petrol:#0f4c3a;--petrol-2:#1e5a46;--brand:#1e5a46;--brand-2:#0fb16b;--ink:#212c26;--muted:#5B6E71;--bg:#f5f7f5;--surface:#fff;--line:#DCE4E1;--line-2:#C7D4CF;--gold:#e65a2c;--gold-soft:#fbebe4;--ok:#2E7D5B;--loss:#B42F34;--r-card:18px;--r-ctl:12px;--shadow:0 1px 2px rgba(11,46,51,.05),0 8px 20px -14px rgba(11,46,51,.22)}
body{font-family:'Cairo',system-ui,-apple-system,sans-serif;color:var(--ink);background:var(--bg);line-height:1.7}
h1,h2,h3,.font-display{font-family:'Cairo',system-ui,sans-serif;letter-spacing:0;color:var(--petrol)}
:focus-visible{outline:2px solid var(--gold);outline-offset:2px;border-radius:6px}

/* الرأس: شريط هادئ بخط فاصل واحد */
.app-header{background:rgba(241,244,242,.94);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.app-header .logo{border-radius:12px;box-shadow:none}

/* البطاقات: حدّ واحد وظل واحد ونصف قطر واحد لكل المستويات */
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-card);box-shadow:var(--shadow)}

/* الأزرار: لون واحد أساسي، والثانوي محايد */
.btn{border-radius:var(--r-ctl);font-weight:600;font-size:.875rem;min-height:44px;padding:.6rem 1.05rem}
.b-pri,.b-pri:hover{background:var(--brand);color:#fff;box-shadow:none;filter:none}
.b-pri:hover{background:var(--petrol-2)}
.b-sec{background:#E7EDEB;color:var(--petrol)}.b-sec:hover{background:#DBE5E1}
.b-red{background:#FBEAEA;color:var(--loss)}.b-red:hover{background:#F6DADA}
.b-white{background:#fff;color:var(--petrol);box-shadow:none}

/* الحقول */
.inp{border:1px solid var(--line-2);border-radius:var(--r-ctl);background:#fff;min-height:46px}
.inp:focus{border-color:var(--brand-2);background:#fff;box-shadow:0 0 0 3px rgba(30,90,70,.16)}

/* البطل: مساحة بترولية صلبة مع الأرقام بارزة */
.hero{background:var(--petrol);color:#fff;border-radius:22px;box-shadow:var(--shadow);padding:1.25rem}
.hero::before,.hero::after{display:none}
.hero h1,.hero h2,.hero h3{color:#fff}
.stat{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:var(--r-ctl);-webkit-backdrop-filter:none;backdrop-filter:none}

/* بطاقة الجمعية في القائمة */
.jcard{background:#fff;border:1px solid var(--line);border-radius:var(--r-card);box-shadow:none;animation:none}
.jcard:hover{transform:none;box-shadow:var(--shadow);border-color:var(--line-2)}
.jcard:active{transform:scale(.99)}
.jicon,.jcard .jicon,.jcard:nth-child(n) .jicon{width:44px;height:44px;border-radius:12px;background:#E4EEEC !important;color:var(--brand);box-shadow:none !important;font-size:1.05rem}

/* أشرطة التقدم: لون واحد، والمكتمل بالذهبي */
.bar,.hbar{background:#E3EAE7;border-radius:99px}
.bar>i,.hbar>i{background:var(--brand-2);border-radius:99px}

/* الشريط السفلي: مرسوم بالكامل من الحافة، بلا طفو */
.tabbar{left:0;right:0;bottom:0;height:calc(var(--tab-h) + var(--sab));padding-bottom:var(--sab);border-radius:0;background:#fff;border:0;border-top:1px solid var(--line);box-shadow:none;-webkit-backdrop-filter:none;backdrop-filter:none}
.tab{font-weight:600;color:#7A8D90}
.tab.on{color:var(--petrol)}
.tab.on::before{top:0;width:28px;height:3px;border-radius:0 0 3px 3px;background:var(--gold);background-color:var(--gold)}

/* النوافذ والإشعارات */
.sheet{border-radius:24px}
@media(max-width:639px){.sheet{border-radius:24px 24px 0 0}}
.toast{border-radius:var(--r-ctl);box-shadow:0 12px 24px -14px rgba(11,46,51,.55)}
.toast.success{background:var(--ok)}
.toast.info{background:var(--petrol)}
.ibar{background:var(--petrol);border-radius:var(--r-card)}

/* الفلاتر والخيارات */
.achip{border-radius:999px;border:1px solid var(--line-2);background:#fff;color:var(--petrol);font-weight:600}
.achip.on{background:var(--petrol);color:#fff;border-color:var(--petrol)}
.emo.on{border-color:var(--gold);background:var(--gold-soft)}
.bdg{font-weight:600}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

/* ===== v8 — Modern Light UI: فاتح وهادئ (طبقة أنماط فقط، بلا تغيير في HTML أو JavaScript) ===== */
:root{--bg:#f5f7f5;--surface:#FFFFFF;--brand:#1e5a46;--brand-dark:#0f4c3a;--brand-soft:#eaf0eb;--brand-line:#c5ddd0;--ink:#212c26;--muted:#647A8B;--line:#E4EBF1;--line-2:#D3DEE7;
  /* إعادة توجيه متغيرات الإصدارات السابقة إلى لوحة الألوان الجديدة */
  --petrol:#0f4c3a;--petrol-2:#0f4c3a;--brand-2:#1e5a46;--gold:#e65a2c;--gold-soft:#fbebe4;--r-card:20px;--r-ctl:14px;
  --shadow:0 1px 2px rgba(23,50,77,.04),0 8px 22px -14px rgba(23,50,77,.14)}
body{background:var(--bg);background-image:none;color:var(--ink)}
h1,h2,h3,.font-display{color:var(--ink)}
:focus-visible{outline:2px solid var(--brand);outline-offset:2px}

/* الرأس */
.app-header{background:rgba(255,255,255,.94);border-bottom:1px solid var(--line);box-shadow:none}

/* البطاقات والقوائم */
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-card);box-shadow:var(--shadow)}
.jcard{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-card);padding:1rem 1.1rem}
.jcard:hover{border-color:var(--brand-line);box-shadow:var(--shadow)}
.jicon,.jcard .jicon,.jcard:nth-child(n) .jicon{background:var(--brand-soft)!important;color:var(--brand)!important;border-radius:14px}

/* الأزرار */
.btn{border-radius:var(--r-ctl);min-height:46px;font-weight:700;font-size:.875rem;padding:.6rem 1.1rem}
.btn:focus-visible{outline:none;box-shadow:0 0 0 3px rgba(30,90,70,.28)}
.btn:disabled,.btn[disabled]{opacity:.5;cursor:not-allowed;box-shadow:none}
.b-pri{background:var(--brand);color:#fff;box-shadow:0 1px 2px rgba(15,76,58,.25)}
.b-pri:hover{background:var(--brand-dark);filter:none}
.b-pri:active{background:var(--brand-dark)}
.b-sec{background:var(--brand-soft);color:var(--brand-dark);border:1px solid transparent;box-shadow:none}
.b-sec:hover{background:#D5F0EB;border-color:var(--brand-line)}
.b-red{background:#FEF1F2;color:#BE123C;border:1px solid #FBD5DA}
.b-red:hover{background:#FDE3E6}
.b-white{background:#fff;color:var(--brand-dark);border:1px solid var(--line);box-shadow:none}

/* الحقول والنماذج */
.inp{min-height:48px;background:#fff;border:1.5px solid var(--line-2);border-radius:var(--r-ctl);color:var(--ink)}
.inp::placeholder{color:#9AABB8}
.inp:hover{border-color:#C3D2DD}
.inp:focus{border-color:var(--brand);background:#fff;box-shadow:0 0 0 4px rgba(30,90,70,.14)}
.inp:disabled,.inp[disabled],.inp[readonly]{background:#F1F5F9;color:var(--muted);cursor:not-allowed}
/* حقول التاريخ/الوقت: Safari على iOS يرسمها بمظهرها الأصلي فتتجاوز عرض العمود وتتوسّط؛ نوحّد عرضها ومحاذاتها */
input.inp[type=date],input.inp[type=month],input.inp[type=time],input.inp[type=datetime-local]{-webkit-appearance:none;appearance:none;display:block;box-sizing:border-box;width:100%;min-width:0;max-width:100%;min-height:48px;line-height:1.5;text-align:start;margin:0}
input.inp[type=date]::-webkit-date-and-time-value,input.inp[type=month]::-webkit-date-and-time-value,input.inp[type=time]::-webkit-date-and-time-value,input.inp[type=datetime-local]::-webkit-date-and-time-value{text-align:start;margin:0;min-height:1.5em;display:block}
input.inp[type=date]::-webkit-calendar-picker-indicator{margin:0}
.wz .grid>*,.wz-fields>*{min-width:0}

/* لوحة المعلومات: بطل صلب بلا تدرجات */
.hero{background:var(--brand-dark);color:#fff;border-radius:22px;box-shadow:var(--shadow);padding:1.25rem}
.hero::before,.hero::after{display:none}
.stat{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);border-radius:16px}
/* بطاقات الملخص المبنية بنمط inline (القطة، الديون، التعاون العائلي): لون صلب بدل التدرج */
[style*="linear-gradient"]{background:var(--brand-dark)!important;box-shadow:var(--shadow)!important}
[style*="linear-gradient"][style*="1e293b"]{background:var(--ink)!important}

/* أشرطة التقدم والرسوم */
.bar,.hbar{background:var(--line);border-radius:99px}
.bar>i,.hbar>i{background:var(--brand);border-radius:99px}
.bar.w-full{background:var(--brand);border-radius:6px 6px 2px 2px}
.bar.w-full.z{background:var(--line)}

/* شريط التنقل */
.tabbar{background:#fff;border-top:1px solid var(--line)}
.tab{color:var(--muted);font-weight:700}
.tab.on{color:var(--brand-dark)}
.tab.on::before{background:var(--brand);background-color:var(--brand)}

/* النوافذ المنبثقة والتنبيهات */
.sheet-wrap{background:rgba(23,50,77,.42);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px)}
.sheet{border-radius:22px;box-shadow:0 24px 48px -24px rgba(23,50,77,.4)}
@media(max-width:639px){.sheet{border-radius:22px 22px 0 0}.sheet::before{background:var(--line-2)}}
.toast{border-radius:var(--r-ctl)}
.toast.success{background:var(--brand-dark)}
.toast.info{background:var(--ink)}
.ibar{background:var(--ink);border-radius:var(--r-card)}

/* الفلاتر والشارات والاختيارات */
.achip{border:1px solid var(--line-2);background:#fff;color:var(--ink);font-weight:700}
.achip:hover{border-color:var(--brand-line);background:var(--brand-soft)}
.achip.on{background:var(--brand);color:#fff;border-color:var(--brand)}
.emo.on{border-color:var(--brand);background:var(--brand-soft)}
.dot-on{background:var(--brand);box-shadow:0 0 0 3px rgba(30,90,70,.22)}
#lock-screen{background:var(--ink)!important}

/* توحيد ألوان Tailwind المستخدمة في الواجهة مع اللوحة الجديدة (الحالات: أحمر/كهرماني/أزرق تبقى كما هي) */
body .text-slate-400,body .text-slate-500{color:var(--muted)}
body .text-slate-600{color:#4F657A}
body .text-slate-700,body .text-slate-800,body .text-slate-900{color:var(--ink)}
body .border-slate-100,body .border-slate-200{border-color:var(--line)}
body .bg-slate-50{background-color:var(--bg)}
body .bg-slate-100{background-color:#EEF3F7}
body .text-emerald-600,body .text-emerald-700,body .text-emerald-800,body .text-teal-600,body .text-teal-700{color:var(--brand-dark)}
body .bg-emerald-50,body .bg-emerald-100,body .bg-teal-50,body .bg-teal-100{background-color:var(--brand-soft)}
body .bg-emerald-500,body .bg-emerald-600{background-color:var(--brand)}
body .border-emerald-100,body .border-emerald-200{border-color:var(--brand-line)}

/* التجاوب: منع تجاوز العناصر لعرض الشاشة */
main,.sheet{min-width:0;overflow-wrap:anywhere}
/* منع اتساع الصفحة أفقياً (كانت الشاشة تتحرك يميناً ويساراً): عناصر الشبكة تنكمش بدل أن توسّع الصفحة */
.grid>*,.card,#app>*{min-width:0}
.card{max-width:100%}
body{overflow-x:hidden}
main img,.sheet img,main table,.sheet table{max-width:100%}

/* ===== v9 — Modern Banking UI: أخضر عميق، بطاقات ناعمة، أزرار واضحة (طبقة أنماط فقط، بلا تغيير في HTML أو JavaScript) ===== */
:root{--g900:#0a3a2c;--g800:#0f4c3a;--g700:#1e5a46;--g500:#0fb16b;--g100:#e6f4ed;--g50:#f2f8f5;
  --bg:#f4f6f5;--ink:#14211c;--muted:#6b7c75;--line:#e6ece9;--line-2:#d5dfda;--brand-soft:#e6f4ed;--brand-line:#c5ddd0;
  --r-card:22px;--r-ctl:16px;
  --shadow:0 1px 2px rgba(10,58,44,.05),0 10px 24px -12px rgba(10,58,44,.18)}
body{background:var(--bg);color:var(--ink)}
h1,h2,h3,.font-display{color:var(--ink);font-weight:800}

/* الرأس */
.app-header{background:rgba(255,255,255,.92);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.app-header .logo{border-radius:14px}

/* البطاقات والقوائم */
.card{border:1px solid var(--line);border-radius:var(--r-card);box-shadow:var(--shadow)}
.jcard{border-radius:var(--r-card);padding:1.05rem 1.15rem;box-shadow:var(--shadow);border-color:transparent;transition:transform .15s ease,box-shadow .15s ease}
.jcard:hover{border-color:var(--brand-line);box-shadow:0 14px 28px -14px rgba(10,58,44,.28);transform:translateY(-1px)}
.jcard:active{transform:scale(.985)}
.jicon,.jcard .jicon,.jcard:nth-child(n) .jicon{width:48px;height:48px;border-radius:16px;background:var(--g100)!important;color:var(--g800)!important}

/* البطل والبطاقات الملخصة: تدرج أخضر عميق مع دوائر زخرفية خفيفة */
.hero,[style*="linear-gradient"]{position:relative;overflow:hidden}
.hero{background:linear-gradient(160deg,var(--g900) 0%,var(--g800) 55%,var(--g700) 100%);border-radius:28px;box-shadow:0 18px 36px -18px rgba(10,58,44,.55);padding:1.35rem}
.hero::before,.hero::after{display:block;content:"";position:absolute;border-radius:50%;pointer-events:none}
.hero::before{width:220px;height:220px;background:rgba(15,177,107,.18);top:-90px;left:-70px}
.hero::after{width:150px;height:150px;background:rgba(230,90,44,.14);bottom:-60px;right:-40px}
.hero>*{position:relative;z-index:1}
[style*="linear-gradient"]{background:linear-gradient(160deg,var(--g900),var(--g800) 60%,var(--g700))!important;border-radius:var(--r-card);box-shadow:0 14px 30px -16px rgba(10,58,44,.5)!important}
[style*="linear-gradient"][style*="1e293b"]{background:var(--ink)!important}
.stat{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);border-radius:18px}

/* الأزرار */
.btn{border-radius:var(--r-ctl);min-height:50px;font-weight:800;font-size:.9rem;padding:.65rem 1.2rem;transition:transform .12s ease,box-shadow .15s ease,background .15s ease}
.btn:active{transform:scale(.98)}
.b-pri{background:linear-gradient(135deg,var(--g700),var(--g800));color:#fff;box-shadow:0 10px 20px -10px rgba(15,76,58,.7)}
.b-pri:hover{background:linear-gradient(135deg,var(--g800),var(--g900))}
.b-sec{background:var(--g100);color:var(--g800);border:0}
.b-sec:hover{background:#d6ecdf}
.b-white{border:1px solid var(--line);color:var(--g800);box-shadow:0 1px 2px rgba(10,58,44,.06)}
.b-red{background:#fdeeee;color:#b42f34;border:0}

/* الحقول */
.inp{min-height:52px;border:1.5px solid var(--line-2);border-radius:var(--r-ctl);background:#fff;font-weight:600}
.inp:focus{border-color:var(--g700);box-shadow:0 0 0 4px rgba(30,90,70,.13)}

/* أشرطة التقدم */
.bar,.hbar{height:8px;background:var(--g100);border-radius:99px}
.bar>i,.hbar>i{background:linear-gradient(90deg,var(--g500),var(--g700));border-radius:99px}

/* شريط التنقل: أيقونة الصفحة الحالية داخل كبسولة خضراء */
.tabbar{background:rgba(255,255,255,.97);border-top:1px solid var(--line);box-shadow:0 -8px 24px -18px rgba(10,58,44,.35)}
.tab{font-weight:700;color:#93a19b}
.tab i,.tab svg{transition:background .15s ease,color .15s ease}
.tab.on{color:var(--g800)}
.tab.on::before{background:var(--g700);background-color:var(--g700);width:32px;height:3px}
.tab.on i,.tab.on svg{color:var(--g800)}

/* النوافذ والتنبيهات */
.sheet-wrap{background:rgba(10,58,44,.45)}
.sheet{border-radius:28px;box-shadow:0 28px 56px -28px rgba(10,58,44,.5)}
@media(max-width:639px){.sheet{border-radius:28px 28px 0 0}}
.toast{border-radius:16px;font-weight:700}
.toast.success{background:var(--g800)}
.ibar{background:var(--g900);border-radius:var(--r-card)}

/* الفلاتر والشارات */
.achip{border-radius:99px;font-weight:700;background:#fff;border:1px solid var(--line-2)}
.achip.on{background:var(--g800);border-color:var(--g800);color:#fff}
.bdg{font-weight:700;border-radius:99px}
.emo.on{border-color:var(--g700);background:var(--g100)}
/* ===== v10 — الشاشة الرئيسية بنمط تطبيقات البنوك (مطابقة للتصميم المعتمد) ===== */
body .sw-hero{position:relative;overflow:hidden;color:#fff;background:linear-gradient(160deg,#0a3a2c 0%,#0f4c3a 55%,#1e5a46 100%);border-radius:28px;padding:1.5rem 1.5rem 4.6rem;box-shadow:0 18px 36px -18px rgba(10,58,44,.55)}
body .sw-hero::before{content:"";position:absolute;width:260px;height:260px;border-radius:50%;background:rgba(15,177,107,.18);top:-90px;left:-70px;pointer-events:none}
body .sw-hero::after{content:"";position:absolute;width:180px;height:180px;border-radius:50%;background:rgba(230,90,44,.14);bottom:-70px;right:-40px;pointer-events:none}
.sw-hero>*{position:relative;z-index:1}
.sw-hl{font-size:13px;font-weight:500;opacity:.8;margin-top:.4rem}
.sw-big{font-size:40px;font-weight:800;line-height:1.2;letter-spacing:-.5px;margin-top:2px;color:#fff}
.sw-big span{font-size:16px;font-weight:600;opacity:.8;margin-right:6px}
.sw-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.sw-chip{font-family:inherit;font-size:12px;font-weight:600;padding:5px 12px;border-radius:99px;background:rgba(255,255,255,.14);color:#fff;border:0;cursor:default}
button.sw-chip{cursor:pointer}
.sw-chip.up{background:rgba(15,177,107,.28);color:#c9f5df}

body .sw-quick{position:relative;z-index:3;margin:-3.4rem 1.25rem 0!important;background:#fff;border-radius:22px;box-shadow:0 1px 2px rgba(10,58,44,.05),0 10px 24px -12px rgba(10,58,44,.18);display:grid;grid-template-columns:repeat(4,1fr);padding:16px 6px 12px}
.sw-act{display:flex;flex-direction:column;align-items:center;gap:8px;font-family:inherit;font-size:12px;font-weight:700;color:#14211c;background:none;border:0;cursor:pointer;padding:0}
.sw-act:active{transform:scale(.96)}
.sw-ic{width:48px;height:48px;border-radius:16px;display:grid;place-items:center;font-size:20px;flex:none}
.sw-ic.sm{width:44px;height:44px;font-size:18px;border-radius:14px}
.sw-ic.i1{background:#e6f4ed;color:#0f4c3a}.sw-ic.i2{background:#fdeee8;color:#e65a2c}.sw-ic.i3{background:#eaf0fb;color:#2f5fc4}.sw-ic.i4{background:#f3ecfb;color:#7a45c2}

.sw-sec{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:6px 2px 2px}
.sw-sec h3{font-size:16px;font-weight:800;color:#14211c}
.sw-add{font-family:inherit;font-size:13px;font-weight:700;color:#1e5a46;background:none;border:0;cursor:pointer;padding:4px 2px}

body .sw-card{display:flex;flex-wrap:wrap;align-items:center;gap:12px;background:#fff;border:1px solid #e6ece9;border-radius:20px;padding:14px 16px;box-shadow:0 1px 2px rgba(10,58,44,.05),0 10px 24px -12px rgba(10,58,44,.18);cursor:pointer}
.sw-card .sw-t{flex:1;min-width:0}
.sw-card .sw-t b{display:block;font-size:14.5px;font-weight:700;color:#14211c;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sw-card .sw-t small{display:block;font-size:12px;color:#6b7c75}
.sw-amt{text-align:left;display:flex;flex-direction:column;align-items:flex-start;gap:3px}
.sw-amt b{font-size:15px;font-weight:800;color:#14211c}
.sw-bdg{display:inline-block;font-size:11px;font-weight:700;padding:2px 9px;border-radius:99px}
.sw-bdg.or{background:#fdeee8;color:#e65a2c}.sw-bdg.g{background:#e6f4ed;color:#0f4c3a}.sw-bdg.gr{background:#eef1f0;color:#6b7c75}
.sw-prog{flex-basis:100%;height:6px;border-radius:99px;background:#e6f4ed;overflow:hidden}
.sw-prog i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,#0fb16b,#1e5a46)}

/* شريط التنقل: كبسولة خضراء خلف أيقونة الصفحة الحالية */
body .tabbar{--tab-h:76px;background:rgba(255,255,255,.97);border-top:1px solid #e6ece9;box-shadow:0 -8px 24px -18px rgba(10,58,44,.35)}
body .tab{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font-size:11px;font-weight:700;color:#93a19b}
body .tab::before{display:none}
body .tab.on::before{display:none}
body .tab .pill{width:52px;height:30px;border-radius:99px;display:grid;place-items:center;transition:background .15s ease}
body .tab i{font-size:18px;transform:none}
