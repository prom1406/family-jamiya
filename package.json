}

/* ===== معالج الإنشاء (wizard.js): جوال أولاً، RTL، تباين مناسب ===== */
.wz{--wz-main:#0d7a68;--wz-dk:#0f4c3a;--wz-soft:#e8f5f1;--wz-line:#dbe6e2;--wz-ink:#0f172a;--wz-mut:#475569;--wz-bad:#e11d48;--wz-warn:#b45309}
.wz :focus-visible{outline:3px solid rgba(13,122,104,.5);outline-offset:2px;border-radius:.6rem}
.wz-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem}
.wz-head h3{font-weight:900;font-size:1.3rem;color:var(--wz-ink)}
.wz-x{width:44px;height:44px;border-radius:14px;color:#64748b;display:grid;place-items:center;font-size:1.1rem}.wz-x:hover{background:#f1f5f9}
.wz-steps{display:flex;gap:.25rem;margin:0 0 1.4rem;padding:0;list-style:none}
.wz-st{flex:1;position:relative;text-align:center}
.wz-st::before{content:"";position:absolute;top:15px;inset-inline-start:50%;width:100%;height:2px;background:var(--wz-line)}
.wz-st:last-child::before{display:none}.wz-st.done::before{background:var(--wz-main)}
.wz-sb{display:flex;flex-direction:column;align-items:center;gap:.3rem;width:100%;position:relative;z-index:1;background:none;border:0;padding:0;font-family:inherit;cursor:default}
button.wz-sb{cursor:pointer;min-height:48px}
.wz-dot{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;font-weight:900;font-size:.8rem;background:#fff;border:2px solid var(--wz-line);color:#64748b;transition:.2s}
.wz-st.on .wz-dot{background:var(--wz-main);border-color:var(--wz-main);color:#fff;box-shadow:0 0 0 4px rgba(13,122,104,.16)}
.wz-st.done .wz-dot{background:var(--wz-soft);border-color:var(--wz-main);color:var(--wz-dk)}
.wz-sl{font-size:.7rem;font-weight:700;color:#64748b}.wz-st.on .wz-sl{color:var(--wz-ink)}.wz-st.done .wz-sl{color:var(--wz-dk)}
.wz-h{font-weight:900;font-size:1.05rem;margin:0 0 .9rem;color:var(--wz-ink);outline:none;display:flex;align-items:center;gap:.5rem}
.wz-h i{color:var(--wz-main)}
[data-wz-panel]{animation:wzIn .25s ease}
@keyframes wzIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.wz-cards{display:grid;gap:.6rem}
.wz-card{display:flex;align-items:center;gap:.8rem;width:100%;text-align:start;padding:.9rem 1rem;min-height:76px;border:2px solid var(--wz-line);border-radius:1.15rem;background:#fff;transition:transform .15s,border-color .15s,background .15s,box-shadow .15s;font-family:inherit;cursor:pointer}
.wz-card:hover{border-color:#9cc9bf}.wz-card:active{transform:scale(.985)}
.wz-card.on{border-color:var(--wz-main);background:var(--wz-soft);box-shadow:0 10px 22px -16px rgba(13,122,104,.8);transform:scale(1.012)}
.wz-ci{flex:none;width:48px;height:48px;border-radius:15px;display:grid;place-items:center;font-size:1.2rem;background:var(--wz-soft);color:var(--wz-dk);transition:.15s}
.wz-card.on .wz-ci{background:var(--wz-main);color:#fff}
.wz-ct{flex:1;min-width:0;display:flex;flex-direction:column;gap:.15rem}
.wz-ct b{font-size:.95rem;font-weight:900;color:var(--wz-ink)}.wz-ct small{font-size:.75rem;color:var(--wz-mut);line-height:1.55}
.wz-ck{flex:none;width:24px;height:24px;border-radius:50%;display:grid;place-items:center;font-size:.7rem;color:#fff;background:var(--wz-main);opacity:0;transform:scale(.4);transition:.18s}
.wz-card.on .wz-ck{opacity:1;transform:scale(1)}
.wz-debt{border-style:dashed}
.wz-or{display:flex;align-items:center;gap:.6rem;margin:1.1rem 0 .7rem;color:#64748b;font-size:.75rem;font-weight:700}
.wz-or::before,.wz-or::after{content:"";flex:1;height:1px;background:var(--wz-line)}
.wz-note{padding:.75rem .9rem;border-radius:1rem;font-size:.75rem;line-height:1.75;margin-bottom:1rem}
.wz-note.amber{background:#fffbeb;border:1px solid #fde68a;color:#78350f}.wz-note.slate{background:#f1f5f9;border:1px solid #e2e8f0;color:#334155}
.wz-alert{padding:.7rem .9rem;border-radius:1rem;background:#fff1f2;border:1px solid #fecdd3;color:#9f1239;font-size:.78rem;font-weight:700;margin-bottom:1rem}
.wz-link{color:var(--wz-dk);font-weight:800;text-decoration:underline;min-height:32px;display:inline}
.wz-lb{font-size:.75rem;font-weight:700;color:var(--wz-ink)}
.wz-hint{font-size:.72rem;color:var(--wz-mut);line-height:1.75;margin-top:.4rem}
.wz-reuse{margin-bottom:1rem}.wz-reuse .wz-lb{display:block;margin-bottom:.3rem}
.wz-fields label{color:#1e293b}.wz-fields .inp{scroll-margin-bottom:200px}
.wz-fields [aria-invalid=true]{border-color:#fb7185;background:#fff}
.wz-err{margin-top:.35rem;font-size:.75rem;font-weight:700;color:var(--wz-bad)}
.wz-icon{border:1.5px solid #e3ebee;border-radius:1.1rem;background:rgba(248,251,251,.9)}
.wz-icon>summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:.6rem;min-height:48px;padding:.4rem 1rem;cursor:pointer}
.wz-icon>summary::-webkit-details-marker{display:none}
.wz-ic-sum{display:flex;align-items:center;gap:.6rem;color:#64748b;font-size:.8rem}.wz-ic-cur{font-size:1.3rem;line-height:1;color:var(--wz-dk)}
.wz-icon[open]>summary .fa-chevron-down{transform:rotate(180deg)}.wz-icon>div{padding:0 1rem 1rem}
.wz-chip{margin-top:.45rem;display:inline-flex;align-items:center;min-height:38px;padding:.25rem .85rem;border-radius:99px;background:var(--wz-soft);color:var(--wz-dk);font-size:.75rem;font-weight:800;border:1px dashed #86c5b6;font-family:inherit;cursor:pointer}
.wz-opt{display:flex;align-items:center;gap:.6rem;min-height:52px;padding:.7rem .9rem;border:1.5px solid var(--wz-line);border-radius:1rem;background:#fff;cursor:pointer;font-size:.85rem;font-weight:700;line-height:1.55}
.wz-opt input{width:20px;height:20px;accent-color:var(--wz-main);flex:none}.wz-opt:has(input:checked){border-color:var(--wz-main);background:var(--wz-soft)}
.wz-live{margin-top:1.1rem;padding:.9rem;border-radius:1.1rem;background:linear-gradient(180deg,#f3faf7,#fff);border:1px solid #cfe7df}
.wz-lt{font-size:.78rem;font-weight:900;color:var(--wz-dk);margin-bottom:.6rem;display:flex;gap:.4rem;align-items:center}
.wz-tiles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem}
.wz-tile{padding:.65rem .75rem;border-radius:.9rem;background:#fff;border:1px solid #e4ece9;min-width:0}
.wz-tile span{display:block;font-size:.68rem;color:var(--wz-mut);margin-bottom:.15rem}.wz-tile b{display:block;font-size:.88rem;font-weight:900;color:var(--wz-ink);overflow-wrap:anywhere}
.wz-tile.main{grid-column:1/-1;background:var(--wz-dk);border-color:var(--wz-dk)}.wz-tile.main span{color:#c6ecde}.wz-tile.main b{color:#fff;font-size:1.2rem}
.wz-tile.wide{grid-column:1/-1}.wz-tile.bad b{color:var(--wz-bad)}.wz-tile.warn b{color:var(--wz-warn)}
.wz-sch{margin-top:1rem}.wz-rows{list-style:none;margin:0;padding:0;display:grid;gap:.4rem}
.wz-row{display:flex;align-items:center;gap:.6rem;padding:.55rem .7rem;border-radius:.9rem;background:#f8fafc;border:1px solid #e8edf2}
.wz-n{flex:none;width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:var(--wz-soft);color:var(--wz-dk);font-size:.72rem;font-weight:900}
.wz-rm{flex:1;min-width:0;display:flex;flex-direction:column}.wz-rm b{font-size:.8rem}.wz-rm small{font-size:.68rem;color:var(--wz-mut)}.wz-rr{flex:none;font-size:.68rem;color:#64748b}
.wz-more{margin-top:.5rem}.wz-more>summary{cursor:pointer;font-size:.78rem;font-weight:800;color:var(--wz-dk);min-height:44px;display:flex;align-items:center}
.wz-notes{margin-top:.9rem;display:grid;gap:.4rem}
.wz-notes p{display:flex;gap:.5rem;font-size:.75rem;line-height:1.75;color:#334155;background:#f8fafc;border:1px solid #e8edf2;border-radius:.9rem;padding:.6rem .75rem}.wz-notes i{color:var(--wz-main);margin-top:.4rem}
.wz-kvs{margin:0;border:1px solid #e4ece9;border-radius:1.1rem;overflow:hidden}
.wz-kv{display:flex;justify-content:space-between;gap:1rem;padding:.7rem .9rem;border-bottom:1px solid #eef2f1;font-size:.8rem}.wz-kv:last-child{border-bottom:0}
.wz-kv dt{color:var(--wz-mut);flex:none}.wz-kv dd{margin:0;font-weight:800;color:var(--wz-ink);text-align:end;overflow-wrap:anywhere;min-width:0}
.wz-bar{position:sticky;bottom:calc(var(--tab-h) + var(--sab) + 8px);z-index:30;margin:1.25rem -.25rem 0;padding:.7rem;border-radius:1.2rem;background:rgba(255,255,255,.96);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border:1px solid var(--wz-line);box-shadow:0 14px 30px -16px rgba(15,60,70,.45)}
@media(min-width:768px){.wz-bar{bottom:12px}}
/* أثناء الكتابة (لوحة المفاتيح مفتوحة): iOS يرفع العناصر الثابتة فوق الحقول، فنجعل شريط الخطوات عادياً ونخفي شريط التبويبات */
.wz-typing .wz-bar{position:static;bottom:auto;box-shadow:none;-webkit-backdrop-filter:none;backdrop-filter:none}
.wz-typing #tabbar{display:none!important}
.wz-sum{font-size:.75rem;font-weight:800;color:var(--wz-dk);margin:0 .2rem .5rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.wz-btns{display:grid;grid-template-columns:1fr 1.5fr;gap:.5rem}.wz-btns .btn{min-height:50px;width:100%;font-size:.88rem}
.wz-okc{width:72px;height:72px;border-radius:50%;margin:0 auto;display:grid;place-items:center;font-size:1.8rem;color:#fff;background:linear-gradient(135deg,#0fb16b,#0f4c3a);animation:wzPop .5s cubic-bezier(.2,1.4,.4,1)}
@keyframes wzPop{from{transform:scale(.3);opacity:0}to{transform:scale(1);opacity:1}}
@media(prefers-reduced-motion:reduce){.wz *,[data-wz-panel]{animation:none!important;transition:none!important}}
</style>
<style id="pf-style">
