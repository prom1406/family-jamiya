  showModal('تسجيل مساهمتي الشخصية', `<form id="f-famself" class="space-y-3"><p class="text-xs text-slate-600 leading-relaxed">أنت المستفيد، فلا حاجة لإيصال: تُسجَّل مساهمتك مؤكدة مباشرة وتُحتسب في الإجمالي.</p>
    <div><label class="text-xs font-semibold block mb-1">المبلغ (ريال)</label><input name="amount" type="number" step="0.01" min="1" class="inp" required value="${left || ''}"></div>
    <div><label class="text-xs font-semibold block mb-1">ملاحظة (اختياري)</label><input name="ref" class="inp" maxlength="40"></div>
    <button class="btn b-pri w-full py-3" type="submit">تسجيل المساهمة</button></form>`);
