  try { await batch.commit(); toast('تم إنشاء التعاون'); jlog(ref.id, 'family', `${dispName(p)} أنشأ التعاون «${name}»`); wzDone('family', ref.id, name); }
  catch (e) { toast('تعذر الإنشاء: ' + e.message, 'error'); }
}
const famEnd = j => j.endAt && j.endAt.toDate ? j.endAt.toDate() : new Date((j.endDate || '') + 'T23:59:59');
