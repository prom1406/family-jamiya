/* القطات في لوحة المالك */
function qattahAdminHtml() {
  const Q = state.admin.qattahs || [];
  const sumC = Q.reduce((t, q) => t + (Number(q.collected) || 0), 0);
  const list = [...Q].sort((a, b) => (tsd(b.createdAt) || 0) - (tsd(a.createdAt) || 0));
  const rows = list.map(q => {
    const st = qtStatus(q), tg = Number(q.target) || 0, pct = qtPct(Number(q.collected) || 0, tg);
    return `<div class="p-3 bg-slate-50 rounded-2xl flex items-center gap-3"><span class="jicon !w-10 !h-10 !text-lg"><i class="fa-solid fa-hand-holding-dollar"></i></span>
      <div class="flex-1 min-w-0"><div class="flex items-center gap-1.5 flex-wrap"><b class="text-sm">${esc(q.name)}</b>${bdg(st.l, st.c)}</div>
      <p class="text-[11px] text-slate-500 mt-0.5">المشرف: ${esc(q.adminName || '—')} • ${(q.memberUids || []).length}/${q.participants} أفراد • ${fmtNum(q.collected)} من ${fmtNum(tg)} ريال (${pct}%)</p></div></div>`;
  }).join('');
  return `<div class="grid grid-cols-2 md:grid-cols-3 gap-3">${kpi('إجمالي القطات', nf(Q.length), 'fa-hand-holding-dollar')}${kpi('إجمالي المحصّل', fmtNum(sumC) + ' ريال', 'fa-coins', 'text-emerald-600')}${kpi('مكتملة الفعالية', nf(Q.filter(q => qtStatus(q).k === 'done').length), 'fa-flag-checkered')}</div>
    <div class="card p-5 space-y-3"><h3 class="font-black text-sm">القطات</h3><div class="space-y-2">${rows || '<p class="text-xs text-slate-400 text-center py-4">لا توجد قطات بعد</p>'}</div></div>`;
}

/* الترافيك */
function tabTraffic() {
  const A = state.admin, R = A.range, keys = dayKeys(R), prev = dayKeys(R, R);
  const M = { visits: 'الزيارات', pv: 'مشاهدات الصفحات', logins: 'مرات الدخول', dau: 'مستخدمون فريدون يومياً', regs: 'تسجيلات جديدة' };
  const tot = f => sumF(keys, f), ptot = f => sumF(prev, f);
  const dev = sumMap(keys, 'dev'), devT = Object.values(dev).reduce((s, v) => s + v, 0);
  const hours = sumMap(keys, 'hours'), hv = Array.from({ length: 24 }, (_, h) => hours[h] || 0), pk = hv.indexOf(Math.max(...hv));
  const best = keys.reduce((b, k) => (((A.stats[k] || {}).visits || 0) > b[1] ? [k, (A.stats[k] || {}).visits || 0] : b), ['', 0]);
  return `<div class="flex flex-wrap gap-2 items-center"><div class="atabs">${[7, 14, 30].map(n => `<button class="achip ${R === n ? 'on' : ''}" data-act="adm-range" data-v="${n}">${nf(n)} يوماً</button>`).join('')}</div></div>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    ${kpi('الزيارات', nf(tot('visits')), 'fa-eye', 'text-sky-700', delta(tot('visits'), ptot('visits')))}
    ${kpi('مشاهدات الصفحات', nf(tot('pv')), 'fa-file-lines', 'text-slate-900', delta(tot('pv'), ptot('pv')))}
    ${kpi('مرات الدخول', nf(tot('logins')), 'fa-right-to-bracket', 'text-teal-700', delta(tot('logins'), ptot('logins')))}
    ${kpi('تسجيلات جديدة', nf(tot('regs')), 'fa-user-plus', 'text-emerald-600', delta(tot('regs'), ptot('regs')))}
    ${kpi('متوسط الزيارات اليومي', nf(Math.round(tot('visits') / R * 10) / 10), 'fa-gauge')}
    ${kpi('أفضل يوم', best[1] ? dayLbl(best[0]) + ' (' + nf(best[1]) + ')' : '—', 'fa-calendar-day')}
    ${kpi('ذروة الساعات', hv[pk] ? nf(pk) + ':00' : '—', 'fa-clock')}
    ${kpi('من التطبيق المثبّت', nf(tot('pwa')), 'fa-mobile-screen-button', 'text-violet-700')}
  </div>
  <div class="card p-5"><div class="flex flex-wrap justify-between gap-2 mb-3"><h4 class="font-black text-sm"><i class="fa-solid fa-chart-column text-teal-600"></i> ${M[A.metric]}</h4>
    <div class="atabs">${Object.entries(M).map(([k, l]) => `<button class="achip ${A.metric === k ? 'on' : ''}" data-act="adm-metric" data-v="${k}">${l}</button>`).join('')}</div></div>
    ${barChart(keys.map(dayLbl), keys.map(k => (A.stats[k] || {})[A.metric] || 0), R > 14 ? 3 : 1, keys)}</div>
  <div class="grid md:grid-cols-2 gap-4">
    ${breakdown('الأجهزة', 'fa-mobile-screen', dev, k => DEV_L[k] || k)}
    ${breakdown('أنظمة التشغيل', 'fa-microchip', sumMap(keys, 'os'))}
    ${breakdown('المتصفحات', 'fa-globe', sumMap(keys, 'br'))}
    ${breakdown('مصادر الزيارات', 'fa-link', sumMap(keys, 'src'))}
    ${breakdown('الصفحات الأكثر مشاهدة', 'fa-table-columns', sumMap(keys, 'views'), k => VIEW_L[k] || k)}
    <div class="card p-5"><h4 class="font-black text-sm mb-3"><i class="fa-solid fa-clock text-teal-600"></i> الزيارات حسب ساعة اليوم (بتوقيت جهاز الزائر)</h4>${barChart(hv.map((_, h) => nf(h)), hv, 3, hv.map((_, h) => nf(h) + ':00'))}</div>
  </div>
  <p class="text-[11px] text-slate-400 leading-relaxed">الزيارة تُحتسب مرة لكل جلسة متصفح. الدخول يُحتسب مرة لكل جلسة لكل مستخدم (إعادة تحميل الصفحة لا تزيده). نشاط المالك والمشرفين لا يدخل في إحصاءات الصفحات. تبدأ الإحصاءات من لحظة نشر هذه النسخة${devT ? '' : ' — ولا توجد بيانات بعد'}.</p>`;
}

